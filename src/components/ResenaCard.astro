---
// Una reseña: estrellas, texto, quién la firma y las marcas que le
// registramos, cada acta con link a su ficha en el INPI.
// `compacta` recorta el texto a 5 líneas (bloque de la home); en /resenas/ va
// entera.
import { actaUrl, firmaDe, mesDe, type Resena } from '../lib/resenas';

interface Props {
  resena: Resena;
  compacta?: boolean;
}

const { resena: r, compacta = false } = Astro.props;
---

<article class:list={['resena', { 'resena--compacta': compacta }]}>
  <div class="resena-estrellas" role="img" aria-label={`${r.estrellas} de 5 estrellas`}>
    {[1, 2, 3, 4, 5].map((i) => (
      <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"
           class={i <= r.estrellas ? 'on' : 'off'}>
        <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
      </svg>
    ))}
  </div>

  {r.texto && <blockquote class="resena-texto">{r.texto}</blockquote>}

  <footer class="resena-pie">
    <p class="resena-firma">
      <strong>{firmaDe(r)}</strong>
      <time datetime={r.fecha}>{mesDe(r.fecha)}</time>
    </p>
    {r.marcas.length > 0 && (
      <ul class="resena-marcas" aria-label="Marcas registradas con UnaMarca">
        {r.marcas.map((m) => (
          <li>
            <span class="resena-marca">{m.denominacion}</span>
            {m.actas.map((acta) => (
              <a href={actaUrl(acta)} target="_blank" rel="noopener"
                 title={`Ver el acta ${acta} en el INPI`}>
                Acta {acta}
                <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M4.5 2.5h5v5M9.5 2.5L3 9" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </li>
        ))}
      </ul>
    )}
  </footer>
</article>

<style>
  .resena {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .resena-estrellas { display: flex; gap: 2px; }
  .resena-estrellas svg { display: block; }
  .resena-estrellas .on { fill: var(--c-amber); }
  .resena-estrellas .off { fill: var(--c-border); }

  .resena-texto {
    margin: 0;
    color: var(--c-text);
    font-size: 1rem;
    line-height: 1.7;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .resena--compacta .resena-texto {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .resena-pie {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border-light);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .resena-firma {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .resena-firma strong { color: var(--c-navy); font-weight: 600; }
  .resena-firma time { color: var(--c-text-muted); font-size: 0.8125rem; }

  .resena-marcas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .resena-marcas li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .resena-marca {
    font-weight: 600;
    color: var(--c-text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .resena-marcas a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.55rem;
    border-radius: 100px;
    background: var(--c-blue-light);
    color: var(--c-blue);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .resena-marcas a:hover { background: var(--c-blue-mid); text-decoration: none; }
  .resena-marcas a svg { display: block; }
</style>
