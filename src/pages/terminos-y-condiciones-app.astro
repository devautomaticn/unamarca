---
// Servicio: términos y condiciones + política de privacidad a medida para una
// app o web. Landing SEO: apunta a «términos y condiciones ejemplo app» y
// «política de privacidad ejemplo» (~320 búsquedas/mes cada una en Argentina,
// DataForSEO, noviembre 2026). Lo que rankea hoy son guías y generadores
// genéricos, casi todos de España: esta página gana por ser argentina y por
// mostrar un ejemplo de verdad.
//
// El ejemplo está generalizado a partir de un trabajo real; no lleva datos de
// ningún cliente. Las normas citadas son las mismas que usan los textos que
// entregamos: si se cambia una acá, revisar que siga coincidiendo.
//
// La venta es por WhatsApp (mensaje `terminos_app`, a la línea humana). Después
// del pago el cliente completa /formulario-terminos.
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICING, formatARS } from '../lib/checkout/constants';
import { waHref } from '../lib/wa';
import { TERMINOS_EJEMPLO, PRIVACIDAD_EJEMPLO } from '../data/ejemplo-terminos';

const SITE_URL = 'https://unamarca.com.ar';
const canonicalURL = `${SITE_URL}/terminos-y-condiciones-app/`;
const precio = formatARS(PRICING.terminos);
const wa = waHref('terminos_app');
const clickWa = (lugar: string) =>
  `gtag('event','whatsapp_click',{'source':'terminos_app','lugar':'${lugar}'})`;

const motivos = [
  {
    titulo: 'Tienen que decir la verdad sobre tu app',
    texto:
      'Qué datos pedís, para qué los usás, con qué proveedores los compartís y dónde ' +
      'se guardan. Un texto copiado describe la app de otro: si no coincide con lo que ' +
      'hace la tuya, no te protege y te expone.',
  },
  {
    titulo: 'La ley argentina pide cosas puntuales',
    texto:
      'El botón de arrepentimiento, la leyenda de la Agencia de Acceso a la Información ' +
      'Pública, los plazos para responder pedidos de datos. Los modelos de España o de ' +
      'Estados Unidos no los traen.',
  },
  {
    titulo: 'Las tiendas de apps los piden',
    texto:
      'Google Play y la App Store exigen el link a una política de privacidad para ' +
      'publicar una app que maneja datos personales. Sin eso, la app no sale.',
  },
];

const requisitos = [
  {
    norma: 'Ley 25.326 de Protección de Datos Personales',
    texto:
      'Informar qué datos se recolectan, para qué y quién es el responsable, y pedir el ' +
      'consentimiento. Reconocer el derecho de acceso gratuito cada seis meses (art. 14) ' +
      'y el de rectificación y supresión (art. 16).',
  },
  {
    norma: 'Agencia de Acceso a la Información Pública (AAIP)',
    texto:
      'Es el órgano de control de la Ley 25.326. La política tiene que decir que el ' +
      'usuario puede reclamar ante ella. Las bases de datos personales, además, se ' +
      'inscriben en su registro.',
  },
  {
    norma: 'Transferencia internacional (art. 12, Disposición 60/2016)',
    texto:
      'Si usás servidores, emails o inteligencia artificial de proveedores de afuera, ' +
      'los datos salen del país. Hay que informarlo y respaldarlo con cláusulas de ' +
      'protección.',
  },
  {
    norma: 'Ley 24.240 de Defensa del Consumidor y Resolución 424/2020',
    texto:
      'Si la app vende algo, el usuario puede arrepentirse dentro de los 10 días corridos ' +
      '(art. 34), y el sitio tiene que tener un botón de arrepentimiento visible.',
  },
  {
    norma: 'Código Civil y Comercial, art. 53',
    texto:
      'Si los usuarios suben fotos o videos de personas, hace falta el consentimiento de ' +
      'quien aparece. Con menores de edad, el de quien ejerce la responsabilidad parental ' +
      '(Ley 26.061).',
  },
];

const ejemploTerminos = [
  ['Quiénes somos', 'Nombre o razón social, CUIT, domicilio y contacto del responsable.'],
  ['Qué hace la app', 'El servicio en palabras simples y lo que no incluye.'],
  ['Quién puede usarla', 'Edad mínima, cuenta, y qué pasa si alguien da datos falsos.'],
  ['Contenido que suben los usuarios', 'Qué declaran al subirlo y qué usos están prohibidos.'],
  ['Precio y pagos', 'Planes, medios de pago, renovaciones y códigos de descuento.'],
  ['Propiedad intelectual', 'Qué es tuyo, qué es del usuario y qué licencia se dan entre sí.'],
  ['Arrepentimiento y reintegros', 'El botón de arrepentimiento y cuándo se devuelve el dinero.'],
  ['Inteligencia artificial', 'Si la usás: alcances, errores posibles y proveedores.'],
  ['Responsabilidad', 'Hasta dónde responde la app, dentro de lo que permite la ley.'],
  ['Cambios, ley aplicable y contacto', 'Cómo se avisan los cambios y a quién reclamar.'],
];

const ejemploPrivacidad = [
  ['Responsable', 'Quién decide sobre los datos y cómo contactarlo.'],
  ['Qué datos usamos', 'Cada dato, para qué se usa y en qué se basa su uso.'],
  ['Menores de edad', 'Si pueden usar la app y con qué autorización.'],
  ['Con quién se comparten', 'Hosting, pagos, emails, analítica, IA: cada proveedor.'],
  ['Transferencia internacional', 'Qué datos salen del país y con qué resguardo.'],
  ['Cuánto tiempo se guardan', 'Plazos concretos por tipo de dato.'],
  ['Cookies y medición', 'Google Analytics, el píxel de Meta u otras herramientas.'],
  ['Seguridad', 'Cómo se protegen los datos.'],
  ['Derechos del usuario', 'Acceso, rectificación, supresión, y cómo pedirlos.'],
  ['Cambios y contacto', 'Cómo se avisan los cambios a la política.'],
];

const pasos = [
  {
    titulo: 'Nos escribís por WhatsApp',
    texto: `Te contamos cómo trabajamos y abonás ${precio} por los dos documentos.`,
  },
  {
    titulo: 'Completás un formulario',
    texto:
      'Unos 10 minutos: quién es el responsable, qué hace la app, qué datos pide, cómo ' +
      'cobra y qué proveedores usa. Si algo no lo sabés, marcás «No sé».',
  },
  {
    titulo: 'Te mandamos el borrador',
    texto:
      'Con lo que falta definir marcado, y las preguntas para tu desarrollador si hace ' +
      'falta confirmar cómo funciona algo.',
  },
  {
    titulo: 'Recibís los textos finales',
    texto: 'En PDF y en texto para pegar en la app, la web o la ficha de la tienda.',
  },
];

const faqs = [
  {
    q: '¿Es obligatorio que una app tenga términos y condiciones y política de privacidad?',
    a: 'Si la app recolecta datos personales (un email, un nombre, una foto, la ubicación), la Ley 25.326 obliga a informar al usuario qué se hace con ellos: eso es la política de privacidad. Además, Google Play y la App Store la piden para publicar. Los términos y condiciones son el contrato con el usuario: si la app vende algo, la Ley de Defensa del Consumidor exige informar precio, condiciones y el derecho de arrepentimiento.',
  },
  {
    q: '¿Cuánto cuesta que me armen los términos y condiciones de mi app?',
    a: `Con UnaMarca, ${precio} por los dos documentos: términos y condiciones y política de privacidad, redactados a medida para tu app o web. Es un precio fijo.`,
  },
  {
    q: '¿Puedo copiar los términos y condiciones de otra app?',
    a: 'No conviene. Los textos tienen autor y están protegidos por la Ley 11.723 de propiedad intelectual. Y aunque no te reclamen, describen otra app: otros datos, otros proveedores, otras reglas. Si no coinciden con lo que hace la tuya, no te protegen cuando hay un problema.',
  },
  {
    q: '¿Sirve un generador gratuito de términos y condiciones?',
    a: 'Sirve como punto de partida. La mayoría están pensados para la ley de España o de Estados Unidos y no incluyen lo que pide la Argentina: el botón de arrepentimiento, la leyenda de la AAIP y los plazos de la Ley 25.326. Tampoco saben qué hace tu app, así que el resultado suele ser genérico.',
  },
  {
    q: '¿Qué necesito tener para encargarlos?',
    a: 'Saber qué hace la app, qué datos les pide a los usuarios, cómo cobra y qué servicios usa (hosting, pagos, emails, analítica). Lo que no sepas lo marcás en el formulario y lo resolvemos con vos o con tu desarrollador.',
  },
  {
    q: '¿Sirve también para una página web o una tienda online?',
    a: 'Sí. El servicio es el mismo para una app móvil, una web o las dos. En una tienda online cobra más peso la parte de Defensa del Consumidor: precios, envíos, cambios y arrepentimiento.',
  },
  {
    q: '¿Incluye la inscripción de la base de datos ante la AAIP?',
    a: 'No. El servicio son los dos textos. Si por cómo funciona tu app corresponde inscribir la base de datos, te lo avisamos.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Términos y condiciones y política de privacidad para apps',
    serviceType: 'Redacción de términos y condiciones y política de privacidad',
    description:
      'Términos y condiciones y política de privacidad redactados a medida para una app o web, según la ley argentina.',
    url: canonicalURL,
    areaServed: { '@type': 'Country', name: 'Argentina' },
    provider: { '@type': 'Organization', name: 'UnaMarca', url: SITE_URL },
    offers: {
      '@type': 'Offer',
      price: PRICING.terminos,
      priceCurrency: 'ARS',
      description: 'Los dos documentos, a medida',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Términos y condiciones para apps', item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Términos y condiciones y política de privacidad: ejemplo para apps"
  description={`Qué tienen que decir los términos y condiciones y la política de privacidad de una app en Argentina, con un ejemplo. Te los redactamos a medida por ${precio}.`}
  canonicalURL={canonicalURL}
  waContext="terminos_app"
  structuredData={structuredData}
>
  <!-- ===== Encabezado ===== -->
  <section class="tc-hero">
    <div class="container">
      <span class="section-label">Para apps y webs</span>
      <h1>Términos y condiciones y política de privacidad para tu app</h1>
      <p class="tc-lead">
        Los redactamos <strong>a medida y según la ley argentina</strong>, a partir de un
        formulario de 10 minutos sobre cómo funciona tu app. Abajo tenés un ejemplo de qué
        tiene que decir cada uno.
      </p>

      <div class="tc-precio">
        <div>
          <span class="tc-precio-label">Los dos documentos</span>
          <strong class="tc-precio-valor">{precio}</strong>
          <span class="tc-precio-nota">precio fijo · términos + privacidad</span>
        </div>
        <div class="tc-precio-ctas">
          <a href={wa} class="btn btn-primary btn-glow" target="_blank" rel="noopener" onclick={clickWa('hero')}>
            Quiero los de mi app
          </a>
          <a href="#ejemplo" class="btn btn-outline-white">Ver el ejemplo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Por qué a medida ===== -->
  <section class="tc-seccion">
    <div class="container">
      <header class="section-header">
        <h2>Por qué no alcanza con copiar los de otra app</h2>
      </header>
      <div class="tc-cards">
        {motivos.map(m => (
          <div class="tc-card">
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Qué pide la ley ===== -->
  <section class="tc-seccion tc-seccion-alt">
    <div class="container">
      <header class="section-header">
        <h2>Qué tienen que incluir según la ley argentina</h2>
        <p class="section-subtitle">
          Depende de lo que haga tu app: no todo aplica siempre. Esto es lo que más se repite.
        </p>
      </header>
      <ul class="tc-requisitos" role="list">
        {requisitos.map(r => (
          <li>
            <strong>{r.norma}</strong>
            <p>{r.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Ejemplo ===== -->
  <section class="tc-seccion" id="ejemplo">
    <div class="container">
      <header class="section-header">
        <span class="section-label">Ejemplo</span>
        <h2>Ejemplo de términos y condiciones y política de privacidad de una app</h2>
        <p class="section-subtitle">
          Un modelo completo de los dos documentos para una app argentina, con los datos a
          completar entre corchetes. Sirve para entender qué tiene que decir cada sección: para
          publicarlo, cada párrafo tiene que coincidir con lo que hace tu app.
        </p>
      </header>

      <div class="tc-ejemplo">
        <div class="tc-doc">
          <h3>Términos y condiciones</h3>
          <ol>
            {ejemploTerminos.map(([t, d]) => (
              <li><strong>{t}.</strong> {d}</li>
            ))}
          </ol>
          <details class="tc-completo">
            <summary>Leer el ejemplo completo de términos y condiciones</summary>
            <div class="tc-texto">
              {TERMINOS_EJEMPLO.map(sec => (
                <section>
                  <h4>{sec.titulo}</h4>
                  {sec.parrafos.some(p => p.startsWith('- ')) && (
                    <ul>{sec.parrafos.filter(p => p.startsWith('- ')).map(p => <li>{p.slice(2)}</li>)}</ul>
                  )}
                  {sec.parrafos.filter(p => !p.startsWith('- ')).map(p => <p>{p}</p>)}
                </section>
              ))}
            </div>
          </details>
        </div>

        <div class="tc-doc">
          <h3>Política de privacidad</h3>
          <ol>
            {ejemploPrivacidad.map(([t, d]) => (
              <li><strong>{t}.</strong> {d}</li>
            ))}
          </ol>
          <details class="tc-completo">
            <summary>Leer el ejemplo completo de política de privacidad</summary>
            <div class="tc-texto">
              {PRIVACIDAD_EJEMPLO.map(sec => (
                <section>
                  <h4>{sec.titulo}</h4>
                  {sec.parrafos.some(p => p.startsWith('- ')) && (
                    <ul>{sec.parrafos.filter(p => p.startsWith('- ')).map(p => <li>{p.slice(2)}</li>)}</ul>
                  )}
                  {sec.parrafos.filter(p => !p.startsWith('- ')).map(p => <p>{p}</p>)}
                </section>
              ))}
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Cómo trabajamos + precio ===== -->
  <section class="tc-seccion tc-seccion-alt">
    <div class="container">
      <header class="section-header">
        <h2>Cómo te los armamos</h2>
      </header>
      <ol class="tc-pasos" role="list">
        {pasos.map((p, i) => (
          <li>
            <span class="tc-paso-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="tc-cta">
        <div>
          <strong class="tc-cta-precio">{precio}</strong>
          <p>Términos y condiciones + política de privacidad, a medida para tu app o web.</p>
        </div>
        <a href={wa} class="btn btn-primary btn-glow" target="_blank" rel="noopener" onclick={clickWa('pasos')}>
          Escribinos por WhatsApp
        </a>
      </div>

      <p class="tc-marca">
        ¿Tu app ya tiene la marca registrada? El nombre es lo primero que te pueden copiar.
        {' '}<a href="/verificar-marca/">Verificá si está disponible</a>.
      </p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="faq-section" aria-labelledby="faq-heading">
    <div class="container">
      <header class="section-header">
        <span class="section-label">FAQ</span>
        <h2 id="faq-heading">Preguntas frecuentes</h2>
      </header>
      <ul class="faq-list" role="list">
        {faqs.map(f => (
          <li>
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-body"><p>{f.a}</p></div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Encabezado ── */
  .tc-hero {
    background: var(--grad-hero);
    color: #fff;
    padding-block: 4.5rem 3.5rem;
  }
  .tc-hero .section-label { color: #93B4FD; }
  .tc-hero h1 {
    font-size: clamp(2rem, 4.4vw, 3rem);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: #fff;
    max-width: 22ch;
  }
  .tc-lead {
    max-width: 58ch;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 2.25rem;
  }
  .tc-lead strong { color: #fff; font-weight: 600; }

  .tc-precio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: 1.75rem 2rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-lg);
  }
  .tc-precio > div:first-child { display: flex; flex-direction: column; gap: 0.2rem; }
  .tc-precio-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: #93B4FD;
  }
  .tc-precio-valor {
    font-size: clamp(1.75rem, 3.6vw, 2.375rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .tc-precio-nota { font-size: 0.875rem; color: rgba(255, 255, 255, 0.6); }
  .tc-precio-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* ── Secciones ── */
  .tc-seccion { padding-block: var(--sp-lg); }
  .tc-seccion-alt { background: var(--c-bg-alt); }
  .tc-seccion .section-header { margin-bottom: 2.5rem; }

  .tc-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .tc-card {
    padding: 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-bg);
  }
  .tc-card h3 { font-size: 1.0625rem; margin-bottom: 0.5rem; color: var(--c-navy); }
  .tc-card p { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--c-text-muted); }

  /* ── Requisitos ── */
  .tc-requisitos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .tc-requisitos li {
    padding: 1.15rem 1.35rem;
    border-left: 3px solid var(--c-blue);
    background: var(--c-bg);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  .tc-requisitos strong { color: var(--c-navy); }
  .tc-requisitos p { margin: 0.35rem 0 0; font-size: 0.9375rem; line-height: 1.65; color: var(--c-text-muted); }

  /* ── Ejemplo ── */
  .tc-ejemplo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .tc-doc {
    padding: 1.75rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-bg);
  }
  .tc-doc h3 { font-size: 1.125rem; margin-bottom: 1rem; color: var(--c-navy); }
  .tc-doc ol { margin: 0 0 1.5rem; padding-left: 1.25rem; display: grid; gap: 0.45rem; }
  .tc-doc li { font-size: 0.9375rem; line-height: 1.55; color: var(--c-text-muted); }
  .tc-doc li strong { color: var(--c-text); }
  .tc-completo {
    border-top: 1px solid var(--c-border);
    padding-top: 1rem;
  }
  .tc-completo summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--c-blue);
    font-size: 0.9375rem;
  }
  .tc-texto {
    margin-top: 1rem;
    padding: 1.25rem;
    background: var(--c-bg-alt);
    border-radius: var(--r-md);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .tc-texto h4 { font-size: 0.9375rem; margin: 1.1rem 0 0.4rem; color: var(--c-navy); }
  .tc-texto section:first-child h4 { margin-top: 0; }
  .tc-texto p { margin: 0 0 0.6rem; }
  .tc-texto ul { margin: 0 0 0.6rem; padding-left: 1.2rem; }

  /* ── Pasos ── */
  .tc-pasos {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .tc-pasos li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .tc-paso-num {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c-blue);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .tc-pasos h3 { font-size: 1rem; margin-bottom: 0.3rem; color: var(--c-navy); }
  .tc-pasos p { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--c-text-muted); }

  .tc-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.75rem 2rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-bg);
  }
  .tc-cta-precio {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--c-blue);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .tc-cta p { margin: 0.25rem 0 0; color: var(--c-text-muted); font-size: 0.9375rem; }
