---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waHrefBlogPost } from '../../lib/wa';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const SITE_URL = 'https://unamarca.com.ar';
// Explicit trailing slash: Cloudflare Pages serves dist/blog/slug/index.html at /blog/slug/
const canonicalURL = `${SITE_URL}/blog/${post.id}/`;
const pubDateISO = post.data.pubDate.toISOString();
const updatedDateISO = post.data.updatedDate?.toISOString();

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-AR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: pubDateISO,
  dateModified: updatedDateISO ?? pubDateISO,
  url: canonicalURL,
  inLanguage: 'es-AR',
  author: {
    '@type': 'Organization',
    name: 'UnaMarca',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Organization',
    name: 'UnaMarca',
    url: SITE_URL,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
};

const faqSchema = post.data.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faqs.map(faq => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;

const schemas = faqSchema ? [structuredData, faqSchema] : structuredData;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalURL={canonicalURL}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  tags={post.data.tags}
  structuredData={schemas}
  waContext="blog_float"
>
  <article class="blog-post">
    <div class="container">
      <header class="post-header">
        <div class="post-meta">
          <time datetime={pubDateISO}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <span class="post-updated">
              · Actualizado el <time datetime={updatedDateISO}>{formatDate(post.data.updatedDate)}</time>
            </span>
          )}
          {post.data.tags && post.data.tags.length > 0 && (
            <ul class="tag-list" role="list">
              {post.data.tags.map(tag => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      {post.data.faqs && post.data.faqs.length > 0 && (
        <section class="post-faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Preguntas frecuentes</h2>
          <dl>
            {post.data.faqs.map(faq => (
              <div class="faq-item">
                <dt>{faq.question}</dt>
                <dd>{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {/* WhatsApp primero: medido 2026-11-02, este CTA con WhatsApp como link
          chico no generó ninguna charla en tres meses, y el checkout casi no
          cierra con tráfico orgánico. Ver src/lib/remarkCtaBlog.ts. */}
      <aside class="post-cta" aria-label="Registrá tu marca">
        <h2>¿Querés registrar tu marca?</h2>
        <p>
          Escribinos por WhatsApp y te decimos gratis si el nombre está disponible
          y cuánto te sale. Precio fijo, y presentamos tu solicitud ante el INPI
          dentro de las 48 horas hábiles.
        </p>
        <div class="post-cta-actions">
          <a
            href={waHrefBlogPost(post.data.title)}
            class="btn btn-wa"
            target="_blank"
            rel="noopener noreferrer"
            onclick="typeof gtag==='function'&&gtag('event','whatsapp_click',{'source':'blog_post','cta_position':'end'})"
          >Consultar por WhatsApp</a>
          <a
            href="/registrar/"
            class="post-cta-wa"
            onclick="typeof gtag==='function'&&gtag('event','registrar_click',{'source':'blog'})"
          >o hacé el registro online</a>
        </div>
      </aside>

      <footer class="post-footer">
        <a href="/blog/" class="back-link">← Volver al blog</a>
      </footer>
    </div>
  </article>
</BaseLayout>
