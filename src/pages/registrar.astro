  function setClases(nums: number[], save = true) {
    clases = [...new Set(nums.filter(n => Number.isInteger(n) && n >= 1 && n <= 45))]
      .sort((a, b) => a - b)
      .slice(0, MAX_CLASES);
    if (clases.length) setErr('clase', '');
    renderClasesUI();
    updateSummary();
    if (save) saveDraft();
  }

  function toggleClase(num: number) {
    if (clases.includes(num)) {
      setClases(clases.filter(n => n !== num));
    } else if (clases.length >= MAX_CLASES) {
      $('ck-clase-max').hidden = false;
    } else {
      setClases([...clases, num]);
    }
  }

