      if (p.metodo === 'transferencia') metodoPago = 'transferencia';
      if (p.marca?.nombre) input('ck-marca').value = p.marca.nombre;
      // Pedidos viejos guardaban una sola clase en `clase`
      const pedidoClases = Array.isArray(p.clases) ? p.clases : (p.clase ? [p.clase] : []);
      if (pedidoClases.length) setClases(pedidoClases, false);
      if (p.contacto?.email) input('ck-email').value = p.contacto.email;
      if (p.contacto?.whatsapp) input('ck-whatsapp').value = p.contacto.whatsapp;
      garantia = !!p.garantia;
      input('ck-garantia').checked = garantia;
      updateSummary();
