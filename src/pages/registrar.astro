            <div class="ck-tr-row">
              <span class="ck-tr-k">N° de pedido</span>
              <span class="ck-tr-v"><b id="ck-tr-ref">–</b></span>
              <button type="button" class="ck-copy" id="ck-copy-ref">Copiar</button>
