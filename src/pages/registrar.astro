          <p class="ck-transfer-resume">
            ¿Cerrás la página? Retomá tu solicitud en
            <a id="ck-tr-resume" href="#">este link</a>.
          </p>

          <button type="button" class="ck-btn ck-transfer-next" id="ck-tr-next">
            Continuar y completar mis datos
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="ck-link-btn ck-transfer-otro" id="ck-tr-otro">← Elegir otra forma de pago</button>
        </div>
      </div>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="3">← Volver</button>
        <!-- Solo demo/test: visible únicamente en previews (*.pages.dev) y localhost -->
        <button type="button" class="ck-btn ck-btn--ghost" id="ck-skip-pay" hidden>
          Saltar pago (demo)
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 6 · REVISIÓN Y FIRMA ══════════ -->
    <section class="ck-step" data-step="6" hidden>
      <div class="ck-card">
        <div class="ck-section-label">Revisá tu carta poder</div>
        <p class="ck-help" style="margin-bottom: 1rem">
          Este documento nos autoriza a presentar y gestionar tu solicitud ante el INPI.
          Revisá que todos los datos sean correctos.
        </p>
        <div class="ck-cp" id="ck-cp-preview"></div>
        <button type="button" class="ck-link-btn" id="ck-edit-datos">✎ Editar mis datos</button>
      </div>

      <div class="ck-card">
        <div class="ck-section-label">Tu firma</div>
        <p class="ck-help" style="margin-bottom: 0.75rem">
          Firmá en el recuadro con el dedo (celular) o con el mouse, como lo harías en papel.
        </p>
        <div class="ck-sig-box">
          <canvas id="ck-sig"></canvas>
          <span class="ck-sig-hint" id="ck-sig-hint">Firmá acá</span>
        </div>
        <div class="ck-sig-foot">
          <button type="button" class="ck-link-btn" id="ck-sig-clear">Borrar y firmar de nuevo</button>
        </div>

        <label class="ck-terms">
          <input type="checkbox" id="ck-terms" />
          <span>Acepto los <a href="/terminos" target="_blank">términos del servicio</a> y la <a href="/privacidad" target="_blank">política de privacidad</a>, y autorizo el uso de mi firma en la carta poder.</span>
        </label>
      </div>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="5">← Volver</button>
        <button type="button" class="ck-btn" id="ck-submit" disabled>
          <span id="ck-submit-label">Confirmar y enviar solicitud</span>
          <svg id="ck-submit-spin" width="16" height="16" viewBox="0 0 16 16" fill="none" style="display:none"><circle cx="8" cy="8" r="6" stroke="rgba(255,255,255,.3)" stroke-width="2"/><path d="M8 2a6 6 0 0 1 6 6" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ CONFIRMACIÓN ══════════ -->
    <section class="ck-step" data-step="done" hidden>
      <div class="ck-card ck-done">
        <svg width="52" height="52" viewBox="0 0 52 52" fill="none"><circle cx="26" cy="26" r="25" fill="#22c55e" fill-opacity=".12"/><path d="M16 26.5l7 7 13-14" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h2>¡Listo! Recibimos tu solicitud.</h2>
        <p class="ck-done-ref">N° de referencia: <b id="ck-ref"></b></p>
        <p id="ck-done-mail">Te enviamos una copia de tu carta poder firmada a <b id="ck-done-email"></b>.</p>
        <p id="ck-done-plazo">
          Presentaremos tu solicitud ante el INPI dentro de las próximas
          <b>48 horas hábiles</b> y te enviaremos todas las notificaciones del
          trámite por email.
        </p>

        <!-- Recordatorio de la transferencia: solo si eligió ese medio de pago -->
        <div class="ck-done-transfer" id="ck-done-transfer" hidden>
          <p class="ck-done-transfer-title">Falta tu transferencia</p>
          <p>
            Transferí <b id="ck-done-importe">–</b> a <b>{TRANSFERENCIA.alias}</b>
            ({TRANSFERENCIA.titular}, {TRANSFERENCIA.banco}). Presentamos tu
            solicitud cuando se acredite.
          </p>
          <a class="ck-transfer-wa" id="ck-done-wa" href="#" target="_blank" rel="noopener noreferrer">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.5-1.2-2.9s.7-2 1-2.3c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.7 1.2 1.5 1.9 1 .9 1.8 1.2 2.1 1.3.3.1.4.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"/></svg>
            Enviar comprobante por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════ FAQ (siempre visible, no es un .ck-step) ══════════ -->
    <section class="ck-faq" aria-labelledby="ck-faq-title">
      <h2 id="ck-faq-title">Preguntas frecuentes</h2>
      {faqs.map(({ q, a }) => (
        <details class="ck-faq-item">
          <summary>{q}</summary>
          <p set:html={a} />
        </details>
      ))}
    </section>

  </div>
</div>

</BaseLayout>

<script>
  import { NIZA_CLASSES } from '../lib/checkout/nizaClasses';
  import { PRICING, MAX_CLASES, TRANSFERENCIA, computeOrderPricing, formatARS } from '../lib/checkout/constants';
  import { formatCuitInput, isValidCuit, cuitMatchesDni } from '../lib/checkout/cuit';
  import { cartaPoderHTML, type CartaPoderData } from '../lib/checkout/cartaPoder';
  import { waHrefComprobante } from '../lib/wa';

  const DRAFT_KEY = 'um-checkout-draft';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;

  // true = modo test (ningún campo obligatorio, formatos solo si hay valor)
  const FIELDS_OPTIONAL = false;

  // ── Estado ──────────────────────────────────────────────
  let clases: number[] = [];
  let garantia = false;
  let orderRef: string | null = null; // pedido creado al iniciar el pago
  type MetodoPago = 'mercadopago' | 'transferencia';
  let metodoPago: MetodoPago = 'mercadopago';

  const FIELD_IDS = [
    'ck-marca', 'ck-nombre', 'ck-apellido', 'ck-tipodoc', 'ck-docnum',
    'ck-cuit', 'ck-genero', 'ck-estadocivil', 'ck-conyuge',
    'ck-pais', 'ck-calle', 'ck-numero', 'ck-piso', 'ck-depto',
    'ck-localidad', 'ck-codpostal', 'ck-provincia',
    'ck-email', 'ck-whatsapp',
    'ck-descripcion', 'ck-sitioweb',
  ];

  function saveDraft() {
    const values: Record<string, string> = {};
    FIELD_IDS.forEach(id => { values[id] = input(id).value; });
    localStorage.setItem(DRAFT_KEY, JSON.stringify({ values, clases, garantia }));
  }

  function restoreDraft() {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      if (!raw) return;
      const draft = JSON.parse(raw);
      FIELD_IDS.forEach(id => { if (draft.values?.[id]) input(id).value = draft.values[id]; });
      syncConyuge();
      // Drafts viejos guardaban una sola clase en `clase`
      const draftClases = Array.isArray(draft.clases)
        ? draft.clases
        : (draft.clase ? [draft.clase] : []);
      if (draftClases.length) setClases(draftClases, false);
      if (typeof draft.garantia === 'boolean') {
        garantia = draft.garantia;
        input('ck-garantia').checked = garantia;
        updateSummary();
      }
    } catch { /* draft corrupto: ignorar */ }
  }

  // ── Analytics: funnel GA4 ───────────────────────────────
  // Cada evento se manda una sola vez por sesión (volver atrás y avanzar de
  // nuevo no infla el funnel). sessionStorage sobrevive el ida-y-vuelta a MP.
  const FIRED_KEY = 'um-ck-fired';
  let fired = new Set<string>();
  try { fired = new Set(JSON.parse(sessionStorage.getItem(FIRED_KEY) || '[]')); } catch { /* ignorar */ }
  function track(name: string, params: Record<string, unknown> = {}, once = true) {
    try {
      if (once) {
        if (fired.has(name)) return;
        fired.add(name);
        sessionStorage.setItem(FIRED_KEY, JSON.stringify([...fired]));
      }
      const w = window as any;
      if (typeof w.gtag === 'function') w.gtag('event', name, params);
    } catch { /* analytics nunca bloquea el checkout */ }
  }

  // Paso alcanzado → evento. Nombres distintos por paso para poder armar el
  // funnel en GA4 sin registrar dimensiones personalizadas.
  const STEP_EVENTS: Record<string, string> = {
    '2': 'begin_checkout',   // completó el nombre de su marca
    '3': 'ck_paso_pedido',   // dejó contacto, ve el precio
    '4': 'ck_paso_pago',     // aceptó el pedido, ve el botón de pago
    '5': 'ck_paso_titular',  // volvió de MP con pedido creado
    '6': 'ck_paso_firma',    // completó titular, ve la carta poder
  };

  // ── Navegación entre pasos ──────────────────────────────
  const TOTAL_STEPS = 6;
  const STEP_TITLES: Record<string, string> = {
    '1': 'Tu marca', '2': 'Contacto', '3': 'Tu pedido',
    '4': 'Pago', '5': 'Datos del titular', '6': 'Revisión y firma',
  };

  function goTo(step: string) {
    document.querySelectorAll<HTMLElement>('.ck-step').forEach(s => {
      s.hidden = s.dataset.step !== step;
    });
    if (step === 'done') {
      $('ck-progress').hidden = true;
    } else {
      const n = parseInt(step, 10);
      $('ck-step-label').textContent = `Paso ${n} de ${TOTAL_STEPS}`;
      $('ck-step-title').textContent = STEP_TITLES[step];
      $('ck-bar-fill').style.width = `${(n / TOTAL_STEPS) * 100}%`;
    }
    if (step === '4') updatePaySummary();
    if (step === '5') updateDescripcionUI();
    if (step === '6') { renderPreview(); sizeCanvas(); }
    if (STEP_EVENTS[step]) {
      track(STEP_EVENTS[step], { checkout_step: parseInt(step, 10), currency: 'ARS', value: total() });
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ── Errores inline ──────────────────────────────────────
  function setErr(key: string, msg: string) {
    const el = document.querySelector<HTMLElement>(`[data-err="${key}"]`);
    if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
  }
  function clearErrs(keys: string[]) { keys.forEach(k => setErr(k, '')); }

  // ── Validación por paso ─────────────────────────────────
  // Con FIELDS_OPTIONAL, los campos vacíos pasan; el formato se valida
  // solo cuando el usuario cargó algo.
  function validateStep1(): boolean {
    clearErrs(['marca']);
    if (FIELDS_OPTIONAL) return true;
    if (input('ck-marca').value.trim().length < 2) {
      setErr('marca', 'Ingresá el nombre de tu marca.');
      return false;
    }
    return true;
  }

  function validatePedido(): boolean {
    clearErrs(['clase']);
    if (FIELDS_OPTIONAL) return true;
    if (clases.length === 0) { setErr('clase', 'Seleccioná al menos una clase para tu marca.'); return false; }
    return true;
  }

  function validateContacto(): boolean {
    clearErrs(['email', 'whatsapp']);
    let ok = true;

    const email = input('ck-email').value.trim();
    if (email || !FIELDS_OPTIONAL) {
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('email', 'Ingresá un email válido.'); ok = false; }
    }

    const wa = input('ck-whatsapp').value.replace(/\D/g, '');
    if (wa || !FIELDS_OPTIONAL) {
      if (wa.length < 10) { setErr('whatsapp', 'Ingresá un número de WhatsApp válido (con código de área).'); ok = false; }
    }

    return ok;
  }

  function validateTitular(): boolean {
    const keys = ['descripcion', 'sitioweb', 'nombre', 'apellido', 'docnum', 'cuit', 'genero', 'estadocivil', 'conyuge', 'calle', 'numero', 'localidad', 'codpostal', 'provincia'];
    clearErrs(keys);
    let ok = true;

    const descripcion = input('ck-descripcion').value.trim();
    if (descripcion || !FIELDS_OPTIONAL) {
      if (descripcion.length < MIN_DESCRIPCION) {
        setErr('descripcion', `Contanos un poco más: mínimo ${MIN_DESCRIPCION} caracteres (llevás ${descripcion.length}).`);
        ok = false;
      }
    }

    const sitioWeb = input('ck-sitioweb').value.trim();
    if (sitioWeb && !/^(https?:\/\/)?([\w-]+\.)+[\w-]{2,}(\/\S*)?$/i.test(sitioWeb)) {
      setErr('sitioweb', 'Ingresá una dirección web válida (ej: https://tumarca.com).');
      ok = false;
    }

    const req = (id: string, key: string, msg: string) => {
      if (!FIELDS_OPTIONAL && !input(id).value.trim()) { setErr(key, msg); ok = false; }
    };
    req('ck-nombre', 'nombre', 'Ingresá tu nombre.');
    req('ck-apellido', 'apellido', 'Ingresá tu apellido.');
    req('ck-genero', 'genero', 'Seleccioná el género.');
    req('ck-estadocivil', 'estadocivil', 'Seleccioná el estado civil.');
    if (input('ck-estadocivil').value === 'Casado/a') {
      req('ck-conyuge', 'conyuge', 'Ingresá el nombre del cónyuge.');
    }

    const tipoDoc = input('ck-tipodoc').value;
    const doc = input('ck-docnum').value.trim();
    if (tipoDoc === 'DNI') {
      const digits = doc.replace(/\D/g, '');
      if (doc || !FIELDS_OPTIONAL) {
        if (digits.length < 7 || digits.length > 8) { setErr('docnum', 'Ingresá un DNI válido (7 u 8 dígitos).'); ok = false; }
      }
    } else {
      req('ck-docnum', 'docnum', 'Ingresá el número de documento.');
    }

    const cuit = input('ck-cuit').value;
    if (cuit || !FIELDS_OPTIONAL) {
      if (!isValidCuit(cuit)) {
        setErr('cuit', 'El CUIT/CUIL no es válido. Revisalo.'); ok = false;
      } else if (tipoDoc === 'DNI' && doc && !cuitMatchesDni(cuit, doc)) {
        setErr('cuit', 'El CUIT/CUIL no coincide con el DNI ingresado.'); ok = false;
      }
    }

    req('ck-calle', 'calle', 'Ingresá la calle.');
    req('ck-numero', 'numero', 'Ingresá el número.');
    req('ck-localidad', 'localidad', 'Ingresá la localidad.');
    req('ck-codpostal', 'codpostal', 'Ingresá el código postal.');
    req('ck-provincia', 'provincia', 'Seleccioná la provincia.');

    return ok;
  }

  // Cónyuge: visible solo si el estado civil es Casado/a
  function syncConyuge() {
    $('ck-conyuge-row').hidden = input('ck-estadocivil').value !== 'Casado/a';
  }
  input('ck-estadocivil').addEventListener('change', syncConyuge);

  // ── Dropdown de clases ──────────────────────────────────
  const ddBtn = $('ck-clase-btn');
  const ddPanel = $('ck-clase-panel');
  const ddSearch = input('ck-clase-search');

  function normalize(s: string): string {
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  function toggleDd(open?: boolean) {
    const show = open ?? ddPanel.hidden;
    ddPanel.hidden = !show;
    ddBtn.setAttribute('aria-expanded', String(show));
    if (show) { ddSearch.value = ''; filterClases(''); ddSearch.focus(); }
  }

  function filterClases(q: string) {
    const nq = normalize(q);
    document.querySelectorAll<HTMLElement>('.ck-dd-opt').forEach(opt => {
      // Busca en el nombre corto Y en el encabezado oficial completo
      const text = normalize(`${opt.textContent || ''} ${opt.dataset.extra || ''}`);
      (opt.parentElement as HTMLElement).hidden = nq !== '' && !text.includes(nq);
    });
  }

  /** "Clase 25" / "Clases 9, 25 y 35" */
  function clasesTexto(): string {
    if (clases.length === 0) return 'Clase –';
    if (clases.length === 1) return `Clase ${clases[0]}`;
    const nums = [...clases];
    const last = nums.pop();
    return `Clases ${nums.join(', ')} y ${last}`;
  }

  function renderClasesUI() {
    const label = $('ck-clase-label');
    if (clases.length === 0) {
      label.textContent = 'Seleccioná una o más clases…';
      label.classList.add('ck-dd-placeholder');
    } else if (clases.length === 1) {
      const c = NIZA_CLASSES.find(x => x.num === clases[0]);
      label.textContent = c ? `Clase ${c.num} — ${c.nombre}` : `Clase ${clases[0]}`;
      label.classList.remove('ck-dd-placeholder');
    } else {
      label.textContent = clasesTexto();
      label.classList.remove('ck-dd-placeholder');
    }

    // Chips con botón de quitar
    const chips = $('ck-clase-chips');
    chips.innerHTML = '';
    clases.forEach(num => {
      const c = NIZA_CLASSES.find(x => x.num === num);
      const chip = document.createElement('span');
      chip.className = 'ck-chip';
      chip.title = c ? c.nombre : '';
      chip.append(`Clase ${num}`);
      const rm = document.createElement('button');
      rm.type = 'button';
      rm.setAttribute('aria-label', `Quitar la clase ${num}`);
      rm.textContent = '×';
      rm.addEventListener('click', () => toggleClase(num));
      chip.append(rm);
      chips.append(chip);
