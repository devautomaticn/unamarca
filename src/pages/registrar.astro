---
// Self-checkout de registro de marca — v1 (spec: docs/spec_self_checkout.md)
// Pago: placeholder (sin Mercado Pago). Envío: simulado en esta fase de UX —
// TODO wiring: POST /api/checkout/submit (PDF + emails).
import BaseLayout from '../layouts/BaseLayout.astro';
import { NIZA_CLASSES } from '../lib/checkout/nizaClasses';
import { PRICING, MAX_CLASES, MAX_MARCAS, PROVINCIAS, TRANSFERENCIA, TIPOS_MARCA, LOGO_ACCEPT, LOGO_CM_MAX, formatARS } from '../lib/checkout/constants';
import { waHref, waHrefMulticlase, waHrefMultimarca } from '../lib/wa';

const SITE_URL = 'https://unamarca.com.ar';

const waEmpresa = waHref('registrar_empresa');
const waClase = waHref('registrar_clase');
const waMulti = waHrefMulticlase(MAX_CLASES);
const waMultiMarca = waHrefMultimarca(MAX_MARCAS);

// FAQ: respuestas cortas que derivan al post canónico de cada tema para no
// competir con el blog por sus keywords (los posts siguen siendo la página
// profunda de "cuánto sale", "cuánto tarda", "clases", etc.).
const faqs = [
  {
    q: '¿Cómo hago para registrar mi marca?',
    a: `Completá el formulario de esta página: el nombre de tu marca, la clase, tus datos y tu firma online. Nosotros presentamos la solicitud ante el INPI dentro de las 48 horas hábiles y te avisamos por email en cada etapa. Si querés conocer el proceso completo, mirá la <a href="/blog/como-registrar-una-marca-en-argentina-paso-a-paso">guía paso a paso</a>.`,
  },
  {
    q: '¿Cuánto cuesta registrar una marca en Argentina?',
    a: `El precio es fijo y por clase: ${formatARS(PRICING.honorarios)} de honorarios más el arancel del INPI de ${formatARS(PRICING.arancelInpi)} (valor ${PRICING.arancelVigencia}) por cada clase que registres, todo en un solo pago y sin costos ocultos. Tenés el detalle completo en <a href="/blog/cuanto-sale-registrar-una-marca">cuánto sale registrar una marca</a>.`,
  },
  {
    q: '¿Cuánto tarda el registro de una marca?',
    a: `Si nadie presenta oposiciones, el trámite tarda alrededor de 2 meses desde la presentación y la marca se concede. Si hay oposiciones, el plazo se extiende. Te contamos los plazos en detalle en <a href="/blog/cuanto-tarda-registro-marca-argentina">cuánto tarda el registro de una marca</a>.`,
  },
  {
    q: '¿Cómo sé si mi marca está disponible?',
    a: `Antes de iniciar el registro conviene verificar que no exista una marca igual o muy parecida en tu clase. Podés usar nuestro <a href="/verificar-marca">verificador de marcas gratuito</a> o leer <a href="/blog/como-saber-si-una-marca-esta-registrada-facilmente">cómo saber si una marca está registrada</a>.`,
  },
  {
    q: '¿Qué clase tengo que elegir?',
    a: `Las marcas se registran por clase según el Clasificador de Niza: cada una agrupa productos o servicios distintos. En el formulario podés buscar tu rubro y elegir una o varias clases (hasta ${MAX_CLASES} por marca). Si tenés dudas, mirá la <a href="/blog/clases-de-marcas-guia-para-registrar-tu-marca-en-argentina">guía de clases de marcas</a> o escribinos por WhatsApp.`,
  },
  {
    q: '¿Puedo registrar más de una marca en el mismo pedido?',
    a: `Sí. En el primer paso podés agregar hasta ${MAX_MARCAS} marcas y en el paso 3 elegís las clases de cada una por separado. Cada marca es una solicitud independiente ante el INPI, así que se cobra por su cuenta: ${formatARS(PRICING.honorarios)} de honorarios más ${formatARS(PRICING.arancelInpi)} de arancel por cada clase de cada marca. Firmás una sola carta poder que cubre todas.`,
  },
  {
    q: '¿Tengo que hacer algún trámite ante el INPI?',
    a: `No. La carta poder que firmás online nos autoriza a presentar y gestionar la solicitud por vos. Nosotros nos ocupamos de todo el trámite ante el INPI y vos recibís las novedades por email, sin turnos ni formularios en papel.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') },
  })),
};
---

<BaseLayout
  title="Registrar mi marca online en Argentina | UnaMarca"
  description="Registrá tu marca en el INPI sin moverte de tu casa: completá la solicitud online en minutos, firmá desde el celular y nosotros presentamos el trámite."
  canonicalURL={`${SITE_URL}/registrar/`}
  waContext="registrar_float"
  structuredData={faqSchema}
>

<div class="ck-page">
  <div class="ck-wrap">

    <header class="ck-header">
      <div class="ck-badge">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 1.5L2.5 4v4c0 3.2 2.4 5.8 5.5 6.5 3.1-.7 5.5-3.3 5.5-6.5V4L8 1.5z" fill="currentColor"/></svg>
        Registro online
      </div>
      <h1>Registrá tu marca online</h1>
      <p>Completá tu solicitud en unos minutos. Nosotros la presentamos ante el INPI.</p>
    </header>

    <!-- Progreso por fase: el contador se reinicia después del pago (ver PHASES) -->
    <div class="ck-progress" id="ck-progress">
      <div class="ck-progress-top">
        <span class="ck-progress-left">
          <b id="ck-phase-label">Tu pedido</b>
          <span id="ck-step-label">Paso 1 de 4</span>
        </span>
        <span id="ck-step-title">Tu marca</span>
      </div>
      <div class="ck-bar"><div class="ck-bar-fill" id="ck-bar-fill" style="width: 25%"></div></div>
    </div>

    <!-- ══════════ PASO 1 · TU MARCA ══════════ -->
    <section class="ck-step" data-step="1">
      <div class="ck-card">
        <div class="ck-section-label" id="ck-marcas-section-label">Tu marca</div>

        <!-- Filas de marca: la primera se pinta siempre, las demás se agregan
             con "+ Agregar otra marca". Ver renderMarcasStep1() en el script. -->
        <div class="ck-field">
          <div id="ck-marcas"></div>
          <p class="ck-err" data-err="marca"></p>
          <button type="button" class="ck-add" id="ck-add-marca">
            <span aria-hidden="true">+</span> Agregar otra marca
          </button>
          <p class="ck-help" id="ck-marca-max" hidden>
            Podés registrar hasta {MAX_MARCAS} marcas en el mismo pedido.
            ¿Necesitás más? <a href={waMultiMarca} target="_blank" rel="noopener noreferrer" onclick="gtag('event', 'whatsapp_click', {'source': 'registrar_multimarca'})">Escribinos por WhatsApp</a>
          </p>
          <p class="ck-help" id="ck-marca-help" hidden>
            Cada marca se presenta como una solicitud separada ante el INPI y se
            cobra por separado. En el paso 3 elegís las clases de cada una.
          </p>
        </div>

        <div class="ck-lock" id="ck-lock-marcas" hidden></div>

        <div class="ck-field">
          <label for="ck-tipo-persona">Tipo de titular</label>
          <div class="ck-sel ck-sel--locked">
            <select id="ck-tipo-persona" disabled><option>Humana</option></select>
          </div>
          <p class="ck-help">¿Es para una empresa? <a href={waEmpresa} target="_blank" rel="noopener noreferrer" onclick="gtag('event', 'whatsapp_click', {'source': 'registrar_empresa'})">Escribinos por WhatsApp</a></p>
        </div>

      </div>

      <!-- Molde de fila de marca: tipo + nombre. Lo clona renderMarcasStep1().
           El tipo va primero porque determina qué es el campo de la derecha: en
           figurativa no hay denominación y el nombre pasa a ser una referencia
           interna que asignamos nosotros. -->
      <template id="ck-marca-row-tpl">
        <div class="ck-marca-row">
          <div class="ck-field ck-marca-tipo">
            <label class="ck-tipo-label">Tipo de marca</label>
            <div class="ck-sel">
              <select class="ck-tipo-sel">
                {TIPOS_MARCA.map(t => <option value={t.value}>{t.label}</option>)}
              </select>
            </div>
          </div>
          <div class="ck-field ck-marca-nombre">
            <label class="ck-marca-label"></label>
            <div class="ck-marca-input">
              <input type="text" maxlength="120" autocomplete="off" />
              <button type="button" class="ck-marca-rm" title="Quitar esta marca" hidden>×</button>
            </div>
            <p class="ck-help ck-marca-nombre-help" hidden></p>
          </div>
        </div>
      </template>

      <div class="ck-nav">
        <span></span>
        <button type="button" class="ck-btn" data-next="1">
          Continuar
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 2 · CONTACTO ══════════ -->
    <section class="ck-step" data-step="2" hidden>
      <div class="ck-card">
        <div class="ck-section-label">Tus datos de contacto</div>
        <div class="ck-grid ck-g2">
          <div class="ck-field">
            <label for="ck-email">Email <em>*</em></label>
            <input type="email" id="ck-email" placeholder="correo@ejemplo.com" autocomplete="email" />
            <p class="ck-help">Acá te enviaremos todas las novedades del trámite.</p>
            <p class="ck-err" data-err="email"></p>
          </div>
          <div class="ck-field">
            <label for="ck-whatsapp">WhatsApp <em>*</em></label>
            <input type="tel" id="ck-whatsapp" placeholder="11 5555 5555" autocomplete="tel" />
            <p class="ck-err" data-err="whatsapp"></p>
          </div>
        </div>
      </div>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="1">← Volver</button>
        <button type="button" class="ck-btn" data-next="2">
          Continuar
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 5 · SOBRE TU MARCA (post-pago, fase B) ══════════ -->
    <section class="ck-step" data-step="5" hidden>
      <div id="ck-pay-banner" class="ck-banner" hidden></div>

      <!-- Una tarjeta colapsable por marca, clonada de #ck-desc-card-tpl
           (renderDescCards). Cada marca es una solicitud independiente: se
           cargan y se revisan de a una. -->
      <div id="ck-desc-cards"></div>

      <template id="ck-desc-card-tpl">
        <details class="ck-card ck-fold ck-dcard" open>
          <summary class="ck-fold-head">
            <span class="ck-fold-title">
              <span class="ck-section-label ck-dcard-name">Sobre tu marca</span>
              <span class="ck-fold-sub ck-dcard-sub"></span>
            </span>
            <svg class="ck-fold-caret" width="12" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="ck-fold-body">
          <div class="ck-field">
            <label>
              <span class="ck-desc-label">Descripción de tu marca</span> <em>*</em>
            </label>
            <textarea class="ck-desc" rows="4" maxlength="1000" placeholder="Contanos qué productos o servicios vas a ofrecer con esta marca."></textarea>
            <p class="ck-help ck-desc-guia">
              Contá qué vendés o qué servicio prestás, a quién se lo ofrecés y por
              qué canales (local, ecommerce, redes).
            </p>
            <div class="ck-desc-foot">
              <p class="ck-help ck-desc-help">Mínimo 100 caracteres.</p>
              <!-- Arranque editable armado con las clases elegidas: el textarea
                   en blanco con mínimo de 100 caracteres es donde más gente se
                   traba del post-pago. -->
              <button type="button" class="ck-link-btn ck-desc-sug">Partir de un ejemplo</button>
            </div>
            <p class="ck-err ck-desc-err"></p>
          </div>
          <div class="ck-field">
            <label>Página web <span class="ck-field-opt">(opcional)</span></label>
            <input type="url" class="ck-sitio" placeholder="https://tumarca.com" autocomplete="url" inputmode="url" />
            <p class="ck-err ck-sitio-err"></p>
          </div>

          <!-- Logo: solo en mixtas y figurativas (renderDescCards lo muestra) -->
          <div class="ck-logo" hidden>
            <div class="ck-field">
              <label class="ck-logo-label">Imagen de tu marca <em>*</em></label>
              <!-- El input queda fuera de pantalla: el área clickeable y de
                   arrastre es el .ck-drop, no el "Choose File" del navegador. -->
              <input type="file" class="ck-logo-file ck-sr" accept={LOGO_ACCEPT} />
              <div class="ck-drop" tabindex="0" role="button">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M3.5 15v3A2.5 2.5 0 0 0 6 20.5h12a2.5 2.5 0 0 0 2.5-2.5v-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span class="ck-drop-title">Subí la imagen de tu marca</span>
                <span class="ck-drop-sub">Arrastrala acá o tocá para elegirla · JPG, PNG o WebP</span>
              </div>
              <p class="ck-err ck-logo-err"></p>
            </div>

            <div class="ck-logo-preview" hidden>
              <img class="ck-logo-img" alt="Vista previa de la imagen de tu marca" />
              <div class="ck-logo-side">
                <p class="ck-logo-meta"></p>
                <button type="button" class="ck-link-btn ck-logo-otra">Cambiar imagen</button>
              </div>
            </div>

            <div class="ck-field">
              <label>Enunciación de colores <em>*</em></label>
              <input type="text" class="ck-colores" maxlength="200" placeholder="Rojo, verde y azul" />
              <p class="ck-help">
                Los colores que aparecen en la imagen. Si es en blanco y negro, escribí
                “Blanco y negro”. La protección queda limitada a los colores que declares.
              </p>
              <p class="ck-err ck-colores-err"></p>
            </div>

            <!-- El INPI pide ALTO y ANCHO del signo en cm. Los derivamos de la
                 proporción de la imagen y NO se le muestran al cliente: es
                 jerga del trámite que no puede resolver mejor que nosotros.
                 Los campos siguen existiendo porque son los que viajan en el
                 payload; quedan fuera de pantalla. -->
            <div class="ck-sr">
              <input type="text" class="ck-logo-alto" inputmode="decimal" tabindex="-1" aria-hidden="true" />
              <input type="text" class="ck-logo-ancho" inputmode="decimal" tabindex="-1" aria-hidden="true" />
            </div>
            <p class="ck-err ck-medidas-err"></p>

            <!-- Solo mixta: el INPI corrige de oficio si la denominación no
                 transcribe todo el texto de la imagen. -->
            <label class="ck-terms ck-logo-confirm" hidden>
              <input type="checkbox" class="ck-logo-ok" />
              <span class="ck-logo-ok-txt"></span>
            </label>
            <p class="ck-err ck-confirm-err"></p>
          </div>
          </div>
        </details>
      </template>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="4">← Volver</button>
        <button type="button" class="ck-btn" data-next="5">
          Continuar
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 6 · DATOS DEL TITULAR (post-pago, fase B) ══════════ -->
    <section class="ck-step" data-step="6" hidden>
      <details class="ck-card ck-fold" open>
        <summary class="ck-fold-head">
          <span class="ck-fold-title">
            <span class="ck-section-label">Datos del titular</span>
            <span class="ck-fold-sub" id="ck-fold-sub-titular">Quién es el dueño de la marca</span>
          </span>
          <svg class="ck-fold-caret" width="12" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="ck-fold-body">
        <p class="ck-help" style="margin-bottom: 1rem">
          Estos datos van en la carta poder y en la solicitud que presentamos
          ante el INPI. Son los del titular de la marca.
        </p>

        <div class="ck-grid ck-g2">
          <div class="ck-field">
            <label for="ck-nombre">Nombre <em>*</em></label>
            <input type="text" id="ck-nombre" placeholder="Nombre" autocomplete="given-name" />
            <p class="ck-help">Tal como figura en tu documento.</p>
            <p class="ck-err" data-err="nombre"></p>
          </div>
          <div class="ck-field">
            <label for="ck-apellido">Apellido <em>*</em></label>
            <input type="text" id="ck-apellido" placeholder="Apellido" autocomplete="family-name" />
            <p class="ck-err" data-err="apellido"></p>
          </div>
        </div>

        <div class="ck-grid ck-g2">
          <div class="ck-field">
            <label for="ck-tipodoc">Tipo de documento <em>*</em></label>
            <div class="ck-sel">
              <select id="ck-tipodoc">
                <option value="DNI" selected>DNI</option>
                <option value="Pasaporte">Pasaporte</option>
                <option value="Libreta Cívica">Libreta Cívica</option>
                <option value="Libreta de Enrolamiento">Libreta de Enrolamiento</option>
              </select>
            </div>
          </div>
          <div class="ck-field">
            <label for="ck-docnum">Número de documento <em>*</em></label>
            <input type="text" id="ck-docnum" placeholder="28765432" autocomplete="off" maxlength="20" />
            <p class="ck-err" data-err="docnum"></p>
          </div>
        </div>

        <div class="ck-field">
          <label for="ck-cuit">CUIT / CUIL <em>*</em></label>
          <input type="text" id="ck-cuit" placeholder="27-22730331-5" inputmode="numeric" autocomplete="off" maxlength="13" />
          <p class="ck-err" data-err="cuit"></p>
        </div>

        <div class="ck-grid ck-g2">
          <div class="ck-field">
            <label for="ck-genero">Género <em>*</em></label>
            <div class="ck-sel">
              <select id="ck-genero">
                <option value="">Seleccionar…</option>
                <option>Masculino</option>
                <option>Femenino</option>
                <option>Otro</option>
              </select>
            </div>
            <p class="ck-err" data-err="genero"></p>
          </div>
          <div class="ck-field">
            <label for="ck-estadocivil">Estado civil <em>*</em></label>
            <div class="ck-sel">
              <select id="ck-estadocivil">
                <option value="">Seleccionar…</option>
                <option>Soltero/a</option>
                <option>Casado/a</option>
                <option>Viudo/a</option>
                <option>Divorciado/a</option>
              </select>
            </div>
            <p class="ck-err" data-err="estadocivil"></p>
          </div>
        </div>

        <div class="ck-field" id="ck-conyuge-row" hidden>
          <label for="ck-conyuge">Nombre del cónyuge <em>*</em></label>
          <input type="text" id="ck-conyuge" placeholder="Nombre completo del cónyuge" autocomplete="off" />
          <p class="ck-err" data-err="conyuge"></p>
        </div>

        </div>
      </details>

      <details class="ck-card ck-fold" open>
        <summary class="ck-fold-head">
          <span class="ck-fold-title">
            <span class="ck-section-label">Domicilio real</span>
            <span class="ck-fold-sub">Dónde vive el titular</span>
          </span>
          <svg class="ck-fold-caret" width="12" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="ck-fold-body">
          <div class="ck-grid ck-g2">
            <div class="ck-field">
              <label for="ck-calle">Calle <em>*</em></label>
              <input type="text" id="ck-calle" placeholder="Av. Corrientes" autocomplete="address-line1" />
              <p class="ck-err" data-err="calle"></p>
            </div>
            <div class="ck-field">
              <label for="ck-numero">Número <em>*</em></label>
              <input type="text" id="ck-numero" placeholder="1234" autocomplete="off" />
              <p class="ck-err" data-err="numero"></p>
            </div>
          </div>
          <div class="ck-grid ck-g2">
            <div class="ck-field">
              <label for="ck-piso">Piso</label>
              <input type="text" id="ck-piso" placeholder="3" autocomplete="off" />
            </div>
            <div class="ck-field">
              <label for="ck-depto">Depto</label>
              <input type="text" id="ck-depto" placeholder="A" autocomplete="off" />
            </div>
          </div>
          <div class="ck-grid ck-g2">
            <div class="ck-field">
              <label for="ck-localidad">Localidad <em>*</em></label>
              <input type="text" id="ck-localidad" placeholder="La Plata" autocomplete="address-level2" />
              <p class="ck-err" data-err="localidad"></p>
            </div>
            <div class="ck-field">
              <label for="ck-codpostal">Código postal <em>*</em></label>
              <input type="text" id="ck-codpostal" placeholder="1900" autocomplete="postal-code" />
              <p class="ck-err" data-err="codpostal"></p>
            </div>
          </div>
          <div class="ck-field">
            <label for="ck-provincia">Provincia <em>*</em></label>
            <div class="ck-sel">
              <select id="ck-provincia">
                <option value="">Seleccionar…</option>
                {PROVINCIAS.map(p => <option value={p}>{p}</option>)}
              </select>
            </div>
            <p class="ck-err" data-err="provincia"></p>
          </div>

          <!-- Casi todos los titulares viven en Argentina: el campo está, pero
               no ocupa lugar hasta que hace falta. -->
          <div class="ck-field ck-pais-row" id="ck-pais-row" hidden>
            <label for="ck-pais">País <em>*</em></label>
            <input type="text" id="ck-pais" value="Argentina" autocomplete="country-name" />
          </div>
          <button type="button" class="ck-link-btn ck-pais-toggle" id="ck-pais-toggle">
            El titular vive fuera de Argentina
          </button>
        </div>
      </details>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="5">← Volver</button>
        <button type="button" class="ck-btn" data-next="6">
          Continuar
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 3 · PLAN ══════════ -->
    <section class="ck-step" data-step="3" hidden>
      <div class="ck-card">
        <div class="ck-section-label" id="ck-clases-section-label">Elegí tu clase</div>

        <div class="ck-field">
          <!-- La ayuda va antes de elegir: explica qué es una clase, que es lo
               que hace falta saber para poder elegirla. -->
          <p class="ck-help ck-clases-intro">
            Cada clase protege un grupo distinto de productos o servicios; podés
            elegir hasta {MAX_CLASES} por marca.
            ¿No sabés cuál? <a href={waClase} target="_blank" rel="noopener noreferrer" onclick="gtag('event', 'whatsapp_click', {'source': 'registrar_clase'})">Consultanos por WhatsApp</a>
          </p>
          <!-- Una tarjeta por marca, clonada de #ck-clase-card-tpl.
               Ver renderClasesCards() en el script. -->
          <div id="ck-clases-cards"></div>
          <p class="ck-err" data-err="clase"></p>
          <div class="ck-lock" id="ck-lock-clases" hidden></div>
        </div>

        <!-- Molde de la tarjeta de clases (el <select> de Niza se renderiza acá
             una sola vez y se clona por marca) -->
        <template id="ck-clase-card-tpl">
          <div class="ck-mcard">
            <div class="ck-mcard-head">
              <span class="ck-mcard-name"></span>
              <span class="ck-mcard-sub" hidden></span>
            </div>
            <div class="ck-dd">
              <button type="button" class="ck-dd-btn" aria-haspopup="listbox" aria-expanded="false">
                <span class="ck-dd-label ck-dd-placeholder">Seleccioná una o más clases…</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="ck-dd-panel" hidden>
                <input type="text" class="ck-dd-search" placeholder="Buscar… (ej: ropa, café, software)" autocomplete="off" />
                <ul class="ck-dd-list" role="listbox" aria-multiselectable="true">
                  {NIZA_CLASSES.map(c => (
                    <li>
                      <button type="button" class="ck-dd-opt" data-num={c.num} data-extra={c.textoOficial} role="option">
                        <span class="ck-dd-num">Clase {c.num}</span>
                        <span class="ck-dd-name">{c.nombre}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="ck-chips" hidden></div>
            <!-- El encabezado oficial de Niza es lo que realmente se protege,
                 pero es un párrafo por clase: va plegado, no a la vista. -->
            <details class="ck-clase-det" hidden>
              <summary></summary>
              <div class="ck-clase-det-body"></div>
            </details>
            <p class="ck-help ck-clase-max" hidden>
              Llegaste al máximo de {MAX_CLASES} clases para esta marca.
              ¿Necesitás más? <a href={waMulti} target="_blank" rel="noopener noreferrer" onclick="gtag('event', 'whatsapp_click', {'source': 'registrar_multiclase'})">Escribinos por WhatsApp</a>
            </p>
          </div>
        </template>

      </div>

      <!-- Qué comprás. El precio no se repite acá: vive en el resumen (rail en
           desktop, tarjeta de abajo en mobile). -->
      <div class="ck-card">
        <div class="ck-section-label">Qué incluye</div>

        <ul class="ck-plan-feats">
          <li>Presentación de la solicitud ante el INPI</li>
          <li>Novedades del trámite por email</li>
          <li>Vigilancia de marca <s>{formatARS(PRICING.vigilanciaLista)}</s> <b>Gratis</b></li>
          <li id="ck-feat-garantia" hidden></li>
        </ul>

        <label class="ck-upsell">
          <input type="checkbox" id="ck-garantia" />
          <div class="ck-upsell-body">
            <div class="ck-upsell-head">
              <span class="ck-upsell-name">Sumá la Garantía de Devolución</span>
              <span class="ck-upsell-price" id="ck-upsell-price">+{formatARS(PRICING.garantia)}</span>
            </div>
            <p class="ck-upsell-desc">
              Si el INPI deniega el registro en alguna de tus clases, te devolvemos
              los {formatARS(PRICING.honorarios)} de honorarios de esa clase.
              Cuesta {formatARS(PRICING.garantia)} por clase.
            </p>
          </div>
        </label>

        <details class="ck-fine">
          <summary>Qué no incluye</summary>
          <p>
            El registro de una marca está sujeto a la resolución del INPI. Durante el trámite
            pueden surgir oposiciones de terceros u observaciones; te notificaremos y podrás
            decidir cómo continuar. Los honorarios no incluyen la negociación de oposiciones
            ni la contestación de vistas, que se cotizan por separado si se presentan.
          </p>
        </details>
      </div>

      <div class="ck-card ck-summary">
        <!-- Detalle por marca: solo con más de una (renderSummaryMarcas) -->
        <div id="ck-sum-marcas" hidden></div>
        <div class="ck-sum-row">
          <span id="ck-sum-hon-label">Honorarios — Registro de marca (1 clase)</span>
          <span id="ck-sum-hon">{formatARS(PRICING.honorarios)}</span>
        </div>
        <div class="ck-sum-row" id="ck-sum-garantia-row" hidden>
          <span id="ck-sum-gar-label">Garantía de Devolución (1 clase)</span>
          <span id="ck-sum-gar">{formatARS(PRICING.garantia)}</span>
        </div>
        <div class="ck-sum-row">
          <span id="ck-sum-ara-label">Arancel INPI (1 clase) <small>se paga al INPI · valor {PRICING.arancelVigencia}</small></span>
          <span id="ck-sum-ara">{formatARS(PRICING.arancelInpi)}</span>
        </div>
        <div class="ck-sum-row ck-sum-total">
          <span>Total</span>
          <span id="ck-sum-total">{formatARS(PRICING.honorarios + PRICING.arancelInpi)}</span>
        </div>
      </div>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="2">← Volver</button>
        <button type="button" class="ck-btn" data-next="3">
          Continuar
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 4 · PAGO (placeholder v1) ══════════ -->
    <section class="ck-step" data-step="4" hidden>
      <div class="ck-card">
        <div class="ck-section-label">Cómo querés pagar</div>

        <div class="ck-pay-summary">
          <!-- Una línea por marca: "MARCA A · Clases 2 y 3" -->
          <div id="ck-pay-marcas"></div>
          <div class="ck-pay-detail" id="ck-pay-plan">Registro de marca</div>
          <div class="ck-pay-total">Total: <b id="ck-pay-total">–</b></div>
        </div>

        <!-- Fijar la expectativa de que después del pago falta algo evita
             abandonos en la fase B, pero no puede ser un cartel de alerta justo
             antes del botón de pagar: va en texto plano, sin caja de color. -->
        <p class="ck-pay-lead">
          Después de pagar te pedimos los datos del titular y tu firma. Son dos
          minutos y tu solicitud queda lista para presentar.
        </p>

        <div class="ck-pay-methods" id="ck-pay-methods">
          <button type="button" class="ck-pm" id="ck-mp-btn">
            <span class="ck-pm-icon ck-pm-icon--mp">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="12" rx="11" ry="8" stroke="currentColor" stroke-width="1.6"/><path d="M5 12c2-.8 3.4-2.4 4.6-2.4 1.3 0 1.8 1.2 2.9 1.2 1 0 1.7-.9 3-.9 1.5 0 2.4 1.3 3.5 2.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </span>
            <span class="ck-pm-title">Mercado Pago</span>
            <span class="ck-pm-desc">
              Tarjeta de crédito o débito, cuotas y dinero en cuenta.
              Se acredita al instante.
            </span>
            <span class="ck-pm-go" id="ck-mp-label">Pagar con Mercado Pago</span>
          </button>

          <button type="button" class="ck-pm" id="ck-tr-btn">
            <span class="ck-pm-icon ck-pm-icon--tr">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 9.5L12 4l9 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10.5v7M9.5 10.5v7M14.5 10.5v7M18.5 10.5v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M3 20h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </span>
            <span class="ck-pm-title">Transferencia bancaria</span>
            <span class="ck-pm-desc">
              Desde tu home banking, con alias.
              Te mostramos los datos de la cuenta.
            </span>
            <span class="ck-pm-go" id="ck-tr-label">Pagar por transferencia</span>
          </button>
        </div>

        <p class="ck-err" data-err="pago" style="text-align:center; margin-top:0.6rem"></p>

        <p class="ck-help ck-pay-note" id="ck-pay-note">
          El precio es el mismo con las dos formas de pago.
        </p>

        <!-- Datos de la cuenta: se revela al elegir transferencia -->
        <div class="ck-transfer" id="ck-transfer" hidden>
          <div class="ck-transfer-head">
            Transferí <b id="ck-tr-importe">–</b> a esta cuenta
          </div>

          <div class="ck-transfer-rows">
            <div class="ck-tr-row">
              <span class="ck-tr-k">Alias</span>
              <span class="ck-tr-v"><b>{TRANSFERENCIA.alias}</b></span>
              <button type="button" class="ck-copy" data-copy={TRANSFERENCIA.alias}>Copiar</button>
            </div>
            <div class="ck-tr-row">
              <span class="ck-tr-k">Titular</span>
              <span class="ck-tr-v">{TRANSFERENCIA.titular}</span>
              <span></span>
            </div>
            <div class="ck-tr-row">
              <span class="ck-tr-k">Banco</span>
              <span class="ck-tr-v">{TRANSFERENCIA.banco}</span>
              <span></span>
            </div>
            <div class="ck-tr-row">
              <span class="ck-tr-k">N° de pedido</span>
              <span class="ck-tr-v"><b id="ck-tr-ref">–</b></span>
              <button type="button" class="ck-copy" id="ck-copy-ref">Copiar</button>
            </div>
          </div>

          <p class="ck-transfer-note">
            Podés transferir ahora o más tarde: <b>seguí completando tu solicitud
            igual</b>. Presentamos ante el INPI dentro de las 48 horas hábiles
            desde que se acredita la transferencia.
          </p>

          <a class="ck-transfer-wa" id="ck-tr-wa" href="#" target="_blank" rel="noopener noreferrer">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.5-1.2-2.9s.7-2 1-2.3c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.7 1.2 1.5 1.9 1 .9 1.8 1.2 2.1 1.3.3.1.4.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"/></svg>
            Enviar comprobante por WhatsApp
          </a>

          <p class="ck-transfer-resume">
            ¿Cerrás la página? Retomá tu solicitud en
            <a id="ck-tr-resume" href="#">este link</a>.
          </p>

          <button type="button" class="ck-btn ck-transfer-next" id="ck-tr-next">
            Continuar y completar mis datos
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="ck-link-btn ck-transfer-otro" id="ck-tr-otro">← Elegir otra forma de pago</button>
        </div>

        <!-- El plazo del trámite tranquiliza, pero no es una instrucción: va al
             pie, no en un banner arriba del botón de pagar. -->
        <p class="ck-fine-note">
          Presentamos tu solicitud ante el INPI dentro de las 48 horas hábiles.
          Si no hay vistas u oposiciones, la marca suele resultar inscripta en un
          plazo de 60 a 90 días desde ingresada, y recibís novedades en cada etapa.
        </p>
      </div>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="3">← Volver</button>
        <!-- Solo demo/test: visible únicamente en previews (*.pages.dev) y localhost -->
        <button type="button" class="ck-btn ck-btn--ghost" id="ck-skip-pay" hidden>
          Saltar pago (demo)
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ PASO 7 · REVISIÓN Y FIRMA (post-pago, fase B) ══════════ -->
    <section class="ck-step" data-step="7" hidden>
      <div class="ck-card">
        <div class="ck-section-label">Revisá tu carta poder</div>
        <p class="ck-help" style="margin-bottom: 1rem">
          Este documento nos autoriza a presentar y gestionar tu solicitud ante el INPI.
          Revisá que todos los datos sean correctos.
        </p>
        <div class="ck-cp" id="ck-cp-preview"></div>
        <button type="button" class="ck-link-btn" id="ck-edit-datos">✎ Editar mis datos</button>
      </div>

      <div class="ck-card">
        <div class="ck-section-label">Tu firma</div>
        <p class="ck-help" style="margin-bottom: 0.75rem">
          Firmá en el recuadro con el dedo (celular) o con el mouse, como lo harías en papel.
        </p>
        <div class="ck-sig-box">
          <canvas id="ck-sig"></canvas>
          <span class="ck-sig-hint" id="ck-sig-hint">Firmá acá</span>
        </div>
        <div class="ck-sig-foot">
          <button type="button" class="ck-link-btn" id="ck-sig-undo" hidden>↶ Deshacer</button>
          <button type="button" class="ck-link-btn" id="ck-sig-clear">Borrar y firmar de nuevo</button>
        </div>

        <label class="ck-terms">
          <input type="checkbox" id="ck-terms" />
          <span>Acepto los <a href="/terminos" target="_blank">términos del servicio</a> y la <a href="/privacidad" target="_blank">política de privacidad</a>, y autorizo el uso de mi firma en la carta poder.</span>
        </label>
      </div>

      <div class="ck-nav">
        <button type="button" class="ck-back" data-back="6">← Volver</button>
        <button type="button" class="ck-btn" id="ck-submit" disabled>
          <span id="ck-submit-label">Confirmar y enviar solicitud</span>
          <svg id="ck-submit-spin" width="16" height="16" viewBox="0 0 16 16" fill="none" style="display:none"><circle cx="8" cy="8" r="6" stroke="rgba(255,255,255,.3)" stroke-width="2"/><path d="M8 2a6 6 0 0 1 6 6" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </section>

    <!-- ══════════ CONFIRMACIÓN ══════════ -->
    <section class="ck-step" data-step="done" hidden>
      <div class="ck-card ck-done">
        <svg width="52" height="52" viewBox="0 0 52 52" fill="none"><circle cx="26" cy="26" r="25" fill="#22c55e" fill-opacity=".12"/><path d="M16 26.5l7 7 13-14" stroke="#16a34a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h2 id="ck-done-title">¡Listo! Recibimos tu solicitud.</h2>
        <p id="ck-done-mail">Te enviamos una copia de tu carta poder firmada a <b id="ck-done-email"></b>.</p>

        <div class="ck-done-ref">
          <span>Tu N° de pedido</span>
          <b id="ck-ref"></b>
          <button type="button" class="ck-copy" id="ck-copy-done">Copiar</button>
        </div>
        <p class="ck-done-ref-help">Guardalo: con ese número seguimos tu trámite por WhatsApp o email.</p>
      </div>

      <!-- Qué pasa ahora. El trámite dura meses y el cliente acaba de pagar:
           saber qué sigue es lo que evita el "¿en qué quedó lo mío?" a las dos
           semanas. -->
      <div class="ck-card">
        <div class="ck-section-label">Qué pasa ahora</div>
        <ol class="ck-timeline" id="ck-timeline">
          <li>
            <b>Presentamos tu solicitud ante el INPI</b>
            <span id="ck-tl-presenta">Dentro de las próximas 48 horas hábiles. Te avisamos por email cuando esté ingresada.</span>
          </li>
          <li>
            <b>Publicación en el Boletín de Marcas</b>
            <span>El INPI publica tu solicitud y se abre un plazo de 30 días para que terceros puedan oponerse.</span>
          </li>
          <li>
            <b>Resolución</b>
            <span>Si no hay vistas ni oposiciones, la marca suele quedar inscripta entre 60 y 90 días desde la presentación.</span>
          </li>
        </ol>
        <p class="ck-fine-note">
          Te escribimos por email en cada etapa. Si aparece una oposición o una
          vista, te avisamos y te contamos las opciones antes de hacer nada.
        </p>
      </div>

      <!-- Solo se muestra si hay algo pendiente (transferencia o imagen) -->
      <div class="ck-card ck-done ck-done-extra" id="ck-done-extra" hidden>

        <!-- Solo si la imagen no llegó al servidor: el pedido se envía igual -->
        <div class="ck-done-transfer" id="ck-done-logo" hidden>
          <p class="ck-done-transfer-title">Nos falta la imagen de tu marca</p>
          <p>
            No pudimos guardar el archivo del logo. Te lo vamos a pedir por
            WhatsApp para presentar la solicitud: tu pedido ya quedó registrado.
          </p>
        </div>

        <!-- Recordatorio de la transferencia: solo si eligió ese medio de pago -->
        <div class="ck-done-transfer" id="ck-done-transfer" hidden>
          <p class="ck-done-transfer-title">Falta tu transferencia</p>
          <p>
            Transferí <b id="ck-done-importe">–</b> a <b>{TRANSFERENCIA.alias}</b>
            ({TRANSFERENCIA.titular}, {TRANSFERENCIA.banco}). Presentamos tu
            solicitud cuando se acredite.
          </p>
          <a class="ck-transfer-wa" id="ck-done-wa" href="#" target="_blank" rel="noopener noreferrer">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.5-1.2-2.9s.7-2 1-2.3c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.7 1.2 1.5 1.9 1 .9 1.8 1.2 2.1 1.3.3.1.4.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3.1.1.1.6-.1 1.2z"/></svg>
            Enviar comprobante por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════ RESUMEN PERSISTENTE ══════════
         Un solo lugar donde vive el precio, desde que hay uno (paso 3) hasta la
         firma. En desktop es una columna sticky al lado del formulario; en
         mobile, una barra fija abajo que se despliega. Los resúmenes que ya
         existen dentro de los pasos 3 y 4 se ocultan cuando este se ve, para
         que el total nunca aparezca dos veces en la misma pantalla. -->
    <aside class="ck-rail" id="ck-rail" hidden aria-label="Resumen de tu pedido">
      <button type="button" class="ck-rail-bar" id="ck-rail-toggle"
              aria-expanded="false" aria-controls="ck-rail-body">
        <span class="ck-rail-bar-k">Total</span>
        <span class="ck-rail-bar-v" id="ck-rail-bar-total">–</span>
        <svg width="11" height="7" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="ck-rail-body" id="ck-rail-body">
        <div class="ck-rail-title">Tu pedido</div>
        <div class="ck-rail-marcas" id="ck-rail-marcas"></div>
        <div class="ck-rail-rows" id="ck-rail-rows"></div>
        <div class="ck-rail-total">
          <span>Total</span>
          <b id="ck-rail-total">–</b>
        </div>
        <p class="ck-rail-note" id="ck-rail-note" hidden></p>
      </div>
    </aside>

    <!-- ══════════ FAQ (solo en el paso 1: ver .ck-focus) ══════════ -->
    <section class="ck-faq" aria-labelledby="ck-faq-title">
      <h2 id="ck-faq-title">Preguntas frecuentes</h2>
      {faqs.map(({ q, a }) => (
        <details class="ck-faq-item">
          <summary>{q}</summary>
          <p set:html={a} />
        </details>
      ))}
    </section>

  </div>
</div>

</BaseLayout>

<script>
  import { NIZA_CLASSES } from '../lib/checkout/nizaClasses';
  import {
    PRICING, MAX_CLASES, MAX_MARCAS, TRANSFERENCIA,
    computeOrderPricing, contarLineas, clasesTexto, lineasTexto, formatARS,
    TIPOS_MARCA, LOGO_MAX_PX, LOGO_JPEG_QUALITY, LOGO_CM_MAX, LOGO_CM_LADO_MAYOR,
    formatCm, parseCm, medidasDesdePx, normalizeTipoMarca, requiereLogo,
    tieneDenominacion, tipoMarcaLabel, type TipoMarca,
  } from '../lib/checkout/constants';
  import { formatCuitInput, isValidCuit, cuitMatchesDni } from '../lib/checkout/cuit';
  import { cartaPoderHTML, type CartaPoderData } from '../lib/checkout/cartaPoder';
  import { waHrefComprobante } from '../lib/wa';

  const DRAFT_KEY = 'um-checkout-draft';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const tpl = (id: string) => (document.getElementById(id) as HTMLTemplateElement);

  // true = modo test (ningún campo obligatorio, formatos solo si hay valor)
  const FIELDS_OPTIONAL = false;

  // ── Estado ──────────────────────────────────────────────
  // Un pedido son 1..MAX_MARCAS marcas, cada una con sus propias clases.
  // `descripcion` y `sitioWeb` se completan en el paso 5 (post-pago).
  // El logo (mixta/figurativa) también es del paso 5: el INPI no lo necesita
  // para cobrar, y pedir un archivo antes del pago cuesta conversión.
  interface MarcaState {
    nombre: string;
    tipo: TipoMarca;
    clases: number[];
    descripcion: string;
    sitioWeb: string;
    /** Enunciación de colores — obligatoria en mixta y figurativa */
    colores: string;
    alto: number | null;
    ancho: number | null;
    /** Solo mixta: el cliente confirma que la denominación transcribe todo el
     *  texto de la imagen (si no coincide, el INPI corrige de oficio). */
    confirmaTexto: boolean;
    /** Key en R2, la escribe el servidor al subir */
    logoKey: string | null;
    /** Transitorios: no van al draft (un JPG no entra en localStorage) */
    logoBlob?: Blob | null;
    logoUrl?: string | null;
    logoNombre?: string;
    logoPx?: { ancho: number; alto: number } | null;
  }
  const nuevaMarca = (nombre = '', tipo: TipoMarca = 'denominativa'): MarcaState => ({
    nombre, tipo, clases: [], descripcion: '', sitioWeb: '',
    colores: '', alto: null, ancho: null, confirmaTexto: false,
    logoKey: null, logoBlob: null, logoUrl: null, logoNombre: '', logoPx: null,
  });

  let marcas: MarcaState[] = [nuevaMarca()];
  let garantia = false;
  let orderRef: string | null = null; // pedido creado al iniciar el pago
  type MetodoPago = 'mercadopago' | 'transferencia';
  let metodoPago: MetodoPago = 'mercadopago';

  /** Marcas y clases quedan congeladas una vez que existe el pedido: lo que se
   *  presenta ante el INPI tiene que ser exactamente lo que se pagó. */
  let pedidoBloqueado = false;

  const FIELD_IDS = [
    'ck-nombre', 'ck-apellido', 'ck-tipodoc', 'ck-docnum',
    'ck-cuit', 'ck-genero', 'ck-estadocivil', 'ck-conyuge',
    'ck-pais', 'ck-calle', 'ck-numero', 'ck-piso', 'ck-depto',
    'ck-localidad', 'ck-codpostal', 'ck-provincia',
    'ck-email', 'ck-whatsapp',
  ];

  /** El draft guarda todo menos la imagen: un JPG en base64 no entra en la
   *  cuota de localStorage. Si el cliente recarga antes de enviar, vuelve a
   *  elegir el archivo (el resto de lo cargado sigue ahí). */
  function marcaParaDraft(m: MarcaState) {
    const { logoBlob, logoUrl, logoPx, ...resto } = m;
    return resto;
  }

  function draftBody() {
    const values: Record<string, string> = {};
    FIELD_IDS.forEach(id => { values[id] = input(id).value; });
    // `at` viaja a las dos copias (local y servidor) para poder decidir cuál es
    // más nueva al retomar el pedido desde otro dispositivo.
    return { values, marcas: marcas.map(marcaParaDraft), garantia, at: new Date().toISOString() };
  }

  function saveDraft() {
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draftBody()));
    } catch (e) {
      console.warn('[um-checkout] no se pudo guardar el draft:', e);
    }
    // Con pedido creado, lo mismo va al servidor: el localStorage no sobrevive
    // a cerrar la pestaña en otro dispositivo ni a limpiar el navegador, y del
    // otro lado quedaría un pedido cobrado y sin datos.
    programarProgreso();
  }

  // ── Progreso post-pago en el servidor ───────────────────
  // Se manda con debounce mientras el cliente escribe, y de nuevo al salir de
  // la página. Solo existe una vez que hay pedido: antes del pago no hay dónde
  // guardarlo ni nada que perder.
  const PROGRESO_DEBOUNCE_MS = 2500;
  let progresoTimer: number | undefined;
  let progresoPendiente = false;

  function programarProgreso() {
    if (!orderRef) return;
    progresoPendiente = true;
    clearTimeout(progresoTimer);
    progresoTimer = window.setTimeout(() => { void enviarProgreso(); }, PROGRESO_DEBOUNCE_MS);
  }

  async function enviarProgreso() {
    if (!orderRef || !progresoPendiente) return;
    progresoPendiente = false;
    clearTimeout(progresoTimer);
    try {
      await fetch(`/api/checkout/order/${encodeURIComponent(orderRef)}/progreso`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(draftBody()),
        keepalive: true,
      });
    } catch (e) {
      // Nunca bloquea al cliente: el localStorage sigue siendo la copia local
      console.warn('[um-checkout] no se pudo guardar el progreso:', e);
      progresoPendiente = true;
    }
  }

  /** Último intento cuando se va la página. sendBeacon sobrevive al unload, que
   *  es justo el caso que esto viene a cubrir. */
  function flushProgreso() {
    if (!orderRef || !progresoPendiente) return;
    progresoPendiente = false;
    const url = `/api/checkout/order/${encodeURIComponent(orderRef)}/progreso`;
    const blob = new Blob([JSON.stringify(draftBody())], { type: 'application/json' });
    if (!navigator.sendBeacon?.(url, blob)) void enviarProgreso();
  }

  window.addEventListener('pagehide', flushProgreso);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') flushProgreso();
  });

  function leerDraft(): any {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch { return null; }
  }

  function restoreDraft() {
    try {
      const draft = leerDraft();
      if (!draft) return;
      FIELD_IDS.forEach(id => { if (draft.values?.[id]) input(id).value = draft.values[id]; });
      syncConyuge();
      syncPais();
      setMarcas(marcasDesdeDraft(draft), false);
      if (typeof draft.garantia === 'boolean') {
        garantia = draft.garantia;
        input('ck-garantia').checked = garantia;
        updateSummary();
      }
    } catch { /* draft corrupto: ignorar */ }
  }

  /** Drafts v1: una sola marca en values['ck-marca'] + clases/clase sueltas,
   *  con la descripción y el sitio en values. */
  function marcasDesdeDraft(draft: any): MarcaState[] {
    if (Array.isArray(draft?.marcas) && draft.marcas.length) {
      return draft.marcas.map((m: any) => ({
        ...nuevaMarca(String(m?.nombre ?? ''), normalizeTipoMarca(m?.tipo)),
        clases: Array.isArray(m?.clases) ? m.clases : [],
        descripcion: String(m?.descripcion ?? ''),
        sitioWeb: String(m?.sitioWeb ?? ''),
        colores: String(m?.colores ?? ''),
        alto: typeof m?.alto === 'number' ? m.alto : null,
        ancho: typeof m?.ancho === 'number' ? m.ancho : null,
        confirmaTexto: m?.confirmaTexto === true,
        logoKey: typeof m?.logoKey === 'string' ? m.logoKey : null,
      }));
    }
    const nombre = String(draft?.values?.['ck-marca'] ?? '');
    const clases = Array.isArray(draft?.clases)
      ? draft.clases
      : (draft?.clase ? [draft.clase] : []);
    if (!nombre && !clases.length) return [];
    return [{
      ...nuevaMarca(nombre),
      clases,
      descripcion: String(draft?.values?.['ck-descripcion'] ?? ''),
      sitioWeb: String(draft?.values?.['ck-sitioweb'] ?? ''),
    }];
  }

  /** Marcas tal como quedaron guardadas en el pedido (D1). Pedidos v1 traen una
   *  sola marca en `marca` + `clases`/`clase`. */
  function marcasDelPedido(p: any): MarcaState[] {
    if (Array.isArray(p?.marcas) && p.marcas.length) {
      return p.marcas.map((m: any) => nuevaMarcaCon(m?.nombre, m?.clases, m?.tipo, m?.logoKey));
    }
    const clases = Array.isArray(p?.clases) ? p.clases : (p?.clase ? [p.clase] : []);
    if (!p?.marca?.nombre && !clases.length) return [];
    return [nuevaMarcaCon(p?.marca?.nombre, clases, p?.marca?.tipo, null)];
  }
  const nuevaMarcaCon = (
    nombre: unknown, clases: unknown, tipo?: unknown, logoKey?: unknown,
  ): MarcaState => ({
    ...nuevaMarca(String(nombre ?? ''), normalizeTipoMarca(tipo)),
    clases: Array.isArray(clases) ? clases : [],
    logoKey: typeof logoKey === 'string' ? logoKey : null,
  });

  // ── Analytics: funnel GA4 ───────────────────────────────
  // Cada evento se manda una sola vez por sesión (volver atrás y avanzar de
  // nuevo no infla el funnel). sessionStorage sobrevive el ida-y-vuelta a MP.
  const FIRED_KEY = 'um-ck-fired';
  let fired = new Set<string>();
  try { fired = new Set(JSON.parse(sessionStorage.getItem(FIRED_KEY) || '[]')); } catch { /* ignorar */ }
  function track(name: string, params: Record<string, unknown> = {}, once = true) {
    try {
      if (once) {
        if (fired.has(name)) return;
        fired.add(name);
        sessionStorage.setItem(FIRED_KEY, JSON.stringify([...fired]));
      }
      const w = window as any;
      if (typeof w.gtag === 'function') w.gtag('event', name, params);
    } catch { /* analytics nunca bloquea el checkout */ }
  }

  // Paso alcanzado → evento. Los nombres son un contrato con el funnel de GA4:
  // no se renombran aunque el paso cambie de número o de contenido, o se rompe
  // la comparabilidad con el histórico. `ck_paso_titular` sigue significando
  // "llegó al post-pago" y `ck_paso_firma` "llegó a la firma".
  const STEP_EVENTS: Record<string, string> = {
    '2': 'begin_checkout',   // completó el nombre de su marca
    '3': 'ck_paso_pedido',   // dejó contacto, ve el precio
    '4': 'ck_paso_pago',     // aceptó el pedido, ve el botón de pago
    '5': 'ck_paso_titular',  // volvió de MP con pedido creado (fase B, 1/3)
    '6': 'ck_paso_datos',    // cargó lo de su marca, va por el titular (2/3)
    '7': 'ck_paso_firma',    // completó titular, ve la carta poder (3/3)
  };

  // ── Navegación entre pasos ──────────────────────────────
  // El pago parte el checkout en dos fases con contadores independientes: el
  // que ya pagó no puede seguir leyendo "te faltan 2 pasos de 6". El paso de
  // pago es el cierre de la fase A y no cuenta como paso propio (por eso la
  // barra de la fase A nunca llega al 100% antes de pagar).
  interface Phase { label: string; steps: string[]; beats: number }
  const PHASES: Phase[] = [
    { label: 'Tu pedido',    steps: ['1', '2', '3', '4'], beats: 4 },
    { label: 'Tu solicitud', steps: ['5', '6', '7'],      beats: 3 },
  ];
  const phaseOf = (step: string) => PHASES.find(p => p.steps.includes(step)) ?? PHASES[0];

  function stepTitle(step: string): string {
    const varias = marcas.length > 1;
    switch (step) {
      case '1': return varias ? 'Tus marcas' : 'Tu marca';
      case '2': return 'Contacto';
      case '3': return varias ? 'Clases y precio' : 'Clase y precio';
      case '4': return 'Pago';
      case '5': return varias ? 'Sobre tus marcas' : 'Sobre tu marca';
      case '6': return 'Titular';
      case '7': return 'Firma';
      default: return '';
    }
  }

  /** Etiqueta de avance dentro de la fase. El paso de pago se muestra como tal
   *  ("Pago") y no como "paso 4 de 4": es el final de la fase A, no un trámite. */
  function progressLabel(step: string, phase: Phase): string {
    if (step === '4') return 'Pago';
    const i = phase.steps.indexOf(step) + 1;
    return `Paso ${i} de ${phase.beats}`;
  }

  function goTo(step: string) {
    document.querySelectorAll<HTMLElement>('.ck-step').forEach(s => {
      s.hidden = s.dataset.step !== step;
    });
    // Fuera del paso 1 el checkout entra en modo foco: sin hero, sin FAQ, sin
    // footer y sin el CTA del header. El paso 1 es la página que ve Google y
    // la que convence al que llega de orgánico, así que queda intacta.
    document.body.classList.toggle('ck-focus', step !== '1');
    document.body.classList.toggle('ck-fin', step === 'done');
    document.body.dataset.ckStep = step;

    if (step === 'done') {
      $('ck-progress').hidden = true;
    } else {
      const phase = phaseOf(step);
      $('ck-progress').hidden = false;
      const avance = progressLabel(step, phase);
      const titulo = stepTitle(step);
      $('ck-phase-label').textContent = phase.label;
      $('ck-step-label').textContent = avance;
      // En el paso de pago el avance ya dice "Pago": no se repite a la derecha
      $('ck-step-title').textContent = titulo === avance ? '' : titulo;
      $('ck-bar-fill').style.width =
        `${((phase.steps.indexOf(step) + 1) / phase.beats) * 100}%`;
    }
    if (step === '3') renderClasesCards();
    if (step === '4') updatePaySummary();
    if (step === '5') renderDescCards();
    if (step === '7') { renderPreview(); sizeCanvas(); }
    renderRail(step);
    if (STEP_EVENTS[step]) {
      track(STEP_EVENTS[step], { checkout_step: parseInt(step, 10), currency: 'ARS', value: total() });
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ── Errores inline ──────────────────────────────────────
  function setErrEl(el: HTMLElement | null, msg: string) {
    if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
  }
  function setErr(key: string, msg: string) {
    setErrEl(document.querySelector<HTMLElement>(`[data-err="${key}"]`), msg);
  }
  function clearErrs(keys: string[]) { keys.forEach(k => setErr(k, '')); }

  // ── Validación por paso ─────────────────────────────────
  // Con FIELDS_OPTIONAL, los campos vacíos pasan; el formato se valida
  // solo cuando el usuario cargó algo.
  function validateStep1(): boolean {
    clearErrs(['marca']);
    // Filas vacías de más: se descartan en silencio al continuar (el usuario
    // agregó una marca y se arrepintió). Siempre queda al menos una.
    if (!pedidoBloqueado && marcas.length > 1) {
      const conNombre = marcas.filter(m => m.nombre.trim());
      if (conNombre.length && conNombre.length !== marcas.length) {
        setMarcas(conNombre);
        renderMarcasStep1();
      }
    }
    if (FIELDS_OPTIONAL) return true;

    if (marcas.some(m => m.nombre.trim().length < 2)) {
      setErr('marca', marcas.length > 1
        ? 'Completá el nombre de todas tus marcas (o quitá las que sobren).'
        : 'Ingresá el nombre de tu marca.');
      return false;
    }
    // La clave incluye el tipo: la misma denominación como denominativa y como
    // mixta son dos solicitudes distintas, no un duplicado.
    const claves = marcas.map(m => `${m.nombre.trim().toLowerCase()}|${m.tipo}`);
    if (new Set(claves).size !== claves.length) {
      setErr('marca', 'Repetiste una marca con el mismo tipo. Si querés registrarla en más clases, sumalas en el paso 3.');
      return false;
    }
    return true;
  }

  function validatePedido(): boolean {
    clearErrs(['clase']);
    if (FIELDS_OPTIONAL) return true;
    const sinClases = marcas.filter(m => m.clases.length === 0);
    if (sinClases.length) {
      setErr('clase', marcas.length > 1
        ? `Elegí al menos una clase para ${sinClases.map(m => `“${m.nombre.trim().toUpperCase()}”`).join(' y ')}.`
        : 'Seleccioná al menos una clase para tu marca.');
      return false;
    }
    return true;
  }

  function validateContacto(): boolean {
    clearErrs(['email', 'whatsapp']);
    let ok = true;

    const email = input('ck-email').value.trim();
    if (email || !FIELDS_OPTIONAL) {
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('email', 'Ingresá un email válido.'); ok = false; }
    }

    const wa = input('ck-whatsapp').value.replace(/\D/g, '');
    if (wa || !FIELDS_OPTIONAL) {
      if (wa.length < 10) { setErr('whatsapp', 'Ingresá un número de WhatsApp válido (con código de área).'); ok = false; }
    }

    return ok;
  }

  /** Paso 5 (fase B, 1/3): lo que describe a la marca. Una tarjeta por marca. */
  function validateMarcaDetalle(): boolean {
    let ok = true;
    let primerError: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>('#ck-desc-cards .ck-dcard').forEach((card, i) => {
      const m = marcas[i];
      if (!m) return;
      const errDesc = card.querySelector<HTMLElement>('.ck-desc-err')!;
      const errSitio = card.querySelector<HTMLElement>('.ck-sitio-err')!;
      setErrEl(errDesc, '');
      setErrEl(errSitio, '');

      const descripcion = m.descripcion.trim();
      if ((descripcion || !FIELDS_OPTIONAL) && descripcion.length < MIN_DESCRIPCION) {
        setErrEl(errDesc, `Contanos un poco más: mínimo ${MIN_DESCRIPCION} caracteres (llevás ${descripcion.length}).`);
        primerError = primerError || card;
        ok = false;
      }

      const sitioWeb = m.sitioWeb.trim();
      if (sitioWeb && !/^(https?:\/\/)?([\w-]+\.)+[\w-]{2,}(\/\S*)?$/i.test(sitioWeb)) {
        setErrEl(errSitio, 'Ingresá una dirección web válida (ej: https://tumarca.com).');
        primerError = primerError || card;
        ok = false;
      }

      // Logo, medidas y colores: obligatorios en mixta y figurativa
      if (!requiereLogo(m.tipo)) return;
      const errLogo = card.querySelector<HTMLElement>('.ck-logo-err')!;
      const errMedidas = card.querySelector<HTMLElement>('.ck-medidas-err')!;
      const errColores = card.querySelector<HTMLElement>('.ck-colores-err')!;
      const errConfirm = card.querySelector<HTMLElement>('.ck-confirm-err')!;
      [errLogo, errMedidas, errColores, errConfirm].forEach(el => setErrEl(el, ''));
      if (FIELDS_OPTIONAL) return;

      const fallo = (el: HTMLElement, msg: string) => {
        setErrEl(el, msg);
        primerError = primerError || card;
        ok = false;
      };
      if (!m.logoBlob && !m.logoKey) {
        fallo(errLogo, 'Subí la imagen de tu marca.');
      }
      // Las medidas no se muestran: las derivamos de la imagen. Si por lo que
      // sea faltan, se completan con el cuadrado por defecto en vez de frenar
      // al cliente con un error que no puede resolver.
      if (m.alto === null || m.ancho === null) {
        const med = m.logoPx
          ? medidasDesdePx(m.logoPx.ancho, m.logoPx.alto)
          : { alto: LOGO_CM_LADO_MAYOR, ancho: LOGO_CM_LADO_MAYOR };
        m.alto = med.alto;
        m.ancho = med.ancho;
        saveDraft();
      }
      if (!m.colores.trim()) {
        fallo(errColores, 'Escribí los colores de la imagen. Si es en blanco y negro, poné “Blanco y negro”.');
      }
      if (m.tipo === 'mixta' && !m.confirmaTexto) {
        fallo(errConfirm, 'Confirmá que la denominación coincide con el texto de la imagen.');
      }
    });
    if (primerError) {
      // La tarjeta puede estar plegada: un error escondido no se puede corregir
      (primerError as HTMLDetailsElement).open = true;
      (primerError as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    return ok;
  }

  /** Paso 6 (fase B, 2/3): identidad y domicilio del titular. */
  function validateTitular(): boolean {
    const keys = ['nombre', 'apellido', 'docnum', 'cuit', 'genero', 'estadocivil', 'conyuge', 'calle', 'numero', 'localidad', 'codpostal', 'provincia'];
    clearErrs(keys);
    let ok = true;

    const req = (id: string, key: string, msg: string) => {
      if (!FIELDS_OPTIONAL && !input(id).value.trim()) { setErr(key, msg); ok = false; }
    };
    req('ck-nombre', 'nombre', 'Ingresá tu nombre.');
    req('ck-apellido', 'apellido', 'Ingresá tu apellido.');
    req('ck-genero', 'genero', 'Seleccioná el género.');
    req('ck-estadocivil', 'estadocivil', 'Seleccioná el estado civil.');
    if (input('ck-estadocivil').value === 'Casado/a') {
      req('ck-conyuge', 'conyuge', 'Ingresá el nombre del cónyuge.');
    }

    const tipoDoc = input('ck-tipodoc').value;
    const doc = input('ck-docnum').value.trim();
    if (tipoDoc === 'DNI') {
      const digits = doc.replace(/\D/g, '');
      if (doc || !FIELDS_OPTIONAL) {
        if (digits.length < 7 || digits.length > 8) { setErr('docnum', 'Ingresá un DNI válido (7 u 8 dígitos).'); ok = false; }
      }
    } else {
      req('ck-docnum', 'docnum', 'Ingresá el número de documento.');
    }

    const cuit = input('ck-cuit').value;
    if (cuit || !FIELDS_OPTIONAL) {
      if (!isValidCuit(cuit)) {
        setErr('cuit', 'El CUIT/CUIL no es válido. Revisalo.'); ok = false;
      } else if (tipoDoc === 'DNI' && doc && !cuitMatchesDni(cuit, doc)) {
        setErr('cuit', 'El CUIT/CUIL no coincide con el DNI ingresado.'); ok = false;
      }
    }

    req('ck-calle', 'calle', 'Ingresá la calle.');
    req('ck-numero', 'numero', 'Ingresá el número.');
    req('ck-localidad', 'localidad', 'Ingresá la localidad.');
    req('ck-codpostal', 'codpostal', 'Ingresá el código postal.');
    req('ck-provincia', 'provincia', 'Seleccioná la provincia.');

    return ok;
  }

  /** Lleva la vista al primer campo en rojo del paso visible. Sin esto, tocar
   *  "Continuar" en una pantalla larga con el error fuera de cuadro se ve como
   *  que el botón no hace nada. */
  function scrollAlPrimerError() {
    const paso = document.querySelector<HTMLElement>('.ck-step:not([hidden])');
    const err = Array.from(paso?.querySelectorAll<HTMLElement>('.ck-err') ?? [])
      .find(el => el.style.display === 'block' && el.textContent?.trim());
    if (!err) return;
    // Si el campo quedó dentro de una tarjeta plegada, se abre antes de ir
    err.closest('details')?.setAttribute('open', '');
    (err.closest('.ck-field') ?? err).scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Cónyuge: visible solo si el estado civil es Casado/a
  function syncConyuge() {
    $('ck-conyuge-row').hidden = input('ck-estadocivil').value !== 'Casado/a';
  }
  input('ck-estadocivil').addEventListener('change', syncConyuge);

  // País: oculto mientras sea Argentina, que es el caso de casi todos. Si un
  // draft trae otro país, el campo aparece solo.
  function syncPais() {
    const otro = input('ck-pais').value.trim().toLowerCase() !== 'argentina';
    $('ck-pais-row').hidden = !otro;
    $('ck-pais-toggle').hidden = otro;
  }
  $('ck-pais-toggle').addEventListener('click', () => {
    $('ck-pais-row').hidden = false;
    $('ck-pais-toggle').hidden = true;
    input('ck-pais').select();
    input('ck-pais').focus();
  });

  // ── Paso 1: filas de marca ──────────────────────────────
  /** Normaliza el estado y repinta todo lo que depende de la lista de marcas. */
  function setMarcas(lista: MarcaState[], save = true) {
    const limpias = lista.slice(0, MAX_MARCAS).map(m => ({
      ...nuevaMarca(String(m.nombre ?? '').slice(0, 120), normalizeTipoMarca(m.tipo)),
      clases: [...new Set((m.clases ?? []).filter(n => Number.isInteger(n) && n >= 1 && n <= 45))]
        .sort((a, b) => a - b)
        .slice(0, MAX_CLASES),
      descripcion: String(m.descripcion ?? ''),
      sitioWeb: String(m.sitioWeb ?? ''),
      colores: String(m.colores ?? ''),
      alto: typeof m.alto === 'number' ? m.alto : null,
      ancho: typeof m.ancho === 'number' ? m.ancho : null,
      confirmaTexto: m.confirmaTexto === true,
      logoKey: m.logoKey ?? null,
      logoBlob: m.logoBlob ?? null,
      logoUrl: m.logoUrl ?? null,
      logoNombre: m.logoNombre ?? '',
      logoPx: m.logoPx ?? null,
    }));
    marcas = limpias.length ? limpias : [nuevaMarca()];
    renderMarcasStep1();
    updateSummary();
    if (save) saveDraft();
  }

  /** Etiqueta del campo nombre según el tipo. En una figurativa no es la
   *  denominación (no tiene): es la referencia con la que identificamos el
   *  pedido, y el INPI nunca la ve. */
  function labelNombre(tipo: TipoMarca, i: number, varias: boolean): string {
    if (!tieneDenominacion(tipo)) {
      return varias ? `Marca ${i + 1} — referencia` : 'Nombre de referencia';
    }
    return varias ? `Marca ${i + 1}` : 'Nombre de la marca';
  }

  /** La figurativa no lleva denominación ante el INPI, así que no tiene sentido
   *  pedirle un nombre al cliente: se lo asignamos y el campo queda de solo
   *  lectura. Lleva número para que dos figurativas del mismo pedido no choquen
   *  con el control de duplicados. */
  const nombreFigurativa = (i: number) => `Marca figurativa ${i + 1}`;
  const esNombreFigurativaAuto = (s: string) => /^marca figurativa \d+$/i.test(s.trim());

  function renderMarcasStep1() {
    const cont = $('ck-marcas');
    const molde = tpl('ck-marca-row-tpl');
    cont.innerHTML = '';
    const varias = marcas.length > 1;

    marcas.forEach((m, i) => {
      const row = (molde.content.firstElementChild!.cloneNode(true) as HTMLElement);
      const label = row.querySelector<HTMLLabelElement>('.ck-marca-label')!;
      const inp = row.querySelector<HTMLInputElement>('input[type="text"]')!;
      const rm = row.querySelector<HTMLButtonElement>('.ck-marca-rm')!;
      const nombreHelp = row.querySelector<HTMLElement>('.ck-marca-nombre-help')!;
      const tipoLabel = row.querySelector<HTMLLabelElement>('.ck-tipo-label')!;
      const sel = row.querySelector<HTMLSelectElement>('.ck-tipo-sel')!;

      inp.id = `ck-marca-${i}`;
      label.setAttribute('for', inp.id);
      sel.id = `ck-tipo-marca-${i}`;
      tipoLabel.setAttribute('for', sel.id);

      // El campo de nombre depende del tipo elegido: se repinta sin re-render
      // para no perder el foco mientras el usuario escribe.
      const pintarPorTipo = () => {
        const conDenominacion = tieneDenominacion(m.tipo);
        label.innerHTML = `${labelNombre(m.tipo, i, varias)} <em>*</em>`;
        inp.placeholder = conDenominacion
          ? (i === 0 ? 'UnaMarca' : 'Nombre de la otra marca')
          : '';
        nombreHelp.textContent = conDenominacion
          ? ''
          : 'La marca figurativa se presenta sin texto: este nombre es solo nuestra referencia interna.';
        nombreHelp.hidden = conDenominacion;
        // Figurativa: el nombre lo ponemos nosotros y no se edita
        inp.readOnly = !conDenominacion;
        if (!conDenominacion) {
          m.nombre = nombreFigurativa(i);
          inp.value = m.nombre;
        }
      };

      inp.maxLength = 120;
      inp.value = m.nombre;
      inp.disabled = pedidoBloqueado;
      inp.addEventListener('input', () => {
        m.nombre = inp.value;
        setErr('marca', '');
        saveDraft();
      });

      sel.value = m.tipo;
      sel.disabled = pedidoBloqueado;
      sel.parentElement!.classList.toggle('ck-sel--locked', pedidoBloqueado);
      sel.addEventListener('change', () => {
        m.tipo = normalizeTipoMarca(sel.value);
        // Cambiar de tipo invalida lo que se cargó para el tipo anterior
        if (!requiereLogo(m.tipo)) {
          liberarLogo(m);
          m.colores = '';
          m.alto = null;
          m.ancho = null;
        }
        // Al salir de figurativa el nombre que pusimos nosotros no sirve como
        // denominación: se limpia para que el cliente escriba la suya.
        if (tieneDenominacion(m.tipo) && esNombreFigurativaAuto(m.nombre)) {
          m.nombre = '';
          inp.value = '';
        }
        m.confirmaTexto = false;
        pintarPorTipo();
        setErr('marca', '');
        saveDraft();
      });

      rm.hidden = !varias || pedidoBloqueado;
      rm.setAttribute('aria-label', `Quitar la marca ${i + 1}`);
      rm.addEventListener('click', () => {
        liberarLogo(marcas[i]);
        setMarcas(marcas.filter((_, j) => j !== i));
        setErr('marca', '');
      });

      pintarPorTipo();
      cont.append(row);
    });

    $('ck-add-marca').hidden = pedidoBloqueado || marcas.length >= MAX_MARCAS;
    $('ck-marca-max').hidden = pedidoBloqueado || marcas.length < MAX_MARCAS;
    $('ck-marca-help').hidden = !varias;
    $('ck-marcas-section-label').textContent = varias ? 'Tus marcas' : 'Tu marca';

    // El título del paso 1 cambia de singular a plural con la lista
    const paso1 = document.querySelector<HTMLElement>('.ck-step[data-step="1"]');
    if (paso1 && !paso1.hidden) $('ck-step-title').textContent = stepTitle('1');
  }

  $('ck-add-marca').addEventListener('click', () => {
    if (marcas.length >= MAX_MARCAS) return;
    marcas.push(nuevaMarca());
    setMarcas(marcas);
    (document.getElementById(`ck-marca-${marcas.length - 1}`) as HTMLInputElement | null)?.focus();
  });

  // ── Paso 3: un selector de clases por marca ─────────────
  function normalize(s: string): string {
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  /** Refresca chips, label y subtotal de cada tarjeta ya montada */
  let refreshCards: () => void = () => {};

  function renderClasesCards() {
    const cont = $('ck-clases-cards');
    const molde = tpl('ck-clase-card-tpl');
    cont.innerHTML = '';
    const updaters: (() => void)[] = [];
    const varias = marcas.length > 1;

    marcas.forEach((m, i) => {
      const card = (molde.content.firstElementChild!.cloneNode(true) as HTMLElement);
      const nameEl = card.querySelector<HTMLElement>('.ck-mcard-name')!;
      const subEl = card.querySelector<HTMLElement>('.ck-mcard-sub')!;
      const btn = card.querySelector<HTMLButtonElement>('.ck-dd-btn')!;
      const panel = card.querySelector<HTMLElement>('.ck-dd-panel')!;
      const search = card.querySelector<HTMLInputElement>('.ck-dd-search')!;
      const labelEl = card.querySelector<HTMLElement>('.ck-dd-label')!;
      const chips = card.querySelector<HTMLElement>('.ck-chips')!;
      const detalle = card.querySelector<HTMLElement>('.ck-clase-det')!;
      const detSum = detalle.querySelector<HTMLElement>('summary')!;
      const detBody = detalle.querySelector<HTMLElement>('.ck-clase-det-body')!;
      const maxHelp = card.querySelector<HTMLElement>('.ck-clase-max')!;
      const opts = Array.from(card.querySelectorAll<HTMLElement>('.ck-dd-opt'));

      nameEl.textContent = m.nombre.trim().toUpperCase() || `Marca ${i + 1}`;
      card.classList.toggle('ck-mcard--multi', varias);
      btn.disabled = pedidoBloqueado;

      const toggleClase = (num: number) => {
        if (pedidoBloqueado) return;
        if (m.clases.includes(num)) {
          m.clases = m.clases.filter(n => n !== num);
        } else if (m.clases.length >= MAX_CLASES) {
          maxHelp.hidden = false;
          return;
        } else {
          m.clases = [...m.clases, num].sort((a, b) => a - b);
        }
        setErr('clase', '');
        refreshCards();
        updateSummary();
        saveDraft();
      };

      const update = () => {
        // Label del botón
        if (m.clases.length === 0) {
          labelEl.textContent = 'Seleccioná una o más clases…';
          labelEl.classList.add('ck-dd-placeholder');
        } else if (m.clases.length === 1) {
          const c = NIZA_CLASSES.find(x => x.num === m.clases[0]);
          labelEl.textContent = c ? `Clase ${c.num} — ${c.nombre}` : `Clase ${m.clases[0]}`;
          labelEl.classList.remove('ck-dd-placeholder');
        } else {
          labelEl.textContent = clasesTexto(m.clases);
          labelEl.classList.remove('ck-dd-placeholder');
        }

        // Chips con botón de quitar. Llevan el nombre de la clase, no solo el
        // número: "Clase 43" a secas no le dice nada a nadie tres pantallas
        // después, y es lo que el cliente está comprando.
        chips.innerHTML = '';
        m.clases.forEach(num => {
          const c = NIZA_CLASSES.find(x => x.num === num);
          const chip = document.createElement('span');
          chip.className = 'ck-chip';
          const n = document.createElement('b');
          n.textContent = `Clase ${num}`;
          chip.append(n);
          if (c) {
            const nom = document.createElement('span');
            nom.textContent = c.nombre;
            chip.append(nom);
          }
          if (!pedidoBloqueado) {
            const rm = document.createElement('button');
            rm.type = 'button';
            rm.setAttribute('aria-label', `Quitar la clase ${num}`);
            rm.textContent = '×';
            rm.addEventListener('click', () => toggleClase(num));
            chip.append(rm);
          }
          chips.append(chip);
        });
        chips.hidden = m.clases.length === 0;
        maxHelp.hidden = m.clases.length < MAX_CLASES;

        // Encabezado oficial de Niza de cada clase elegida: es lo que realmente
        // queda protegido, pero es un párrafo por clase. Va plegado.
        detalle.hidden = m.clases.length === 0;
        if (m.clases.length) {
          detSum.textContent = m.clases.length === 1
            ? 'Ver qué cubre exactamente esta clase'
            : 'Ver qué cubre exactamente cada clase';
          detBody.innerHTML = '';
          m.clases.forEach(num => {
            const c = NIZA_CLASSES.find(x => x.num === num);
            if (!c) return;
            const bloque = document.createElement('div');
            bloque.className = 'ck-clase-det-item';
            const t = document.createElement('b');
            t.textContent = `Clase ${c.num} · ${c.nombre}`;
            const p = document.createElement('p');
            p.textContent = c.textoOficial;
            bloque.append(t, p);
            detBody.append(bloque);
          });
        }

        // Subtotal por marca: solo tiene sentido con varias
        subEl.hidden = !varias;
        subEl.textContent = varias ? formatARS(subtotalMarca(m)) : '';

        opts.forEach(opt => {
          opt.classList.toggle('selected', m.clases.includes(parseInt(opt.dataset.num || '', 10)));
        });
      };

      const filtrar = (q: string) => {
        const nq = normalize(q);
        opts.forEach(opt => {
          // Busca en el nombre corto Y en el encabezado oficial completo
          const text = normalize(`${opt.textContent || ''} ${opt.dataset.extra || ''}`);
          (opt.parentElement as HTMLElement).hidden = nq !== '' && !text.includes(nq);
        });
      };

      btn.addEventListener('click', () => {
        const show = panel.hidden;
        cerrarPaneles();
        panel.hidden = !show;
        btn.setAttribute('aria-expanded', String(show));
        if (show) { search.value = ''; filtrar(''); search.focus(); }
      });
      search.addEventListener('input', () => filtrar(search.value));
      // El panel queda abierto al elegir: es una selección múltiple
      opts.forEach(opt => opt.addEventListener('click', () => toggleClase(parseInt(opt.dataset.num || '', 10))));

      update();
      updaters.push(update);
      cont.append(card);
    });

    refreshCards = () => updaters.forEach(u => u());
    $('ck-clases-section-label').textContent = varias
      ? 'Elegí las clases de cada marca'
      : 'Elegí tu clase';
  }

  function cerrarPaneles(excepto?: Element | null) {
    document.querySelectorAll<HTMLElement>('#ck-clases-cards .ck-dd').forEach(dd => {
      if (dd === excepto) return;
      const panel = dd.querySelector<HTMLElement>('.ck-dd-panel')!;
      if (!panel.hidden) {
        panel.hidden = true;
        dd.querySelector('.ck-dd-btn')!.setAttribute('aria-expanded', 'false');
      }
    });
  }

  document.addEventListener('click', (e) => {
    cerrarPaneles((e.target as HTMLElement).closest?.('.ck-dd'));
  });

  // ── Garantía (upsell) y resumen ─────────────────────────
  // La garantía aparece en "Qué incluye" solo cuando está contratada. Antes
  // había además una línea roja permanente ("sin garantía de devolución…")
  // empujando el upsell desde adentro de la lista de beneficios: era el único
  // elemento en rojo de la pantalla y leía como un problema, no como una oferta.
  const FEAT_GARANTIA =
    'Garantía de Devolución: si el INPI deniega el registro en una clase, te devolvemos los honorarios de esa clase';

  /** Líneas del pedido: una marca en una clase. Antes de elegir clases el
   *  resumen muestra la base de 1 línea. */
  function lineas(): number {
    return contarLineas(marcas);
  }
  function pricing() {
    return computeOrderPricing(lineas() || 1, garantia);
  }
  function total(): number {
    return pricing().total;
  }
  /** Cuánto sale una marca sola, con sus clases (0 clases = $0) */
  function subtotalMarca(m: MarcaState): number {
    const unidad = PRICING.honorarios + PRICING.arancelInpi + (garantia ? PRICING.garantia : 0);
    return unidad * m.clases.length;
  }

  function renderSummaryMarcas() {
    const cont = $('ck-sum-marcas');
    cont.innerHTML = '';
    if (marcas.length < 2) { cont.hidden = true; return; }
    marcas.forEach((m, i) => {
      const row = document.createElement('div');
      row.className = 'ck-sum-row ck-sum-marca';
      const left = document.createElement('span');
      left.innerHTML =
        `<b>${(m.nombre.trim().toUpperCase() || `Marca ${i + 1}`).replace(/</g, '&lt;')}</b>` +
        ` <small>${clasesTexto(m.clases, 'sin clase')}</small>`;
      const right = document.createElement('span');
      right.textContent = formatARS(subtotalMarca(m));
      row.append(left, right);
      cont.append(row);
    });
    cont.hidden = false;
  }

  function updateSummary() {
    const p = pricing();
    const nLabel = lineasTexto(p.lineas, marcas.length);

    $('ck-upsell-price').textContent = `+${formatARS(PRICING.garantia * p.lineas)}`;

    const feat = $('ck-feat-garantia');
    feat.textContent = FEAT_GARANTIA;
    feat.hidden = !garantia;

    renderSummaryMarcas();
    $('ck-sum-hon-label').textContent = `Honorarios — Registro de marca (${nLabel})`;
    $('ck-sum-hon').textContent = formatARS(p.honorarios);
    $('ck-sum-garantia-row').hidden = !garantia;
    $('ck-sum-gar-label').textContent = `Garantía de Devolución (${nLabel})`;
    $('ck-sum-gar').textContent = formatARS(garantia ? p.garantia : PRICING.garantia * p.lineas);
    $('ck-sum-ara-label').innerHTML =
      `Arancel INPI (${nLabel}) <small>se paga al INPI · valor ${PRICING.arancelVigencia}</small>`;
    $('ck-sum-ara').textContent = formatARS(p.arancelInpi);
    $('ck-sum-total').textContent = formatARS(p.total);
    updateRail();
  }

  input('ck-garantia').addEventListener('change', () => {
    garantia = input('ck-garantia').checked;
    updateSummary();
    refreshCards(); // los subtotales por marca incluyen la garantía
    saveDraft();
  });

  // ── Resumen persistente (rail) ──────────────────────────
  // Se ve desde que hay un precio (paso 3) hasta la firma. Es la única fuente
  // del total: los resúmenes dentro de los pasos 3 y 4 se ocultan por CSS
  // cuando el rail está a la vista.
  const RAIL_STEPS = ['3', '4', '5', '6', '7'];

  function renderRail(step: string) {
    const rail = $('ck-rail');
    const wrap = document.querySelector<HTMLElement>('.ck-wrap')!;
    const ver = RAIL_STEPS.includes(step);
    rail.hidden = !ver;
    wrap.classList.toggle('ck-wrap--rail', ver);
    document.body.classList.toggle('ck-has-rail', ver);
    if (ver) updateRail();
  }

  function updateRail() {
    if ($('ck-rail').hidden) return;
    const p = pricing();
    const nLabel = lineasTexto(p.lineas, marcas.length);

    const cont = $('ck-rail-marcas');
    cont.innerHTML = '';
    marcas.forEach((m, i) => {
      const fila = document.createElement('div');
      fila.className = 'ck-rail-marca';
      const nombre = document.createElement('b');
      nombre.textContent = m.nombre.trim().toUpperCase() || `MARCA ${i + 1}`;
      const clases = document.createElement('span');
      clases.textContent = clasesTexto(m.clases, 'sin clase');
      fila.append(nombre, clases);
      cont.append(fila);
    });

    const filas: [string, string][] = [[`Honorarios (${nLabel})`, formatARS(p.honorarios)]];
    if (garantia) filas.push([`Garantía de Devolución (${nLabel})`, formatARS(p.garantia)]);
    filas.push([`Arancel INPI (${nLabel})`, formatARS(p.arancelInpi)]);

    const rowsEl = $('ck-rail-rows');
    rowsEl.innerHTML = '';
    filas.forEach(([k, v]) => {
      const row = document.createElement('div');
      row.className = 'ck-rail-row';
      const ks = document.createElement('span'); ks.textContent = k;
      const vs = document.createElement('span'); vs.textContent = v;
      row.append(ks, vs);
      rowsEl.append(row);
    });

    const totalTxt = formatARS(p.total);
    $('ck-rail-total').textContent = totalTxt;
    $('ck-rail-bar-total').textContent = totalTxt;

    // Con pedido creado el resumen deja de ser un precio a decidir y pasa a ser
    // el comprobante de lo que se compró.
    const nota = $('ck-rail-note');
    nota.hidden = !orderRef;
    if (orderRef) {
      nota.textContent = metodoPago === 'transferencia'
        ? `Pedido ${orderRef} · falta tu transferencia`
        : `Pedido ${orderRef} · pago recibido`;
    }
  }

  $('ck-rail-toggle').addEventListener('click', () => {
    const abierto = $('ck-rail').classList.toggle('ck-rail--open');
    $('ck-rail-toggle').setAttribute('aria-expanded', String(abierto));
  });

  function updatePaySummary() {
    const cont = $('ck-pay-marcas');
    cont.innerHTML = '';
    marcas.forEach((m, i) => {
      const linea = document.createElement('div');
      linea.className = 'ck-pay-marca';
      const nombre = document.createElement('b');
      nombre.textContent = m.nombre.trim().toUpperCase() || `MARCA ${i + 1}`;
      const detalle = document.createElement('span');
      detalle.textContent = ` · ${clasesTexto(m.clases)}`;
      linea.append(nombre, detalle);
      cont.append(linea);
    });
    $('ck-pay-plan').textContent =
      (marcas.length > 1 ? `Registro de ${marcas.length} marcas` : 'Registro de marca') +
      (garantia ? ' + Garantía de Devolución' : '');
    $('ck-pay-total').textContent = formatARS(total());
  }

  // ── Logo de la marca: normalización y medidas (paso 5) ──
  // El INPI acepta JPG y pide ALTO y ANCHO en cm. Las medidas son una
  // declaración del tamaño de publicación, no una medición del archivo: lo
  // único que tiene que ser cierto es la proporción del signo.

  function liberarLogo(m?: MarcaState) {
    if (!m) return;
    if (m.logoUrl) URL.revokeObjectURL(m.logoUrl);
    m.logoBlob = null;
    m.logoUrl = null;
    m.logoNombre = '';
    m.logoPx = null;
    m.logoKey = null;
  }

  function cargarImagen(url: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error('no se pudo leer la imagen'));
      img.src = url;
    });
  }

  /** Caja del contenido no transparente, en coordenadas de la imagen original.
   *  Solo se usa en PNG: es el único formato con alfa que aceptamos, y el
   *  margen vacío falsearía la proporción declarada. Los JPG no se recortan
   *  (un fondo de color puede ser parte del signo). */
  function cajaOpaca(img: HTMLImageElement, w: number, h: number) {
    const escala = Math.min(1, 1200 / Math.max(w, h));
    const sw = Math.max(1, Math.round(w * escala));
    const sh = Math.max(1, Math.round(h * escala));
    const c = document.createElement('canvas');
    c.width = sw; c.height = sh;
    const cx = c.getContext('2d', { willReadFrequently: true })!;
    cx.drawImage(img, 0, 0, sw, sh);
    let datos: Uint8ClampedArray;
    try {
      datos = cx.getImageData(0, 0, sw, sh).data;
    } catch {
      return null; // canvas contaminado: seguimos con la imagen entera
    }

    let minX = sw, minY = sh, maxX = -1, maxY = -1;
    for (let y = 0; y < sh; y++) {
      for (let x = 0; x < sw; x++) {
        if (datos[(y * sw + x) * 4 + 3] > 8) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (maxX < 0) return null; // imagen 100% transparente

    return {
      x: minX / escala,
      y: minY / escala,
      w: (maxX - minX + 1) / escala,
      h: (maxY - minY + 1) / escala,
    };
  }

  /** Convierte lo que haya elegido el cliente al JPG que sube al INPI:
   *  recorta la transparencia (PNG), aplana sobre blanco — el JPG no tiene
   *  canal alfa, sin fondo lo transparente saldría negro — y limita el lado
   *  mayor, con lo que el peso deja de importar sin rechazarle nada a nadie. */
  async function normalizarLogo(file: File): Promise<{ blob: Blob; ancho: number; alto: number }> {
    const url = URL.createObjectURL(file);
    try {
      const img = await cargarImagen(url);
      const w = img.naturalWidth;
      const h = img.naturalHeight;
      if (!w || !h) throw new Error('imagen sin dimensiones');

      const caja = (file.type === 'image/png' ? cajaOpaca(img, w, h) : null)
        ?? { x: 0, y: 0, w, h };

      const escala = Math.min(1, LOGO_MAX_PX / Math.max(caja.w, caja.h));
      const outW = Math.max(1, Math.round(caja.w * escala));
      const outH = Math.max(1, Math.round(caja.h * escala));

      const canvas = document.createElement('canvas');
      canvas.width = outW;
      canvas.height = outH;
      const cx = canvas.getContext('2d')!;
      cx.fillStyle = '#ffffff';
      cx.fillRect(0, 0, outW, outH);
      cx.drawImage(img, caja.x, caja.y, caja.w, caja.h, 0, 0, outW, outH);

      const blob = await new Promise<Blob | null>(
        r => canvas.toBlob(r, 'image/jpeg', LOGO_JPEG_QUALITY),
      );
      if (!blob) throw new Error('no se pudo generar el JPG');
      return { blob, ancho: outW, alto: outH };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  // ── Descripción por marca (paso 5) ──────────────────────
  const MIN_DESCRIPCION = 100;

  /** Arranque editable armado con las clases que el cliente eligió. No se
   *  autocompleta: lo inserta él con "Partir de un ejemplo" y después lo edita.
   *  Prellenar sin pedirlo mandaría al INPI la misma descripción genérica en
   *  todos los pedidos, que es peor que un textarea vacío.
   *
   *  Es SOLO una afirmación cierta sobre la marca, nunca una instrucción al
   *  cliente: lo que quede acá se guarda tal cual y termina en la solicitud. Una
   *  versión anterior cerraba con "Detallá acá qué vendés…", que superaba el
   *  mínimo de caracteres y entraba sin editar — se vio en el portal en la
   *  primera prueba real. El coaching va en la ayuda del campo, no en el valor. */
  function sugerenciaDescripcion(m: MarcaState): string {
    const nombre = m.nombre.trim().toUpperCase() || 'La marca';
    const rubros = m.clases
      .map(n => NIZA_CLASSES.find(c => c.num === n)?.nombre.toLowerCase())
      .filter(Boolean) as string[];
    const lista = rubros.length > 1
      ? `${rubros.slice(0, -1).join('; ')} y ${rubros[rubros.length - 1]}`
      : (rubros[0] ?? 'los productos y servicios de la marca');
    return `${nombre} ofrece productos y servicios de ${lista}.`;
  }

  function renderDescCards() {
    const cont = $('ck-desc-cards');
    const molde = tpl('ck-desc-card-tpl');
    const varias = marcas.length > 1;
    cont.innerHTML = '';

    marcas.forEach((m, i) => {
      const card = (molde.content.firstElementChild!.cloneNode(true) as HTMLElement);
      const nameEl = card.querySelector<HTMLElement>('.ck-dcard-name')!;
      const subEl = card.querySelector<HTMLElement>('.ck-dcard-sub')!;
      const labelEl = card.querySelector<HTMLElement>('.ck-desc-label')!;
      const area = card.querySelector<HTMLTextAreaElement>('.ck-desc')!;
      const help = card.querySelector<HTMLElement>('.ck-desc-help')!;
      const sitio = card.querySelector<HTMLInputElement>('.ck-sitio')!;

      const nombre = m.nombre.trim();
      // El título identifica la tarjeta cuando está plegada
      nameEl.textContent = nombre.toUpperCase() || `Marca ${i + 1}`;
      subEl.textContent = `${tipoMarcaLabel(m.tipo)} · ${clasesTexto(m.clases, 'sin clase')}`;
      labelEl.textContent = nombre ? `Descripción de ${nombre}` : 'Descripción de tu marca';
      area.id = `ck-descripcion-${i}`;
      card.querySelector('label')!.setAttribute('for', area.id);
      area.value = m.descripcion;
      sitio.id = `ck-sitioweb-${i}`;
      card.querySelectorAll('label')[1].setAttribute('for', sitio.id);
      sitio.value = m.sitioWeb;

      const sug = card.querySelector<HTMLButtonElement>('.ck-desc-sug')!;

      const updateHelp = () => {
        const len = area.value.trim().length;
        // El atajo solo tiene sentido con el campo en blanco
        sug.hidden = len > 0;
        if (len === 0) {
          help.textContent = `Mínimo ${MIN_DESCRIPCION} caracteres.`;
          help.style.color = '';
        } else if (len < MIN_DESCRIPCION) {
          help.textContent = `Mínimo ${MIN_DESCRIPCION} caracteres · faltan ${MIN_DESCRIPCION - len}.`;
          help.style.color = '';
        } else {
          help.textContent = `${len} caracteres ✓`;
          help.style.color = '#16a34a';
        }
      };

      area.addEventListener('input', () => {
        m.descripcion = area.value;
        setErrEl(card.querySelector<HTMLElement>('.ck-desc-err'), '');
        updateHelp();
        saveDraft();
      });

      sug.addEventListener('click', () => {
        area.value = sugerenciaDescripcion(m);
        area.dispatchEvent(new Event('input'));
        area.focus();
        // El cursor al final, listo para editar
        area.setSelectionRange(area.value.length, area.value.length);
      });
      sitio.addEventListener('input', () => {
        m.sitioWeb = sitio.value;
        setErrEl(card.querySelector<HTMLElement>('.ck-sitio-err'), '');
        saveDraft();
      });

      updateHelp();
      montarLogo(card, m, i);
      cont.append(card);
    });
  }

  /** Bloque de imagen dentro de la tarjeta del paso 5. Solo mixtas y
   *  figurativas; en denominativa queda oculto. */
  function montarLogo(card: HTMLElement, m: MarcaState, i: number) {
    const bloque = card.querySelector<HTMLElement>('.ck-logo')!;
    if (!requiereLogo(m.tipo)) { bloque.hidden = true; return; }
    bloque.hidden = false;

    const file = card.querySelector<HTMLInputElement>('.ck-logo-file')!;
    const drop = card.querySelector<HTMLElement>('.ck-drop')!;
    const prev = card.querySelector<HTMLElement>('.ck-logo-preview')!;
    const img = card.querySelector<HTMLImageElement>('.ck-logo-img')!;
    const meta = card.querySelector<HTMLElement>('.ck-logo-meta')!;
    const otra = card.querySelector<HTMLButtonElement>('.ck-logo-otra')!;
    const alto = card.querySelector<HTMLInputElement>('.ck-logo-alto')!;
    const ancho = card.querySelector<HTMLInputElement>('.ck-logo-ancho')!;
    const colores = card.querySelector<HTMLInputElement>('.ck-colores')!;
    const confirmWrap = card.querySelector<HTMLElement>('.ck-logo-confirm')!;
    const confirmChk = card.querySelector<HTMLInputElement>('.ck-logo-ok')!;
    const confirmTxt = card.querySelector<HTMLElement>('.ck-logo-ok-txt')!;
    const errLogo = card.querySelector<HTMLElement>('.ck-logo-err')!;
    const errMedidas = card.querySelector<HTMLElement>('.ck-medidas-err')!;
    const errColores = card.querySelector<HTMLElement>('.ck-colores-err')!;
    const errConfirm = card.querySelector<HTMLElement>('.ck-confirm-err')!;

    file.id = `ck-logo-${i}`;
    alto.id = `ck-logo-alto-${i}`;
    ancho.id = `ck-logo-ancho-${i}`;
    colores.id = `ck-colores-${i}`;
    bloque.querySelectorAll('label').forEach(l => {
      const campo = l.parentElement?.querySelector('input');
      if (campo?.id && !l.classList.contains('ck-terms')) l.setAttribute('for', campo.id);
    });

    const pintarPreview = () => {
      const hayImagen = !!(m.logoUrl || m.logoKey);
      // Con imagen cargada el dropzone deja lugar a la vista previa
      drop.hidden = hayImagen;
      if (m.logoUrl) {
        img.src = m.logoUrl;
        img.hidden = false;
        prev.hidden = false;
        const px = m.logoPx;
        meta.textContent = px
          ? `${m.logoNombre || 'imagen'} · JPG de ${px.ancho}×${px.alto} px`
          : `${m.logoNombre || 'imagen'} · JPG`;
      } else if (m.logoKey) {
        // Draft recuperado: el archivo ya está guardado, no hace falta resubirlo
        img.hidden = true;
        prev.hidden = false;
        meta.textContent = 'Imagen ya cargada ✓';
      } else {
        prev.hidden = true;
      }
    };

    const procesar = async (elegido: File | undefined) => {
      if (!elegido) return;
      setErrEl(errLogo, '');
      drop.hidden = true;
      prev.hidden = false;
      img.hidden = true;
      meta.textContent = 'Procesando la imagen…';
      try {
        const out = await normalizarLogo(elegido);
        liberarLogo(m);
        m.logoBlob = out.blob;
        m.logoUrl = URL.createObjectURL(out.blob);
        m.logoNombre = elegido.name;
        m.logoPx = { ancho: out.ancho, alto: out.alto };
        // Medidas nuevas: la imagen cambió, la proporción anterior ya no vale
        const med = medidasDesdePx(out.ancho, out.alto);
        m.alto = med.alto;
        m.ancho = med.ancho;
        alto.value = formatCm(m.alto);
        ancho.value = formatCm(m.ancho);
        setErrEl(errMedidas, '');
        pintarPreview();
        saveDraft();
      } catch (e) {
        console.error('[um-checkout] error procesando el logo:', e);
        liberarLogo(m);
        prev.hidden = true;
        pintarPreview();
        setErrEl(errLogo, 'No pudimos leer esa imagen. Probá con otro archivo JPG, PNG o WebP.');
      }
    };

    file.addEventListener('change', () => procesar(file.files?.[0]));

    // Dropzone: click, teclado y arrastrar-y-soltar sobre el mismo bloque
    drop.addEventListener('click', () => file.click());
    drop.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); file.click(); }
    });
    ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('ck-drop--over');
    }));
    ['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.remove('ck-drop--over');
    }));
    drop.addEventListener('drop', (e) => {
      procesar((e as DragEvent).dataTransfer?.files?.[0]);
    });
    otra.addEventListener('click', () => file.click());

    // El teclado en es-AR da coma; el INPI usa punto. Se acepta cualquiera y al
    // salir del campo se muestra ya normalizado, que es lo que se va a enviar.
    const medida = (el: HTMLInputElement, campo: 'alto' | 'ancho') => {
      el.value = formatCm(m[campo]);
      el.addEventListener('input', () => {
        m[campo] = parseCm(el.value);
        setErrEl(errMedidas, '');
          saveDraft();
      });
      el.addEventListener('blur', () => {
        if (m[campo] !== null) el.value = formatCm(m[campo]);
      });
    };
    medida(alto, 'alto');
    medida(ancho, 'ancho');

    colores.value = m.colores;
    colores.addEventListener('input', () => {
      m.colores = colores.value;
      setErrEl(errColores, '');
      saveDraft();
    });

    // La confirmación es solo de la mixta: es el tipo donde la denominación
    // tiene que transcribir todo el texto de la imagen.
    const esMixta = m.tipo === 'mixta';
    confirmWrap.hidden = !esMixta;
    errConfirm.hidden = !esMixta;
    if (esMixta) {
      const denom = m.nombre.trim().toUpperCase();
      confirmTxt.textContent = denom
        ? `Confirmo que “${denom}” es exactamente todo el texto que aparece en la imagen.`
        : 'Confirmo que la denominación es exactamente todo el texto que aparece en la imagen.';
      confirmChk.checked = m.confirmaTexto;
      confirmChk.addEventListener('change', () => {
        m.confirmaTexto = confirmChk.checked;
        setErrEl(errConfirm, '');
        saveDraft();
      });
    }

    pintarPreview();
  }

  // ── Pago: Mercado Pago o transferencia ──────────────────
  const mpBtn = document.getElementById('ck-mp-btn') as HTMLButtonElement;
  const trBtn = document.getElementById('ck-tr-btn') as HTMLButtonElement;
  const skipBtn = document.getElementById('ck-skip-pay') as HTMLButtonElement;

  interface OrderResponse {
    ref: string;
    metodo?: MetodoPago;
    init_point?: string;
    importe?: number;
  }

  function orderBody() {
    return JSON.stringify({
      marcas: marcas.map(m => ({ nombre: m.nombre.trim(), tipo: m.tipo, clases: m.clases })),
      contacto: {
        email: input('ck-email').value.trim(),
        whatsapp: input('ck-whatsapp').value.trim(),
      },
      garantia,
      metodo: metodoPago,
    });
  }

  async function createOrder(): Promise<OrderResponse> {
    const res = await fetch('/api/checkout/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: orderBody(),
    });
    const data = await res.json();
    if (!res.ok || !data.ref) throw new Error(data.error || 'error creando pedido');
    bloquearPedido();
    return data;
  }

  /** Con el pedido creado, marcas y clases quedan de solo lectura: el importe
   *  ya está fijado y lo que se presenta ante el INPI tiene que coincidir. */
  function bloquearPedido() {
    if (pedidoBloqueado) return;
    pedidoBloqueado = true;
    const aviso =
      'Tu pedido ya está generado, así que las marcas y las clases quedaron fijas. ' +
      '¿Te falta agregar algo? Escribinos por WhatsApp y lo resolvemos.';
    [$('ck-lock-marcas'), $('ck-lock-clases')].forEach(el => {
      el.textContent = aviso;
      el.hidden = false;
    });
    renderMarcasStep1();
    renderClasesCards();
  }

  mpBtn.addEventListener('click', async () => {
    setErr('pago', '');
    metodoPago = 'mercadopago';
    mpBtn.disabled = true;
    $('ck-mp-label').textContent = 'Redirigiendo a Mercado Pago…';
    track('add_payment_info', { currency: 'ARS', value: total(), metodo: 'mercadopago' });
    try {
      const data = await createOrder();
      orderRef = data.ref;
      saveDraft(); // por si vuelve en el mismo navegador
      window.location.href = data.init_point!;
    } catch (e) {
      console.error('[um-checkout] error iniciando pago:', e);
      track('ck_pago_error', { motivo: String(e).slice(0, 100) }, false);
      setErr('pago', 'No pudimos iniciar el pago. Probá de nuevo en unos segundos.');
      mpBtn.disabled = false;
      $('ck-mp-label').textContent = 'Pagar con Mercado Pago';
    }
  });

  // Transferencia: no hay redirect ni webhook. Se crea el pedido
  // (pending_transfer), se muestran los datos de la cuenta y el usuario sigue
  // completando la solicitud en la misma sesión. La acreditación se concilia a
  // mano contra el N° de pedido que el cliente manda con el comprobante.
  function showTransferPanel(ref: string, importe: number) {
    $('ck-tr-importe').textContent = formatARS(importe);
    $('ck-tr-ref').textContent = ref;
    const wa = $('ck-tr-wa') as HTMLAnchorElement;
    wa.href = waHrefComprobante(ref);
    const resume = $('ck-tr-resume') as HTMLAnchorElement;
    const resumeUrl = `${window.location.origin}/registrar?order=${encodeURIComponent(ref)}`;
    resume.href = resumeUrl;
    resume.textContent = resumeUrl;
    $('ck-pay-methods').hidden = true;
    $('ck-pay-note').hidden = true;
    $('ck-transfer').hidden = false;
  }

  trBtn.addEventListener('click', async () => {
    setErr('pago', '');
    metodoPago = 'transferencia';
    trBtn.disabled = true;
    $('ck-tr-label').textContent = 'Generando tu pedido…';
    track('add_payment_info', { currency: 'ARS', value: total(), metodo: 'transferencia' });
    track('ck_pago_transferencia', { currency: 'ARS', value: total() });
    try {
      const data = await createOrder();
      orderRef = data.ref;
      saveDraft();
      showTransferPanel(data.ref, data.importe ?? total());
    } catch (e) {
      console.error('[um-checkout] error creando pedido por transferencia:', e);
      track('ck_pago_error', { motivo: String(e).slice(0, 100) }, false);
      setErr('pago', 'No pudimos generar tu pedido. Probá de nuevo en unos segundos.');
      metodoPago = 'mercadopago';
    } finally {
      trBtn.disabled = false;
      $('ck-tr-label').textContent = 'Pagar por transferencia';
    }
  });

  $('ck-tr-next').addEventListener('click', () => {
    showPayBanner('pending_transfer');
    goTo('5');
  });

  // Volver al selector: el pedido ya creado se reusa si vuelve a transferencia,
  // y queda huérfano (pending_transfer, sin completar) si termina pagando por MP.
  $('ck-tr-otro').addEventListener('click', () => {
    $('ck-transfer').hidden = true;
    $('ck-pay-methods').hidden = false;
    $('ck-pay-note').hidden = false;
    metodoPago = 'mercadopago';
  });

  // Copiar alias / N° de pedido
  document.querySelectorAll<HTMLButtonElement>('.ck-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const REFS: Record<string, string> = { 'ck-copy-ref': 'ck-tr-ref', 'ck-copy-done': 'ck-ref' };
      const value = btn.dataset.copy
        ?? (REFS[btn.id] ? $(REFS[btn.id]).textContent || '' : '');
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const prev = btn.textContent;
        btn.textContent = '¡Copiado!';
        btn.classList.add('ck-copy--ok');
        setTimeout(() => { btn.textContent = prev; btn.classList.remove('ck-copy--ok'); }, 1600);
      } catch { /* sin permiso de clipboard: el dato está a la vista igual */ }
    });
  });

  // Saltar pago (demo): solo visible en previews y localhost — nunca en el
  // dominio real. Crea el pedido igual (queda pending_payment) para que el
  // pipeline completo —PDF + emails— funcione también sin pagar.
  const isDemoEnv = window.location.hostname === 'localhost'
    || (window.location.hostname.endsWith('.pages.dev') && window.location.hostname !== 'unamarca.pages.dev');
  if (isDemoEnv) skipBtn.hidden = false;

  skipBtn.addEventListener('click', async () => {
    skipBtn.disabled = true;
    if (!orderRef) {
      try {
        const data = await createOrder();
        orderRef = data.ref;
      } catch (e) {
        console.warn('[um-checkout] demo sin pedido (¿API no disponible?):', e);
      }
    }
    skipBtn.disabled = false;
    goTo('5');
  });

  function showPayBanner(status: string) {
    const banner = $('ck-pay-banner');
    const kind =
      status === 'paid' ? 'ok' :
      status === 'rejected' ? 'err' : 'warn';
    // La transferencia se paga desde el home banking, casi siempre después de
    // completar la solicitud: el alias tiene que volver a estar acá, no solo
    // en el paso 4 donde el usuario ya no vuelve.
    const transferMsg =
      `<b>Falta tu transferencia de ${formatARS(total())}.</b> Alias ` +
      `<b>${TRANSFERENCIA.alias}</b> (${TRANSFERENCIA.titular}, ${TRANSFERENCIA.banco}). ` +
      `Pedido <b>${orderRef ?? ''}</b>. Seguí completando tus datos: presentamos ` +
      `ante el INPI cuando se acredite.`;
    const msg =
      status === 'pending_transfer'
        ? transferMsg
        : status === 'paid'
          ? '<b>✓ Pago aprobado.</b> Recibimos tu pago. Completá los datos para terminar tu solicitud.'
          : status === 'rejected'
            ? '<b>El pago fue rechazado.</b> Podés <button type="button" class="ck-banner-link" id="ck-retry-pay">reintentar el pago</button> o continuar y lo coordinamos después.'
            : '<b>Tu pago está pendiente de confirmación.</b> Podés completar tus datos mientras tanto; te avisamos por email cuando se acredite.';
    banner.className = `ck-banner ck-banner--${kind}`;
    banner.innerHTML = msg;
    banner.hidden = false;
    document.getElementById('ck-retry-pay')?.addEventListener('click', () => goTo('4'));
  }

  async function resumeOrder(ref: string) {
    try {
      const res = await fetch(`/api/checkout/order/${encodeURIComponent(ref)}`);
      if (!res.ok) return false;
      const o = await res.json();
      orderRef = o.ref;
      const p = o.payload || {};
      if (p.metodo === 'transferencia') metodoPago = 'transferencia';

      // De dónde sale lo que el cliente ya había cargado del post-pago: gana la
      // copia más nueva. La local se escribe en cada tecla y suele ir adelante;
      // la del servidor es la que salva el caso que motivó todo esto —otro
      // dispositivo, o el storage borrado— y también el de empezar en el celular
      // y seguir en la compu, donde lo local está viejo. Un draft sin `at` es
      // anterior a que existiera el guardado en servidor: pierde siempre.
      const draftLocal = leerDraft();
      const cuando = (x: any) => Date.parse(x?.at ?? '') || 0;
      const fuente = cuando(draftLocal) >= cuando(o.progreso)
        ? (draftLocal || o.progreso || null)
        : o.progreso;

      // Titular y contacto: solo desde la fuente elegida y sin pisar con vacío
      if (fuente?.values) {
        FIELD_IDS.forEach(id => {
          const v = String(fuente.values[id] ?? '').trim();
          if (v) input(id).value = fuente.values[id];
        });
        syncConyuge();
        syncPais();
      }

      const draftPrevio = marcasDesdeDraft(fuente);
      const delPedido = marcasDelPedido(p);
      if (delPedido.length) {
        setMarcas(delPedido.map((m, i) => {
          const previo = draftPrevio[i];
          const mismo = previo?.nombre.trim().toLowerCase() === m.nombre.trim().toLowerCase();
          if (!mismo) return m;
          return {
            ...m,
            descripcion: previo.descripcion,
            sitioWeb: previo.sitioWeb,
            // El logo en sí no sobrevive al draft (es un Blob), pero sí lo que
            // el cliente escribió alrededor y la key si ya se subió.
            colores: previo.colores,
            alto: previo.alto,
            ancho: previo.ancho,
            confirmaTexto: previo.confirmaTexto,
            logoKey: m.logoKey ?? previo.logoKey,
          };
        }), false);
      }
      bloquearPedido();
      if (p.contacto?.email) input('ck-email').value = p.contacto.email;
      if (p.contacto?.whatsapp) input('ck-whatsapp').value = p.contacto.whatsapp;
      garantia = !!p.garantia;
      input('ck-garantia').checked = garantia;
      updateSummary();
      // Nombre por estado (ck_pago_retorno_paid / _rejected / _pending_transfer…)
      // para que el desglose se vea en GA4 sin dimensiones personalizadas.
      track(`ck_pago_retorno_${String(o.status).replace(/[^a-z0-9]/gi, '_')}`);
      showPayBanner(o.status);
      goTo('5');
      return true;
    } catch {
      return false;
    }
  }

  // ── Carta poder: preview ────────────────────────────────
  function cpData(): CartaPoderData {
    const now = new Date();
    return {
      nombreApellido: `${input('ck-nombre').value.trim()} ${input('ck-apellido').value.trim()}`.trim(),
      docTipo: input('ck-tipodoc').value || 'DNI',
      docNumero: input('ck-docnum').value.trim(),
      cuit: input('ck-cuit').value.trim(),
      calle: input('ck-calle').value.trim(),
      numero: input('ck-numero').value.trim(),
      piso: input('ck-piso').value.trim() || undefined,
      depto: input('ck-depto').value.trim() || undefined,
      codigoPostal: input('ck-codpostal').value.trim(),
      localidad: input('ck-localidad').value.trim(),
      provincia: input('ck-provincia').value,
      marcas: marcas.map(m => ({ nombre: m.nombre, tipo: m.tipo, clases: [...m.clases] })),
      fecha: { dia: now.getDate(), mes: now.getMonth(), anio: now.getFullYear() },
    };
  }

  function renderPreview() {
    $('ck-cp-preview').innerHTML = cartaPoderHTML(cpData());
  }

  $('ck-edit-datos').addEventListener('click', () => goTo('6'));

  // ── Firma (canvas) ──────────────────────────────────────
  const canvas = document.getElementById('ck-sig') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const SIG_H = 210;
  let strokes: { x: number; y: number }[][] = [];
  let drawing = false;

  function sizeCanvas() {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.parentElement!.getBoundingClientRect().width;
    if (w === 0) return; // paso oculto
    canvas.width = w * dpr;
    canvas.height = SIG_H * dpr;
    canvas.style.width = `${w}px`;
    canvas.style.height = `${SIG_H}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    redraw();
  }

  function redraw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = '#0f172a';
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    strokes.forEach(stroke => {
      ctx.beginPath();
      stroke.forEach((p, i) => (i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y)));
      ctx.stroke();
    });
  }

  function sigPos(e: PointerEvent) {
    const r = canvas.getBoundingClientRect();
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  canvas.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    canvas.setPointerCapture(e.pointerId);
    drawing = true;
    strokes.push([sigPos(e)]);
    $('ck-sig-hint').hidden = true;
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return;
    const stroke = strokes[strokes.length - 1];
    stroke.push(sigPos(e));
    const [a, b] = [stroke[stroke.length - 2], stroke[stroke.length - 1]];
    ctx.strokeStyle = '#0f172a';
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
  });
  const endStroke = () => { drawing = false; syncSigUI(); };
  canvas.addEventListener('pointerup', endStroke);
  canvas.addEventListener('pointercancel', endStroke);
  window.addEventListener('resize', sizeCanvas);

  /** Deshacer un trazo evita tener que rehacer toda la firma por un temblor,
   *  que es lo único que se podía hacer antes. */
  function syncSigUI() {
    $('ck-sig-undo').hidden = strokes.length === 0;
    $('ck-sig-hint').hidden = strokes.length > 0;
    updateSubmitState();
  }

  $('ck-sig-undo').addEventListener('click', () => {
    strokes.pop();
    redraw();
    syncSigUI();
  });

  $('ck-sig-clear').addEventListener('click', () => {
    strokes = [];
    redraw();
    syncSigUI();
  });

  // ── Envío ───────────────────────────────────────────────
  const requiereAlgunLogo = () => marcas.some(m => requiereLogo(m.tipo));

  /** Sube los logos que todavía no están en el servidor, de a uno: el endpoint
   *  hace read-modify-write del payload y en paralelo se pisarían.
   *  Devuelve true si alguno quedó sin subir — el pedido se envía igual (el
   *  cliente ya pagó) y la confirmación le avisa que se lo vamos a pedir. */
  async function subirLogos(ref: string): Promise<boolean> {
    let pendiente = false;
    for (let i = 0; i < marcas.length; i++) {
      const m = marcas[i];
      if (!requiereLogo(m.tipo)) continue;
      if (m.logoKey && !m.logoBlob) continue; // ya está guardado
      if (!m.logoBlob) { pendiente = true; continue; }
      try {
        const res = await fetch(`/api/checkout/order/${encodeURIComponent(ref)}/logo?i=${i}`, {
          method: 'POST',
          headers: { 'Content-Type': 'image/jpeg' },
          body: m.logoBlob,
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        m.logoKey = data.logoKey || null;
        saveDraft();
      } catch (e) {
        console.error(`[um-checkout] no se pudo subir el logo de la marca ${i + 1}:`, e);
        track('ck_logo_upload_error', { motivo: String(e).slice(0, 100) }, false);
        pendiente = true;
      }
    }
    return pendiente;
  }

  const submitBtn = document.getElementById('ck-submit') as HTMLButtonElement;
  const termsCheck = input('ck-terms');

  function updateSubmitState() {
    submitBtn.disabled = strokes.length === 0 || !termsCheck.checked;
  }
  termsCheck.addEventListener('change', updateSubmitState);

  submitBtn.addEventListener('click', async () => {
    submitBtn.disabled = true;
    $('ck-submit-label').textContent = 'Enviando…';
    $('ck-submit-spin').style.display = '';

    // Los logos van primero y de a uno: el endpoint hace read-modify-write del
    // payload del pedido, y en paralelo se pisarían entre sí.
    const logosPendientes = orderRef ? await subirLogos(orderRef) : requiereAlgunLogo();

    const payload = {
      marcas: marcas.map(m => ({
        nombre: m.nombre.trim(),
        tipo: m.tipo,
        clases: m.clases,
        descripcion: m.descripcion.trim(),
        sitioWeb: m.sitioWeb.trim(),
        ...(requiereLogo(m.tipo) ? {
          colores: m.colores.trim(),
          alto: m.alto,
          ancho: m.ancho,
        } : {}),
      })),
      titular: {
        tipoPersona: 'Humana',
        nombre: input('ck-nombre').value.trim(),
        apellido: input('ck-apellido').value.trim(),
        genero: input('ck-genero').value,
        estadoCivil: input('ck-estadocivil').value,
        nombreConyuge: input('ck-estadocivil').value === 'Casado/a'
          ? input('ck-conyuge').value.trim() : '',
        documento: {
          tipo: input('ck-tipodoc').value || 'DNI',
          numero: input('ck-docnum').value.trim(),
        },
        cuit: input('ck-cuit').value.trim(),
        domicilio: {
          pais: input('ck-pais').value.trim() || 'Argentina',
          calle: input('ck-calle').value.trim(),
          numero: input('ck-numero').value.trim(),
          piso: input('ck-piso').value.trim(),
          depto: input('ck-depto').value.trim(),
          localidad: input('ck-localidad').value.trim(),
          codigoPostal: input('ck-codpostal').value.trim(),
          provincia: input('ck-provincia').value,
        },
      },
      contacto: {
        email: input('ck-email').value.trim(),
        whatsapp: input('ck-whatsapp').value.trim(),
      },
      garantia,
      pricing: pricing(),
      // El estado real del pago vive en D1 (status del pedido); acá solo queda
      // registrado el medio que eligió el usuario.
      payment: { provider: metodoPago },
      firma: canvas.toDataURL('image/png'),
    };

    // Con pedido: generar el PDF de la carta poder EN EL NAVEGADOR (el plan
    // free de Pages Functions no tiene CPU para pdf-lib) y adjuntarlo al
    // pedido en D1 — el backend lo manda por email (cliente + admin).
    let ref: string;
    if (orderRef) {
      let cartaPdfBase64: string | null = null;
      try {
        const { buildCartaPoderPdf } = await import('../lib/checkout/cartaPoderPdf');
        const pdfBytes = await buildCartaPoderPdf(cpData(), payload.firma);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < pdfBytes.length; i += chunk) {
          binary += String.fromCharCode(...pdfBytes.subarray(i, i + chunk));
        }
        cartaPdfBase64 = btoa(binary);
      } catch (e) {
        console.error('[um-checkout] error generando PDF (se envía sin adjunto):', e);
      }

      try {
        const res = await fetch(`/api/checkout/order/${encodeURIComponent(orderRef)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, cartaPdfBase64 }),
        });
        if (!res.ok) throw new Error(String(res.status));
      } catch (e) {
        console.error('[um-checkout] error guardando la solicitud:', e);
        alert('No pudimos guardar tu solicitud. Probá de nuevo.');
        submitBtn.disabled = false;
        $('ck-submit-label').textContent = 'Confirmar y enviar solicitud';
        $('ck-submit-spin').style.display = 'none';
        return;
      }
      ref = orderRef;
    } else {
      console.info('[um-checkout] payload (demo, sin pedido MP):', payload);
      await new Promise(r => setTimeout(r, 900));
      const now = new Date();
      const ymd = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
      ref = `UM-${ymd}-${String(Math.floor(Math.random() * 10000)).padStart(4, '0')}`;
    }

    // Conversión: GA4 (importable a Google Ads) + Meta Pixel
    try {
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'purchase', {
          transaction_id: ref,
          value: payload.pricing.total,
          currency: 'ARS',
          items: marcas.map(m => ({
            item_name: 'Registro de marca',
            item_variant: garantia ? 'con_garantia' : 'sin_garantia',
            quantity: m.clases.length || 1,
          })),
        });
      }
      if (typeof w.fbq === 'function') {
        w.fbq('track', 'Purchase', { value: payload.pricing.total, currency: 'ARS' });
      }
    } catch { /* analytics nunca bloquea la confirmación */ }

    $('ck-ref').textContent = ref;
    if (orderRef) {
      $('ck-done-email').textContent = payload.contacto.email || 'tu email';
    } else {
      $('ck-done-mail').textContent = 'Modo demo (sin pago): no se envían emails.';
    }

    const varias = marcas.length > 1;
    const queCosa = varias ? `tus <b>${marcas.length} solicitudes</b>` : 'tu solicitud';
    if (varias) $('ck-done-title').textContent = '¡Listo! Recibimos tus solicitudes.';

    // Primer paso de la línea de tiempo: con transferencia el reloj no arranca
    // hasta que se acredita, y decirlo acá evita el reclamo a las 48 horas.
    $('ck-tl-presenta').innerHTML = metodoPago === 'transferencia'
      ? `Presentamos ${queCosa} dentro de las <b>48 horas hábiles</b> desde que se acredite tu transferencia.`
      : `Presentamos ${queCosa} dentro de las próximas <b>48 horas hábiles</b>. Te avisamos por email cuando esté ingresada.`;

    // Transferencia: el pago casi nunca está hecho a esta altura. Último
    // recordatorio con el alias y el link para mandar el comprobante.
    if (metodoPago === 'transferencia') {
      $('ck-done-importe').textContent = formatARS(payload.pricing.total);
      ($('ck-done-wa') as HTMLAnchorElement).href = waHrefComprobante(ref);
      $('ck-done-transfer').hidden = false;
    }

    $('ck-done-logo').hidden = !logosPendientes;
    // La tarjeta de pendientes solo existe si hay alguno
    $('ck-done-extra').hidden = metodoPago !== 'transferencia' && !logosPendientes;

    localStorage.removeItem(DRAFT_KEY);
    goTo('done');
  });

  // ── Inputs: formato y draft ─────────────────────────────
  input('ck-cuit').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    el.value = formatCuitInput(el.value);
  });
  input('ck-docnum').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (input('ck-tipodoc').value === 'DNI') {
      el.value = el.value.replace(/\D/g, '').slice(0, 8);
    }
  });
  FIELD_IDS.forEach(id => input(id).addEventListener('input', () => {
    setErr(id.replace('ck-', ''), ''); // al corregir, el error desaparece
    saveDraft();
  }));

  // ── Botones Continuar / Volver ──────────────────────────
  const VALIDATORS: Record<string, () => boolean> = {
    '1': validateStep1, '2': validateContacto, '3': validatePedido,
    '5': validateMarcaDetalle, '6': validateTitular,
  };

  document.querySelectorAll<HTMLElement>('[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      const from = btn.dataset.next!;
      const validator = VALIDATORS[from];
      if (validator && !validator()) { scrollAlPrimerError(); return; }
      // Cada pantalla completada de la fase B se sube sin esperar al debounce:
      // es el momento en que más datos nuevos hay para perder.
      void enviarProgreso();
      goTo(String(parseInt(from, 10) + 1));
    });
  });
  document.querySelectorAll<HTMLElement>('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => goTo(btn.dataset.back!));
  });

  // ── Render inicial ──────────────────────────────────────
  // El paso 1 arranca vacío en el HTML: la primera fila la pinta el script.
  renderMarcasStep1();
  updateSummary();

  // ── Bootstrap: volver de Mercado Pago (?order=REF) o draft local ─────
  const urlParams = new URLSearchParams(window.location.search);
  const urlOrderRef = urlParams.get('order');
  if (urlOrderRef) {
    resumeOrder(urlOrderRef).then(ok => { if (!ok) restoreDraft(); });
  } else {
    restoreDraft();
    // Prefill desde /verificar-marca, campañas y otros proyectos. Los tres
    // parámetros repetibles (marca, clase, tipo) se aparean POR POSICIÓN:
    //   ?marca=X&clase=9,25                        → una marca (legado)
    //   ?marca=A&clase=2,3&marca=B&clase=4,6       → varias
    //   ?marca=A&clase=25&tipo=mixta               → con tipo de marca
    // `tipo` acepta denominativa | mixta | figurativa, sin distinguir mayúsculas.
    // Cualquier otro valor cae en denominativa, que es el caso por defecto y el
    // único que no necesita que el cliente suba una imagen después.
    const urlMarcas = urlParams.getAll('marca').map(s => s.trim().slice(0, 80));
    const urlClases = urlParams.getAll('clase').map(v => v
      .split(',')
      .map(s => parseInt(s, 10))
      .filter(n => n >= 1 && n <= 45));
    const urlTipos = urlParams.getAll('tipo').map(s => s.trim());
    const urlTel = (urlParams.get('tel') || '').trim().slice(0, 30);
    const urlEmail = (urlParams.get('email') || '').trim().slice(0, 120);

    const nDeep = Math.min(
      MAX_MARCAS,
      Math.max(urlMarcas.length, urlClases.length, urlTipos.length),
    );
    if (nDeep > 0) {
      // En una figurativa el nombre que venga por URL se descarta: la marca
      // figurativa no tiene denominación ante el INPI y la referencia interna
      // la asigna renderMarcasStep1(), igual que cuando el tipo se elige a mano.
      setMarcas(
        Array.from({ length: nDeep }, (_, i) => nuevaMarcaCon(urlMarcas[i], urlClases[i], urlTipos[i])),
        false,
      );
    }
    if (urlTel) input('ck-whatsapp').value = urlTel;
    if (urlEmail) input('ck-email').value = urlEmail;
    if (nDeep > 0 || urlTel || urlEmail) saveDraft();
  }
</script>

