  input('ck-garantia').addEventListener('change', () => {
    garantia = input('ck-garantia').checked;
    updateSummary();
    refreshCards(); // los subtotales por marca incluyen la garantía
    saveDraft();
  });

  function updatePaySummary() {
    const cont = $('ck-pay-marcas');
    cont.innerHTML = '';
    marcas.forEach((m, i) => {
      const linea = document.createElement('div');
      linea.className = 'ck-pay-marca';
      const nombre = document.createElement('b');
      nombre.textContent = m.nombre.trim().toUpperCase() || `MARCA ${i + 1}`;
      const detalle = document.createElement('span');
      detalle.textContent = ` · ${clasesTexto(m.clases)}`;
      linea.append(nombre, detalle);
      cont.append(linea);
    });
    $('ck-pay-plan').textContent =
      (marcas.length > 1 ? `Registro de ${marcas.length} marcas` : 'Registro de marca') +
      (garantia ? ' + Garantía de Devolución' : '');
    $('ck-pay-total').textContent = formatARS(total());
  }

  // ── Logo de la marca: normalización y medidas (paso 5) ──
  // El INPI acepta JPG y pide ALTO y ANCHO en cm. Las medidas son una
  // declaración del tamaño de publicación, no una medición del archivo: lo
  // único que tiene que ser cierto es la proporción del signo.

  function liberarLogo(m?: MarcaState) {
    if (!m) return;
    if (m.logoUrl) URL.revokeObjectURL(m.logoUrl);
    m.logoBlob = null;
    m.logoUrl = null;
    m.logoNombre = '';
    m.logoPx = null;
    m.logoKey = null;
  }

  function cargarImagen(url: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error('no se pudo leer la imagen'));
      img.src = url;
    });
  }

  /** Caja del contenido no transparente, en coordenadas de la imagen original.
   *  Solo se usa en PNG: es el único formato con alfa que aceptamos, y el
   *  margen vacío falsearía la proporción declarada. Los JPG no se recortan
   *  (un fondo de color puede ser parte del signo). */
  function cajaOpaca(img: HTMLImageElement, w: number, h: number) {
    const escala = Math.min(1, 1200 / Math.max(w, h));
    const sw = Math.max(1, Math.round(w * escala));
    const sh = Math.max(1, Math.round(h * escala));
    const c = document.createElement('canvas');
    c.width = sw; c.height = sh;
    const cx = c.getContext('2d', { willReadFrequently: true })!;
    cx.drawImage(img, 0, 0, sw, sh);
    let datos: Uint8ClampedArray;
    try {
      datos = cx.getImageData(0, 0, sw, sh).data;
    } catch {
      return null; // canvas contaminado: seguimos con la imagen entera
    }

    let minX = sw, minY = sh, maxX = -1, maxY = -1;
    for (let y = 0; y < sh; y++) {
      for (let x = 0; x < sw; x++) {
        if (datos[(y * sw + x) * 4 + 3] > 8) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (maxX < 0) return null; // imagen 100% transparente

    return {
      x: minX / escala,
      y: minY / escala,
      w: (maxX - minX + 1) / escala,
      h: (maxY - minY + 1) / escala,
    };
  }

  /** Convierte lo que haya elegido el cliente al JPG que sube al INPI:
   *  recorta la transparencia (PNG), aplana sobre blanco — el JPG no tiene
   *  canal alfa, sin fondo lo transparente saldría negro — y limita el lado
   *  mayor, con lo que el peso deja de importar sin rechazarle nada a nadie. */
  async function normalizarLogo(file: File): Promise<{ blob: Blob; ancho: number; alto: number }> {
    const url = URL.createObjectURL(file);
    try {
      const img = await cargarImagen(url);
      const w = img.naturalWidth;
      const h = img.naturalHeight;
      if (!w || !h) throw new Error('imagen sin dimensiones');

      const caja = (file.type === 'image/png' ? cajaOpaca(img, w, h) : null)
        ?? { x: 0, y: 0, w, h };

      const escala = Math.min(1, LOGO_MAX_PX / Math.max(caja.w, caja.h));
      const outW = Math.max(1, Math.round(caja.w * escala));
      const outH = Math.max(1, Math.round(caja.h * escala));

      const canvas = document.createElement('canvas');
      canvas.width = outW;
      canvas.height = outH;
      const cx = canvas.getContext('2d')!;
      cx.fillStyle = '#ffffff';
      cx.fillRect(0, 0, outW, outH);
      cx.drawImage(img, caja.x, caja.y, caja.w, caja.h, 0, 0, outW, outH);

      const blob = await new Promise<Blob | null>(
        r => canvas.toBlob(r, 'image/jpeg', LOGO_JPEG_QUALITY),
      );
      if (!blob) throw new Error('no se pudo generar el JPG');
      return { blob, ancho: outW, alto: outH };
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  // ── Descripción por marca (paso 5) ──────────────────────
  const MIN_DESCRIPCION = 100;

  function renderDescCards() {
    const cont = $('ck-desc-cards');
    const molde = tpl('ck-desc-card-tpl');
    const varias = marcas.length > 1;
    cont.innerHTML = '';
    $('ck-desc-section-label').textContent = varias ? 'Sobre tus marcas' : 'Sobre tu marca';

    marcas.forEach((m, i) => {
      const card = (molde.content.firstElementChild!.cloneNode(true) as HTMLElement);
      const nameEl = card.querySelector<HTMLElement>('.ck-dcard-name')!;
      const labelEl = card.querySelector<HTMLElement>('.ck-desc-label')!;
      const area = card.querySelector<HTMLTextAreaElement>('.ck-desc')!;
      const help = card.querySelector<HTMLElement>('.ck-desc-help')!;
      const sitio = card.querySelector<HTMLInputElement>('.ck-sitio')!;

      const nombre = m.nombre.trim();
      nameEl.textContent = nombre.toUpperCase() || `Marca ${i + 1}`;
      nameEl.hidden = !varias;
      labelEl.textContent = nombre ? `Descripción de ${nombre}` : 'Descripción de tu marca';
      area.id = `ck-descripcion-${i}`;
      card.querySelector('label')!.setAttribute('for', area.id);
      area.value = m.descripcion;
      sitio.id = `ck-sitioweb-${i}`;
      card.querySelectorAll('label')[1].setAttribute('for', sitio.id);
      sitio.value = m.sitioWeb;

      const updateHelp = () => {
        const len = area.value.trim().length;
        if (len === 0) {
          help.textContent = `Mínimo ${MIN_DESCRIPCION} caracteres.`;
          help.style.color = '';
        } else if (len < MIN_DESCRIPCION) {
          help.textContent = `Mínimo ${MIN_DESCRIPCION} caracteres · faltan ${MIN_DESCRIPCION - len}.`;
          help.style.color = '';
        } else {
          help.textContent = `${len} caracteres ✓`;
          help.style.color = '#16a34a';
        }
      };

      area.addEventListener('input', () => {
        m.descripcion = area.value;
        setErrEl(card.querySelector<HTMLElement>('.ck-desc-err'), '');
        updateHelp();
        saveDraft();
      });
      sitio.addEventListener('input', () => {
        m.sitioWeb = sitio.value;
        setErrEl(card.querySelector<HTMLElement>('.ck-sitio-err'), '');
        saveDraft();
      });

      updateHelp();
      montarLogo(card, m, i);
      cont.append(card);
    });
  }

  /** Bloque de imagen dentro de la tarjeta del paso 5. Solo mixtas y
   *  figurativas; en denominativa queda oculto. */
  function montarLogo(card: HTMLElement, m: MarcaState, i: number) {
    const bloque = card.querySelector<HTMLElement>('.ck-logo')!;
    if (!requiereLogo(m.tipo)) { bloque.hidden = true; return; }
    bloque.hidden = false;

    const file = card.querySelector<HTMLInputElement>('.ck-logo-file')!;
    const prev = card.querySelector<HTMLElement>('.ck-logo-preview')!;
    const img = card.querySelector<HTMLImageElement>('.ck-logo-img')!;
    const meta = card.querySelector<HTMLElement>('.ck-logo-meta')!;
    const alto = card.querySelector<HTMLInputElement>('.ck-logo-alto')!;
    const ancho = card.querySelector<HTMLInputElement>('.ck-logo-ancho')!;
    const colores = card.querySelector<HTMLInputElement>('.ck-colores')!;
    const confirmWrap = card.querySelector<HTMLElement>('.ck-logo-confirm')!;
    const confirmChk = card.querySelector<HTMLInputElement>('.ck-logo-ok')!;
    const confirmTxt = card.querySelector<HTMLElement>('.ck-logo-ok-txt')!;
    const errLogo = card.querySelector<HTMLElement>('.ck-logo-err')!;
    const errMedidas = card.querySelector<HTMLElement>('.ck-medidas-err')!;
    const errColores = card.querySelector<HTMLElement>('.ck-colores-err')!;
    const errConfirm = card.querySelector<HTMLElement>('.ck-confirm-err')!;

    file.id = `ck-logo-${i}`;
    alto.id = `ck-logo-alto-${i}`;
    ancho.id = `ck-logo-ancho-${i}`;
    colores.id = `ck-colores-${i}`;
    bloque.querySelectorAll('label').forEach(l => {
      const campo = l.parentElement?.querySelector('input');
      if (campo?.id && !l.classList.contains('ck-terms')) l.setAttribute('for', campo.id);
    });

    const pintarPreview = () => {
      if (m.logoUrl) {
        img.src = m.logoUrl;
        img.hidden = false;
        prev.hidden = false;
        const px = m.logoPx;
        meta.textContent = px
          ? `${m.logoNombre || 'imagen'} → JPG de ${px.ancho}×${px.alto} px`
          : `${m.logoNombre || 'imagen'} → JPG`;
      } else if (m.logoKey) {
        // Draft recuperado: el archivo ya está guardado, no hace falta resubirlo
        img.hidden = true;
        prev.hidden = false;
        meta.textContent = 'Imagen ya cargada ✓ · elegí otra si querés cambiarla';
      } else {
        prev.hidden = true;
      }
    };

    file.addEventListener('change', async () => {
      const elegido = file.files?.[0];
      if (!elegido) return;
      setErrEl(errLogo, '');
      prev.hidden = false;
      img.hidden = true;
      meta.textContent = 'Procesando la imagen…';
      try {
        const out = await normalizarLogo(elegido);
        liberarLogo(m);
        m.logoBlob = out.blob;
        m.logoUrl = URL.createObjectURL(out.blob);
        m.logoNombre = elegido.name;
        m.logoPx = { ancho: out.ancho, alto: out.alto };
        // Medidas nuevas: la imagen cambió, la proporción anterior ya no vale
        const med = medidasDesdePx(out.ancho, out.alto);
        m.alto = med.alto;
        m.ancho = med.ancho;
        alto.value = formatCm(m.alto);
        ancho.value = formatCm(m.ancho);
        setErrEl(errMedidas, '');
        pintarPreview();
        saveDraft();
      } catch (e) {
        console.error('[um-checkout] error procesando el logo:', e);
        liberarLogo(m);
        prev.hidden = true;
        setErrEl(errLogo, 'No pudimos leer esa imagen. Probá con otro archivo JPG, PNG o WebP.');
      }
    });

    // El teclado en es-AR da coma; el INPI usa punto. Se acepta cualquiera y al
    // salir del campo se muestra ya normalizado, que es lo que se va a enviar.
    const medida = (el: HTMLInputElement, campo: 'alto' | 'ancho') => {
      el.value = formatCm(m[campo]);
      el.addEventListener('input', () => {
        m[campo] = parseCm(el.value);
        setErrEl(errMedidas, '');
        saveDraft();
      });
      el.addEventListener('blur', () => {
        if (m[campo] !== null) el.value = formatCm(m[campo]);
      });
    };
    medida(alto, 'alto');
    medida(ancho, 'ancho');

    colores.value = m.colores;
    colores.addEventListener('input', () => {
      m.colores = colores.value;
      setErrEl(errColores, '');
      saveDraft();
    });

    // La confirmación es solo de la mixta: es el tipo donde la denominación
    // tiene que transcribir todo el texto de la imagen.
    const esMixta = m.tipo === 'mixta';
    confirmWrap.hidden = !esMixta;
    errConfirm.hidden = !esMixta;
    if (esMixta) {
      const denom = m.nombre.trim().toUpperCase();
      confirmTxt.textContent = denom
        ? `Confirmo que “${denom}” es exactamente todo el texto que aparece en la imagen.`
        : 'Confirmo que la denominación es exactamente todo el texto que aparece en la imagen.';
      confirmChk.checked = m.confirmaTexto;
      confirmChk.addEventListener('change', () => {
        m.confirmaTexto = confirmChk.checked;
        setErrEl(errConfirm, '');
        saveDraft();
      });
    }

    pintarPreview();
  }

  // ── Pago: Mercado Pago o transferencia ──────────────────
  const mpBtn = document.getElementById('ck-mp-btn') as HTMLButtonElement;
  const trBtn = document.getElementById('ck-tr-btn') as HTMLButtonElement;
  const skipBtn = document.getElementById('ck-skip-pay') as HTMLButtonElement;

  interface OrderResponse {
    ref: string;
    metodo?: MetodoPago;
    init_point?: string;
    importe?: number;
  }

  function orderBody() {
    return JSON.stringify({
      marcas: marcas.map(m => ({ nombre: m.nombre.trim(), tipo: m.tipo, clases: m.clases })),
      contacto: {
        email: input('ck-email').value.trim(),
        whatsapp: input('ck-whatsapp').value.trim(),
      },
      garantia,
      metodo: metodoPago,
    });
  }

  async function createOrder(): Promise<OrderResponse> {
    const res = await fetch('/api/checkout/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: orderBody(),
    });
    const data = await res.json();
    if (!res.ok || !data.ref) throw new Error(data.error || 'error creando pedido');
    bloquearPedido();
    return data;
  }

  /** Con el pedido creado, marcas y clases quedan de solo lectura: el importe
   *  ya está fijado y lo que se presenta ante el INPI tiene que coincidir. */
  function bloquearPedido() {
    if (pedidoBloqueado) return;
    pedidoBloqueado = true;
    const aviso =
      'Tu pedido ya está generado, así que las marcas y las clases quedaron fijas. ' +
      '¿Te falta agregar algo? Escribinos por WhatsApp y lo resolvemos.';
    [$('ck-lock-marcas'), $('ck-lock-clases')].forEach(el => {
      el.textContent = aviso;
      el.hidden = false;
    });
    renderMarcasStep1();
    renderClasesCards();
  }

  mpBtn.addEventListener('click', async () => {
    setErr('pago', '');
    metodoPago = 'mercadopago';
    mpBtn.disabled = true;
    $('ck-mp-label').textContent = 'Redirigiendo a Mercado Pago…';
    track('add_payment_info', { currency: 'ARS', value: total(), metodo: 'mercadopago' });
    try {
      const data = await createOrder();
      orderRef = data.ref;
      saveDraft(); // por si vuelve en el mismo navegador
      window.location.href = data.init_point!;
    } catch (e) {
      console.error('[um-checkout] error iniciando pago:', e);
      track('ck_pago_error', { motivo: String(e).slice(0, 100) }, false);
      setErr('pago', 'No pudimos iniciar el pago. Probá de nuevo en unos segundos.');
      mpBtn.disabled = false;
      $('ck-mp-label').textContent = 'Pagar con Mercado Pago →';
    }
  });

  // Transferencia: no hay redirect ni webhook. Se crea el pedido
  // (pending_transfer), se muestran los datos de la cuenta y el usuario sigue
  // completando la solicitud en la misma sesión. La acreditación se concilia a
  // mano contra el N° de pedido que el cliente manda con el comprobante.
  function showTransferPanel(ref: string, importe: number) {
    $('ck-tr-importe').textContent = formatARS(importe);
    $('ck-tr-ref').textContent = ref;
    const wa = $('ck-tr-wa') as HTMLAnchorElement;
    wa.href = waHrefComprobante(ref);
    const resume = $('ck-tr-resume') as HTMLAnchorElement;
    const resumeUrl = `${window.location.origin}/registrar?order=${encodeURIComponent(ref)}`;
    resume.href = resumeUrl;
    resume.textContent = resumeUrl;
    $('ck-pay-methods').hidden = true;
    $('ck-pay-note').hidden = true;
    $('ck-transfer').hidden = false;
  }

  trBtn.addEventListener('click', async () => {
    setErr('pago', '');
    metodoPago = 'transferencia';
    trBtn.disabled = true;
    $('ck-tr-label').textContent = 'Generando tu pedido…';
    track('add_payment_info', { currency: 'ARS', value: total(), metodo: 'transferencia' });
    track('ck_pago_transferencia', { currency: 'ARS', value: total() });
    try {
      const data = await createOrder();
      orderRef = data.ref;
      saveDraft();
      showTransferPanel(data.ref, data.importe ?? total());
    } catch (e) {
      console.error('[um-checkout] error creando pedido por transferencia:', e);
      track('ck_pago_error', { motivo: String(e).slice(0, 100) }, false);
      setErr('pago', 'No pudimos generar tu pedido. Probá de nuevo en unos segundos.');
      metodoPago = 'mercadopago';
    } finally {
      trBtn.disabled = false;
      $('ck-tr-label').textContent = 'Pagar por transferencia →';
    }
  });

  $('ck-tr-next').addEventListener('click', () => {
    showPayBanner('pending_transfer');
    goTo('5');
  });

  // Volver al selector: el pedido ya creado se reusa si vuelve a transferencia,
  // y queda huérfano (pending_transfer, sin completar) si termina pagando por MP.
  $('ck-tr-otro').addEventListener('click', () => {
    $('ck-transfer').hidden = true;
    $('ck-pay-methods').hidden = false;
    $('ck-pay-note').hidden = false;
    metodoPago = 'mercadopago';
  });

  // Copiar alias / N° de pedido
  document.querySelectorAll<HTMLButtonElement>('.ck-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy
        ?? (btn.id === 'ck-copy-ref' ? $('ck-tr-ref').textContent || '' : '');
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const prev = btn.textContent;
        btn.textContent = '¡Copiado!';
        btn.classList.add('ck-copy--ok');
        setTimeout(() => { btn.textContent = prev; btn.classList.remove('ck-copy--ok'); }, 1600);
      } catch { /* sin permiso de clipboard: el dato está a la vista igual */ }
    });
  });

  // Saltar pago (demo): solo visible en previews y localhost — nunca en el
  // dominio real. Crea el pedido igual (queda pending_payment) para que el
  // pipeline completo —PDF + emails— funcione también sin pagar.
  const isDemoEnv = window.location.hostname === 'localhost'
    || (window.location.hostname.endsWith('.pages.dev') && window.location.hostname !== 'unamarca.pages.dev');
  if (isDemoEnv) skipBtn.hidden = false;

  skipBtn.addEventListener('click', async () => {
    skipBtn.disabled = true;
    if (!orderRef) {
      try {
        const data = await createOrder();
        orderRef = data.ref;
      } catch (e) {
        console.warn('[um-checkout] demo sin pedido (¿API no disponible?):', e);
      }
    }
    skipBtn.disabled = false;
    goTo('5');
  });

  function showPayBanner(status: string) {
    const banner = $('ck-pay-banner');
    const kind =
      status === 'paid' ? 'ok' :
      status === 'rejected' ? 'err' : 'warn';
    // La transferencia se paga desde el home banking, casi siempre después de
    // completar la solicitud: el alias tiene que volver a estar acá, no solo
    // en el paso 4 donde el usuario ya no vuelve.
    const transferMsg =
      `<b>Falta tu transferencia de ${formatARS(total())}.</b> Alias ` +
      `<b>${TRANSFERENCIA.alias}</b> (${TRANSFERENCIA.titular}, ${TRANSFERENCIA.banco}). ` +
      `Pedido <b>${orderRef ?? ''}</b>. Seguí completando tus datos: presentamos ` +
      `ante el INPI cuando se acredite.`;
    const msg =
      status === 'pending_transfer'
        ? transferMsg
        : status === 'paid'
          ? '<b>✓ Pago aprobado.</b> Recibimos tu pago. Completá los datos para terminar tu solicitud.'
          : status === 'rejected'
            ? '<b>El pago fue rechazado.</b> Podés <button type="button" class="ck-banner-link" id="ck-retry-pay">reintentar el pago</button> o continuar y lo coordinamos después.'
            : '<b>Tu pago está pendiente de confirmación.</b> Podés completar tus datos mientras tanto; te avisamos por email cuando se acredite.';
    banner.className = `ck-banner ck-banner--${kind}`;
    banner.innerHTML = msg;
    banner.hidden = false;
    document.getElementById('ck-retry-pay')?.addEventListener('click', () => goTo('4'));
  }

  async function resumeOrder(ref: string) {
    try {
      const res = await fetch(`/api/checkout/order/${encodeURIComponent(ref)}`);
      if (!res.ok) return false;
      const o = await res.json();
      orderRef = o.ref;
      const p = o.payload || {};
      if (p.metodo === 'transferencia') metodoPago = 'transferencia';
      // Descripciones y sitios ya cargados sobreviven en el draft local
      const draftPrevio = marcasDesdeDraft(leerDraft());
      const delPedido = marcasDelPedido(p);
      if (delPedido.length) {
        setMarcas(delPedido.map((m, i) => {
          const previo = draftPrevio[i];
          const mismo = previo?.nombre.trim().toLowerCase() === m.nombre.trim().toLowerCase();
          if (!mismo) return m;
          return {
            ...m,
            descripcion: previo.descripcion,
            sitioWeb: previo.sitioWeb,
            // El logo en sí no sobrevive al draft (es un Blob), pero sí lo que
            // el cliente escribió alrededor y la key si ya se subió.
            colores: previo.colores,
            alto: previo.alto,
            ancho: previo.ancho,
            confirmaTexto: previo.confirmaTexto,
            logoKey: m.logoKey ?? previo.logoKey,
          };
        }), false);
      }
      bloquearPedido();
      if (p.contacto?.email) input('ck-email').value = p.contacto.email;
      if (p.contacto?.whatsapp) input('ck-whatsapp').value = p.contacto.whatsapp;
      garantia = !!p.garantia;
      input('ck-garantia').checked = garantia;
      updateSummary();
      // Nombre por estado (ck_pago_retorno_paid / _rejected / _pending_transfer…)
      // para que el desglose se vea en GA4 sin dimensiones personalizadas.
      track(`ck_pago_retorno_${String(o.status).replace(/[^a-z0-9]/gi, '_')}`);
      showPayBanner(o.status);
      goTo('5');
      return true;
    } catch {
      return false;
    }
  }

  // ── Carta poder: preview ────────────────────────────────
  function cpData(): CartaPoderData {
    const now = new Date();
    return {
      nombreApellido: `${input('ck-nombre').value.trim()} ${input('ck-apellido').value.trim()}`.trim(),
      docTipo: input('ck-tipodoc').value || 'DNI',
      docNumero: input('ck-docnum').value.trim(),
      cuit: input('ck-cuit').value.trim(),
      calle: input('ck-calle').value.trim(),
      numero: input('ck-numero').value.trim(),
      piso: input('ck-piso').value.trim() || undefined,
      depto: input('ck-depto').value.trim() || undefined,
      codigoPostal: input('ck-codpostal').value.trim(),
      localidad: input('ck-localidad').value.trim(),
      provincia: input('ck-provincia').value,
      marcas: marcas.map(m => ({ nombre: m.nombre, tipo: m.tipo, clases: [...m.clases] })),
      fecha: { dia: now.getDate(), mes: now.getMonth(), anio: now.getFullYear() },
    };
  }

  function renderPreview() {
    $('ck-cp-preview').innerHTML = cartaPoderHTML(cpData());
  }

  $('ck-edit-datos').addEventListener('click', () => goTo('5'));

  // ── Firma (canvas) ──────────────────────────────────────
  const canvas = document.getElementById('ck-sig') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const SIG_H = 180;
  let strokes: { x: number; y: number }[][] = [];
  let drawing = false;

  function sizeCanvas() {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.parentElement!.getBoundingClientRect().width;
    if (w === 0) return; // paso oculto
    canvas.width = w * dpr;
    canvas.height = SIG_H * dpr;
    canvas.style.width = `${w}px`;
    canvas.style.height = `${SIG_H}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    redraw();
  }

  function redraw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = '#0f172a';
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    strokes.forEach(stroke => {
      ctx.beginPath();
      stroke.forEach((p, i) => (i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y)));
      ctx.stroke();
    });
  }

  function sigPos(e: PointerEvent) {
    const r = canvas.getBoundingClientRect();
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  canvas.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    canvas.setPointerCapture(e.pointerId);
    drawing = true;
    strokes.push([sigPos(e)]);
    $('ck-sig-hint').hidden = true;
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drawing) return;
    const stroke = strokes[strokes.length - 1];
    stroke.push(sigPos(e));
    const [a, b] = [stroke[stroke.length - 2], stroke[stroke.length - 1]];
    ctx.strokeStyle = '#0f172a';
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
  });
  const endStroke = () => { drawing = false; updateSubmitState(); };
  canvas.addEventListener('pointerup', endStroke);
  canvas.addEventListener('pointercancel', endStroke);
  window.addEventListener('resize', sizeCanvas);

  $('ck-sig-clear').addEventListener('click', () => {
    strokes = [];
    redraw();
    $('ck-sig-hint').hidden = false;
    updateSubmitState();
  });

  // ── Envío ───────────────────────────────────────────────
  const requiereAlgunLogo = () => marcas.some(m => requiereLogo(m.tipo));

  /** Sube los logos que todavía no están en el servidor, de a uno: el endpoint
   *  hace read-modify-write del payload y en paralelo se pisarían.
   *  Devuelve true si alguno quedó sin subir — el pedido se envía igual (el
   *  cliente ya pagó) y la confirmación le avisa que se lo vamos a pedir. */
  async function subirLogos(ref: string): Promise<boolean> {
    let pendiente = false;
    for (let i = 0; i < marcas.length; i++) {
      const m = marcas[i];
      if (!requiereLogo(m.tipo)) continue;
      if (m.logoKey && !m.logoBlob) continue; // ya está guardado
      if (!m.logoBlob) { pendiente = true; continue; }
      try {
        const res = await fetch(`/api/checkout/order/${encodeURIComponent(ref)}/logo?i=${i}`, {
          method: 'POST',
          headers: { 'Content-Type': 'image/jpeg' },
          body: m.logoBlob,
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        m.logoKey = data.logoKey || null;
        saveDraft();
      } catch (e) {
        console.error(`[um-checkout] no se pudo subir el logo de la marca ${i + 1}:`, e);
        track('ck_logo_upload_error', { motivo: String(e).slice(0, 100) }, false);
        pendiente = true;
      }
    }
    return pendiente;
  }

  const submitBtn = document.getElementById('ck-submit') as HTMLButtonElement;
  const termsCheck = input('ck-terms');

  function updateSubmitState() {
    submitBtn.disabled = strokes.length === 0 || !termsCheck.checked;
  }
  termsCheck.addEventListener('change', updateSubmitState);

  submitBtn.addEventListener('click', async () => {
    submitBtn.disabled = true;
    $('ck-submit-label').textContent = 'Enviando…';
    $('ck-submit-spin').style.display = '';

    // Los logos van primero y de a uno: el endpoint hace read-modify-write del
    // payload del pedido, y en paralelo se pisarían entre sí.
    const logosPendientes = orderRef ? await subirLogos(orderRef) : requiereAlgunLogo();

    const payload = {
      marcas: marcas.map(m => ({
        nombre: m.nombre.trim(),
        tipo: m.tipo,
        clases: m.clases,
        descripcion: m.descripcion.trim(),
        sitioWeb: m.sitioWeb.trim(),
        ...(requiereLogo(m.tipo) ? {
          colores: m.colores.trim(),
          alto: m.alto,
          ancho: m.ancho,
        } : {}),
      })),
      titular: {
        tipoPersona: 'Humana',
        nombre: input('ck-nombre').value.trim(),
        apellido: input('ck-apellido').value.trim(),
        genero: input('ck-genero').value,
        estadoCivil: input('ck-estadocivil').value,
        nombreConyuge: input('ck-estadocivil').value === 'Casado/a'
          ? input('ck-conyuge').value.trim() : '',
        documento: {
          tipo: input('ck-tipodoc').value || 'DNI',
          numero: input('ck-docnum').value.trim(),
        },
        cuit: input('ck-cuit').value.trim(),
        domicilio: {
          pais: input('ck-pais').value.trim() || 'Argentina',
          calle: input('ck-calle').value.trim(),
          numero: input('ck-numero').value.trim(),
          piso: input('ck-piso').value.trim(),
          depto: input('ck-depto').value.trim(),
          localidad: input('ck-localidad').value.trim(),
          codigoPostal: input('ck-codpostal').value.trim(),
          provincia: input('ck-provincia').value,
        },
      },
      contacto: {
        email: input('ck-email').value.trim(),
        whatsapp: input('ck-whatsapp').value.trim(),
      },
      garantia,
      pricing: pricing(),
      // El estado real del pago vive en D1 (status del pedido); acá solo queda
      // registrado el medio que eligió el usuario.
      payment: { provider: metodoPago },
      firma: canvas.toDataURL('image/png'),
    };

    // Con pedido: generar el PDF de la carta poder EN EL NAVEGADOR (el plan
    // free de Pages Functions no tiene CPU para pdf-lib) y adjuntarlo al
    // pedido en D1 — el backend lo manda por email (cliente + admin).
    let ref: string;
    if (orderRef) {
      let cartaPdfBase64: string | null = null;
      try {
        const { buildCartaPoderPdf } = await import('../lib/checkout/cartaPoderPdf');
        const pdfBytes = await buildCartaPoderPdf(cpData(), payload.firma);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < pdfBytes.length; i += chunk) {
          binary += String.fromCharCode(...pdfBytes.subarray(i, i + chunk));
        }
        cartaPdfBase64 = btoa(binary);
      } catch (e) {
        console.error('[um-checkout] error generando PDF (se envía sin adjunto):', e);
      }

      try {
        const res = await fetch(`/api/checkout/order/${encodeURIComponent(orderRef)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, cartaPdfBase64 }),
        });
        if (!res.ok) throw new Error(String(res.status));
      } catch (e) {
        console.error('[um-checkout] error guardando la solicitud:', e);
        alert('No pudimos guardar tu solicitud. Probá de nuevo.');
        submitBtn.disabled = false;
        $('ck-submit-label').textContent = 'Confirmar y enviar solicitud';
        $('ck-submit-spin').style.display = 'none';
        return;
      }
      ref = orderRef;
    } else {
      console.info('[um-checkout] payload (demo, sin pedido MP):', payload);
      await new Promise(r => setTimeout(r, 900));
      const now = new Date();
      const ymd = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
      ref = `UM-${ymd}-${String(Math.floor(Math.random() * 10000)).padStart(4, '0')}`;
    }

    // Conversión: GA4 (importable a Google Ads) + Meta Pixel
    try {
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'purchase', {
          transaction_id: ref,
          value: payload.pricing.total,
          currency: 'ARS',
          items: marcas.map(m => ({
            item_name: 'Registro de marca',
            item_variant: garantia ? 'con_garantia' : 'sin_garantia',
            quantity: m.clases.length || 1,
          })),
        });
      }
      if (typeof w.fbq === 'function') {
        w.fbq('track', 'Purchase', { value: payload.pricing.total, currency: 'ARS' });
      }
    } catch { /* analytics nunca bloquea la confirmación */ }

    $('ck-ref').textContent = ref;
    if (orderRef) {
      $('ck-done-email').textContent = payload.contacto.email || 'tu email';
    } else {
      $('ck-done-mail').textContent = 'Modo demo (sin pago): no se envían emails.';
    }

    const varias = marcas.length > 1;
    if (varias) {
      $('ck-done-title').textContent = '¡Listo! Recibimos tus solicitudes.';
      $('ck-done-plazo').innerHTML =
        `Presentaremos tus <b>${marcas.length} solicitudes</b> ante el INPI dentro de las ` +
        'próximas <b>48 horas hábiles</b> y te enviaremos todas las notificaciones ' +
        'del trámite por email.';
    }

    // Transferencia: el pago casi nunca está hecho a esta altura. Último
    // recordatorio con el alias y el link para mandar el comprobante.
    if (metodoPago === 'transferencia') {
      $('ck-done-importe').textContent = formatARS(payload.pricing.total);
      ($('ck-done-wa') as HTMLAnchorElement).href = waHrefComprobante(ref);
      $('ck-done-transfer').hidden = false;
      $('ck-done-plazo').innerHTML =
        `Presentaremos ${varias ? `tus <b>${marcas.length} solicitudes</b>` : 'tu solicitud'} ` +
        'ante el INPI dentro de las <b>48 horas hábiles</b> ' +
        'desde que se acredite tu transferencia, y te enviaremos todas las ' +
        'notificaciones del trámite por email.';
    }

    $('ck-done-logo').hidden = !logosPendientes;

    localStorage.removeItem(DRAFT_KEY);
    goTo('done');
  });

  // ── Inputs: formato y draft ─────────────────────────────
  input('ck-cuit').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    el.value = formatCuitInput(el.value);
  });
  input('ck-docnum').addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (input('ck-tipodoc').value === 'DNI') {
      el.value = el.value.replace(/\D/g, '').slice(0, 8);
    }
  });
  FIELD_IDS.forEach(id => input(id).addEventListener('input', () => {
    setErr(id.replace('ck-', ''), ''); // al corregir, el error desaparece
    saveDraft();
  }));

  // ── Botones Continuar / Volver ──────────────────────────
  const VALIDATORS: Record<string, () => boolean> = {
    '1': validateStep1, '2': validateContacto, '3': validatePedido, '5': validateTitular,
  };

  document.querySelectorAll<HTMLElement>('[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      const from = btn.dataset.next!;
      const validator = VALIDATORS[from];
      if (validator && !validator()) return;
      goTo(String(parseInt(from, 10) + 1));
    });
  });
  document.querySelectorAll<HTMLElement>('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => goTo(btn.dataset.back!));
  });

  // ── Render inicial ──────────────────────────────────────
  // El paso 1 arranca vacío en el HTML: la primera fila la pinta el script.
  renderMarcasStep1();
  updateSummary();

  // ── Bootstrap: volver de Mercado Pago (?order=REF) o draft local ─────
  const urlParams = new URLSearchParams(window.location.search);
  const urlOrderRef = urlParams.get('order');
  if (urlOrderRef) {
    resumeOrder(urlOrderRef).then(ok => { if (!ok) restoreDraft(); });
  } else {
    restoreDraft();
    // Prefill desde /verificar-marca y campañas. Formatos aceptados:
    //   ?marca=X&clase=9,25            → una marca (legado)
    //   ?marca=A&clase=2,3&marca=B&clase=4,6 → varias, apareadas por posición
    const urlMarcas = urlParams.getAll('marca').map(s => s.trim().slice(0, 80));
    const urlClases = urlParams.getAll('clase').map(v => v
      .split(',')
      .map(s => parseInt(s, 10))
      .filter(n => n >= 1 && n <= 45));
    const urlTel = (urlParams.get('tel') || '').trim().slice(0, 30);
    const urlEmail = (urlParams.get('email') || '').trim().slice(0, 120);

    const nDeep = Math.min(MAX_MARCAS, Math.max(urlMarcas.length, urlClases.length));
    if (nDeep > 0) {
      setMarcas(
        Array.from({ length: nDeep }, (_, i) => nuevaMarcaCon(urlMarcas[i], urlClases[i])),
        false,
      );
    }
    if (urlTel) input('ck-whatsapp').value = urlTel;
    if (urlEmail) input('ck-email').value = urlEmail;
    if (nDeep > 0 || urlTel || urlEmail) saveDraft();
  }
</script>

