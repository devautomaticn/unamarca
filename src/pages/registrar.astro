  }
  .ck-rail-bar {
    display: flex; align-items: center; gap: 0.5rem; width: 100%; cursor: pointer;
    background: none; border: none; padding: 0.875rem 1.25rem;
    font-family: 'Inter', system-ui, sans-serif; color: #0b1d3a;
  }
