      // registrado el medio que eligió el usuario.
      payment: { provider: metodoPago },
      firma: canvas.toDataURL('image/png'),
    };

    // Con pedido: generar el PDF de la carta poder EN EL NAVEGADOR (el plan
    // free de Pages Functions no tiene CPU para pdf-lib) y adjuntarlo al
    // pedido en D1 — el backend lo manda por email (cliente + admin).
    let ref: string;
    if (orderRef) {
      let cartaPdfBase64: string | null = null;
      try {
        const { buildCartaPoderPdf } = await import('../lib/checkout/cartaPoderPdf');
        const pdfBytes = await buildCartaPoderPdf(cpData(), payload.firma);
        let binary = '';
        const chunk = 0x8000;
        for (let i = 0; i < pdfBytes.length; i += chunk) {
          binary += String.fromCharCode(...pdfBytes.subarray(i, i + chunk));
        }
        cartaPdfBase64 = btoa(binary);
      } catch (e) {
        console.error('[um-checkout] error generando PDF (se envía sin adjunto):', e);
      }

      try {
        const res = await fetch(`/api/checkout/order/${encodeURIComponent(orderRef)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, cartaPdfBase64 }),
        });
        if (!res.ok) throw new Error(String(res.status));
      } catch (e) {
        console.error('[um-checkout] error guardando la solicitud:', e);
        alert('No pudimos guardar tu solicitud. Probá de nuevo.');
        submitBtn.disabled = false;
        $('ck-submit-label').textContent = 'Confirmar y enviar solicitud';
        $('ck-submit-spin').style.display = 'none';
        return;
      }
      ref = orderRef;
    } else {
      console.info('[um-checkout] payload (demo, sin pedido MP):', payload);
      await new Promise(r => setTimeout(r, 900));
      const now = new Date();
      const ymd = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
      ref = `UM-${ymd}-${String(Math.floor(Math.random() * 10000)).padStart(4, '0')}`;
    }

    // Conversión: GA4 (importable a Google Ads) + Meta Pixel
    try {
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'purchase', {
          transaction_id: ref,
          value: payload.pricing.total,
          currency: 'ARS',
          items: [{ item_name: 'Registro de marca', item_variant: garantia ? 'con_garantia' : 'sin_garantia', quantity: clases.length || 1 }],
        });
      }
      if (typeof w.fbq === 'function') {
        w.fbq('track', 'Purchase', { value: payload.pricing.total, currency: 'ARS' });
      }
    } catch { /* analytics nunca bloquea la confirmación */ }

    $('ck-ref').textContent = ref;
    if (orderRef) {
      $('ck-done-email').textContent = payload.contacto.email || 'tu email';
    } else {
      $('ck-done-mail').textContent = 'Modo demo (sin pago): no se envían emails.';
    }

    // Transferencia: el pago casi nunca está hecho a esta altura. Último
    // recordatorio con el alias y el link para mandar el comprobante.
    if (metodoPago === 'transferencia') {
      $('ck-done-importe').textContent = formatARS(payload.pricing.total);
      ($('ck-done-wa') as HTMLAnchorElement).href = waHrefComprobante(ref);
      $('ck-done-transfer').hidden = false;
      $('ck-done-plazo').innerHTML =
        'Presentaremos tu solicitud ante el INPI dentro de las <b>48 horas hábiles</b> ' +
        'desde que se acredite tu transferencia, y te enviaremos todas las ' +
        'notificaciones del trámite por email.';
    }

