    $('ck-sum-hon').textContent = formatARS(p.honorarios);
    $('ck-sum-garantia-row').hidden = !garantia;
    $('ck-sum-gar-label').textContent = `Garantía de Devolución (${nLabel})`;
    $('ck-sum-gar').textContent = formatARS(garantia ? p.garantia : PRICING.garantia * p.lineas);
    $('ck-sum-ara-label').innerHTML =
      `Arancel INPI (${nLabel}) <small>se paga al INPI · valor ${PRICING.arancelVigencia}</small>`;
    $('ck-sum-ara').textContent = formatARS(p.arancelInpi);
    $('ck-sum-total').textContent = formatARS(p.total);
