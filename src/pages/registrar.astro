<script>
  import { NIZA_CLASSES } from '../lib/checkout/nizaClasses';
  import {
    PRICING, MAX_CLASES, MAX_MARCAS, TRANSFERENCIA,
    computeOrderPricing, contarLineas, clasesTexto, lineasTexto, formatARS,
    TIPOS_MARCA, LOGO_MAX_PX, LOGO_JPEG_QUALITY, LOGO_CM_MAX,
    formatCm, parseCm, medidasDesdePx, normalizeTipoMarca, requiereLogo,
    tieneDenominacion, type TipoMarca,
  } from '../lib/checkout/constants';
  import { formatCuitInput, isValidCuit, cuitMatchesDni } from '../lib/checkout/cuit';
  import { cartaPoderHTML, type CartaPoderData } from '../lib/checkout/cartaPoder';
  import { waHrefComprobante } from '../lib/wa';

  const DRAFT_KEY = 'um-checkout-draft';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const tpl = (id: string) => (document.getElementById(id) as HTMLTemplateElement);

  // true = modo test (ningún campo obligatorio, formatos solo si hay valor)
  const FIELDS_OPTIONAL = false;

  // ── Estado ──────────────────────────────────────────────
  // Un pedido son 1..MAX_MARCAS marcas, cada una con sus propias clases.
  // `descripcion` y `sitioWeb` se completan en el paso 5 (post-pago).
  // El logo (mixta/figurativa) también es del paso 5: el INPI no lo necesita
  // para cobrar, y pedir un archivo antes del pago cuesta conversión.
  interface MarcaState {
    nombre: string;
    tipo: TipoMarca;
    clases: number[];
    descripcion: string;
    sitioWeb: string;
    /** Enunciación de colores — obligatoria en mixta y figurativa */
    colores: string;
    alto: number | null;
    ancho: number | null;
    /** Solo mixta: el cliente confirma que la denominación transcribe todo el
     *  texto de la imagen (si no coincide, el INPI corrige de oficio). */
    confirmaTexto: boolean;
    /** Key en R2, la escribe el servidor al subir */
    logoKey: string | null;
    /** Transitorios: no van al draft (un JPG no entra en localStorage) */
    logoBlob?: Blob | null;
    logoUrl?: string | null;
    logoNombre?: string;
    logoPx?: { ancho: number; alto: number } | null;
  }
  const nuevaMarca = (nombre = '', tipo: TipoMarca = 'denominativa'): MarcaState => ({
    nombre, tipo, clases: [], descripcion: '', sitioWeb: '',
    colores: '', alto: null, ancho: null, confirmaTexto: false,
    logoKey: null, logoBlob: null, logoUrl: null, logoNombre: '', logoPx: null,
  });

  let marcas: MarcaState[] = [nuevaMarca()];
  let garantia = false;
  let orderRef: string | null = null; // pedido creado al iniciar el pago
  type MetodoPago = 'mercadopago' | 'transferencia';
  let metodoPago: MetodoPago = 'mercadopago';

  /** Marcas y clases quedan congeladas una vez que existe el pedido: lo que se
   *  presenta ante el INPI tiene que ser exactamente lo que se pagó. */
  let pedidoBloqueado = false;

  const FIELD_IDS = [
    'ck-nombre', 'ck-apellido', 'ck-tipodoc', 'ck-docnum',
    'ck-cuit', 'ck-genero', 'ck-estadocivil', 'ck-conyuge',
    'ck-pais', 'ck-calle', 'ck-numero', 'ck-piso', 'ck-depto',
    'ck-localidad', 'ck-codpostal', 'ck-provincia',
    'ck-email', 'ck-whatsapp',
  ];

  /** El draft guarda todo menos la imagen: un JPG en base64 no entra en la
   *  cuota de localStorage. Si el cliente recarga antes de enviar, vuelve a
   *  elegir el archivo (el resto de lo cargado sigue ahí). */
  function marcaParaDraft(m: MarcaState) {
    const { logoBlob, logoUrl, logoPx, ...resto } = m;
    return resto;
  }

  function saveDraft() {
    const values: Record<string, string> = {};
    FIELD_IDS.forEach(id => { values[id] = input(id).value; });
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        values, marcas: marcas.map(marcaParaDraft), garantia,
      }));
    } catch (e) {
      console.warn('[um-checkout] no se pudo guardar el draft:', e);
    }
  }

  function leerDraft(): any {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch { return null; }
  }

  function restoreDraft() {
    try {
      const draft = leerDraft();
      if (!draft) return;
      FIELD_IDS.forEach(id => { if (draft.values?.[id]) input(id).value = draft.values[id]; });
      syncConyuge();
      setMarcas(marcasDesdeDraft(draft), false);
      if (typeof draft.garantia === 'boolean') {
        garantia = draft.garantia;
        input('ck-garantia').checked = garantia;
        updateSummary();
      }
    } catch { /* draft corrupto: ignorar */ }
  }

  /** Drafts v1: una sola marca en values['ck-marca'] + clases/clase sueltas,
   *  con la descripción y el sitio en values. */
  function marcasDesdeDraft(draft: any): MarcaState[] {
    if (Array.isArray(draft?.marcas) && draft.marcas.length) {
      return draft.marcas.map((m: any) => ({
        ...nuevaMarca(String(m?.nombre ?? ''), normalizeTipoMarca(m?.tipo)),
        clases: Array.isArray(m?.clases) ? m.clases : [],
        descripcion: String(m?.descripcion ?? ''),
        sitioWeb: String(m?.sitioWeb ?? ''),
        colores: String(m?.colores ?? ''),
        alto: typeof m?.alto === 'number' ? m.alto : null,
        ancho: typeof m?.ancho === 'number' ? m.ancho : null,
        confirmaTexto: m?.confirmaTexto === true,
        logoKey: typeof m?.logoKey === 'string' ? m.logoKey : null,
      }));
    }
    const nombre = String(draft?.values?.['ck-marca'] ?? '');
    const clases = Array.isArray(draft?.clases)
      ? draft.clases
      : (draft?.clase ? [draft.clase] : []);
    if (!nombre && !clases.length) return [];
    return [{
      ...nuevaMarca(nombre),
      clases,
      descripcion: String(draft?.values?.['ck-descripcion'] ?? ''),
      sitioWeb: String(draft?.values?.['ck-sitioweb'] ?? ''),
    }];
  }

  /** Marcas tal como quedaron guardadas en el pedido (D1). Pedidos v1 traen una
   *  sola marca en `marca` + `clases`/`clase`. */
  function marcasDelPedido(p: any): MarcaState[] {
    if (Array.isArray(p?.marcas) && p.marcas.length) {
      return p.marcas.map((m: any) => nuevaMarcaCon(m?.nombre, m?.clases, m?.tipo, m?.logoKey));
    }
    const clases = Array.isArray(p?.clases) ? p.clases : (p?.clase ? [p.clase] : []);
    if (!p?.marca?.nombre && !clases.length) return [];
    return [nuevaMarcaCon(p?.marca?.nombre, clases, p?.marca?.tipo, null)];
  }
  const nuevaMarcaCon = (
    nombre: unknown, clases: unknown, tipo?: unknown, logoKey?: unknown,
  ): MarcaState => ({
    ...nuevaMarca(String(nombre ?? ''), normalizeTipoMarca(tipo)),
    clases: Array.isArray(clases) ? clases : [],
    logoKey: typeof logoKey === 'string' ? logoKey : null,
  });

  // ── Analytics: funnel GA4 ───────────────────────────────
  // Cada evento se manda una sola vez por sesión (volver atrás y avanzar de
  // nuevo no infla el funnel). sessionStorage sobrevive el ida-y-vuelta a MP.
  const FIRED_KEY = 'um-ck-fired';
  let fired = new Set<string>();
  try { fired = new Set(JSON.parse(sessionStorage.getItem(FIRED_KEY) || '[]')); } catch { /* ignorar */ }
  function track(name: string, params: Record<string, unknown> = {}, once = true) {
    try {
      if (once) {
        if (fired.has(name)) return;
        fired.add(name);
        sessionStorage.setItem(FIRED_KEY, JSON.stringify([...fired]));
      }
      const w = window as any;
      if (typeof w.gtag === 'function') w.gtag('event', name, params);
    } catch { /* analytics nunca bloquea el checkout */ }
  }

  // Paso alcanzado → evento. Nombres distintos por paso para poder armar el
  // funnel en GA4 sin registrar dimensiones personalizadas.
  const STEP_EVENTS: Record<string, string> = {
    '2': 'begin_checkout',   // completó el nombre de su marca
    '3': 'ck_paso_pedido',   // dejó contacto, ve el precio
    '4': 'ck_paso_pago',     // aceptó el pedido, ve el botón de pago
    '5': 'ck_paso_titular',  // volvió de MP con pedido creado
    '6': 'ck_paso_firma',    // completó titular, ve la carta poder
  };

  // ── Navegación entre pasos ──────────────────────────────
  const TOTAL_STEPS = 6;
  function stepTitle(step: string): string {
    const varias = marcas.length > 1;
    switch (step) {
      case '1': return varias ? 'Tus marcas' : 'Tu marca';
      case '2': return 'Contacto';
      case '3': return 'Tu pedido';
      case '4': return 'Pago';
      case '5': return 'Datos del titular';
      case '6': return 'Revisión y firma';
      default: return '';
    }
  }

  function goTo(step: string) {
    document.querySelectorAll<HTMLElement>('.ck-step').forEach(s => {
      s.hidden = s.dataset.step !== step;
    });
    if (step === 'done') {
      $('ck-progress').hidden = true;
    } else {
      const n = parseInt(step, 10);
      $('ck-step-label').textContent = `Paso ${n} de ${TOTAL_STEPS}`;
      $('ck-step-title').textContent = stepTitle(step);
      $('ck-bar-fill').style.width = `${(n / TOTAL_STEPS) * 100}%`;
    }
    if (step === '3') renderClasesCards();
    if (step === '4') updatePaySummary();
    if (step === '5') renderDescCards();
    if (step === '6') { renderPreview(); sizeCanvas(); }
    if (STEP_EVENTS[step]) {
      track(STEP_EVENTS[step], { checkout_step: parseInt(step, 10), currency: 'ARS', value: total() });
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ── Errores inline ──────────────────────────────────────
  function setErrEl(el: HTMLElement | null, msg: string) {
    if (el) { el.textContent = msg; el.style.display = msg ? 'block' : 'none'; }
  }
  function setErr(key: string, msg: string) {
    setErrEl(document.querySelector<HTMLElement>(`[data-err="${key}"]`), msg);
  }
  function clearErrs(keys: string[]) { keys.forEach(k => setErr(k, '')); }

  // ── Validación por paso ─────────────────────────────────
  // Con FIELDS_OPTIONAL, los campos vacíos pasan; el formato se valida
  // solo cuando el usuario cargó algo.
  function validateStep1(): boolean {
    clearErrs(['marca']);
    // Filas vacías de más: se descartan en silencio al continuar (el usuario
    // agregó una marca y se arrepintió). Siempre queda al menos una.
    if (!pedidoBloqueado && marcas.length > 1) {
      const conNombre = marcas.filter(m => m.nombre.trim());
      if (conNombre.length && conNombre.length !== marcas.length) {
        setMarcas(conNombre);
        renderMarcasStep1();
      }
    }
    if (FIELDS_OPTIONAL) return true;

    if (marcas.some(m => m.nombre.trim().length < 2)) {
      setErr('marca', marcas.length > 1
        ? 'Completá el nombre de todas tus marcas (o quitá las que sobren).'
        : 'Ingresá el nombre de tu marca.');
      return false;
    }
    // La clave incluye el tipo: la misma denominación como denominativa y como
    // mixta son dos solicitudes distintas, no un duplicado.
    const claves = marcas.map(m => `${m.nombre.trim().toLowerCase()}|${m.tipo}`);
    if (new Set(claves).size !== claves.length) {
      setErr('marca', 'Repetiste una marca con el mismo tipo. Si querés registrarla en más clases, sumalas en el paso 3.');
      return false;
    }
    return true;
  }

  function validatePedido(): boolean {
    clearErrs(['clase']);
    if (FIELDS_OPTIONAL) return true;
    const sinClases = marcas.filter(m => m.clases.length === 0);
    if (sinClases.length) {
      setErr('clase', marcas.length > 1
        ? `Elegí al menos una clase para ${sinClases.map(m => `“${m.nombre.trim().toUpperCase()}”`).join(' y ')}.`
        : 'Seleccioná al menos una clase para tu marca.');
      return false;
    }
    return true;
  }

  function validateContacto(): boolean {
    clearErrs(['email', 'whatsapp']);
    let ok = true;

    const email = input('ck-email').value.trim();
    if (email || !FIELDS_OPTIONAL) {
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('email', 'Ingresá un email válido.'); ok = false; }
    }

    const wa = input('ck-whatsapp').value.replace(/\D/g, '');
    if (wa || !FIELDS_OPTIONAL) {
      if (wa.length < 10) { setErr('whatsapp', 'Ingresá un número de WhatsApp válido (con código de área).'); ok = false; }
    }

    return ok;
  }

  function validateTitular(): boolean {
    const keys = ['nombre', 'apellido', 'docnum', 'cuit', 'genero', 'estadocivil', 'conyuge', 'calle', 'numero', 'localidad', 'codpostal', 'provincia'];
    clearErrs(keys);
    let ok = true;

    // Descripción y sitio web: uno por marca, en las tarjetas del paso 5
    let primerError: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>('#ck-desc-cards .ck-dcard').forEach((card, i) => {
      const m = marcas[i];
      if (!m) return;
      const errDesc = card.querySelector<HTMLElement>('.ck-desc-err')!;
      const errSitio = card.querySelector<HTMLElement>('.ck-sitio-err')!;
      setErrEl(errDesc, '');
      setErrEl(errSitio, '');

      const descripcion = m.descripcion.trim();
      if ((descripcion || !FIELDS_OPTIONAL) && descripcion.length < MIN_DESCRIPCION) {
        setErrEl(errDesc, `Contanos un poco más: mínimo ${MIN_DESCRIPCION} caracteres (llevás ${descripcion.length}).`);
        primerError = primerError || card;
        ok = false;
      }

      const sitioWeb = m.sitioWeb.trim();
      if (sitioWeb && !/^(https?:\/\/)?([\w-]+\.)+[\w-]{2,}(\/\S*)?$/i.test(sitioWeb)) {
        setErrEl(errSitio, 'Ingresá una dirección web válida (ej: https://tumarca.com).');
        primerError = primerError || card;
        ok = false;
      }

      // Logo, medidas y colores: obligatorios en mixta y figurativa
      if (!requiereLogo(m.tipo)) return;
      const errLogo = card.querySelector<HTMLElement>('.ck-logo-err')!;
      const errMedidas = card.querySelector<HTMLElement>('.ck-medidas-err')!;
      const errColores = card.querySelector<HTMLElement>('.ck-colores-err')!;
      const errConfirm = card.querySelector<HTMLElement>('.ck-confirm-err')!;
      [errLogo, errMedidas, errColores, errConfirm].forEach(el => setErrEl(el, ''));
      if (FIELDS_OPTIONAL) return;

      const fallo = (el: HTMLElement, msg: string) => {
        setErrEl(el, msg);
        primerError = primerError || card;
        ok = false;
      };
      if (!m.logoBlob && !m.logoKey) {
        fallo(errLogo, 'Subí la imagen de tu marca.');
      }
      if (m.alto === null || m.ancho === null) {
        fallo(errMedidas, `Ingresá alto y ancho en centímetros, hasta ${LOGO_CM_MAX} (con punto: 3.5).`);
      }
      if (!m.colores.trim()) {
        fallo(errColores, 'Escribí los colores de la imagen. Si es en blanco y negro, poné “Blanco y negro”.');
      }
      if (m.tipo === 'mixta' && !m.confirmaTexto) {
        fallo(errConfirm, 'Confirmá que la denominación coincide con el texto de la imagen.');
      }
    });
    if (primerError) (primerError as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });

    const req = (id: string, key: string, msg: string) => {
      if (!FIELDS_OPTIONAL && !input(id).value.trim()) { setErr(key, msg); ok = false; }
    };
    req('ck-nombre', 'nombre', 'Ingresá tu nombre.');
    req('ck-apellido', 'apellido', 'Ingresá tu apellido.');
    req('ck-genero', 'genero', 'Seleccioná el género.');
    req('ck-estadocivil', 'estadocivil', 'Seleccioná el estado civil.');
    if (input('ck-estadocivil').value === 'Casado/a') {
      req('ck-conyuge', 'conyuge', 'Ingresá el nombre del cónyuge.');
    }

    const tipoDoc = input('ck-tipodoc').value;
    const doc = input('ck-docnum').value.trim();
    if (tipoDoc === 'DNI') {
      const digits = doc.replace(/\D/g, '');
      if (doc || !FIELDS_OPTIONAL) {
        if (digits.length < 7 || digits.length > 8) { setErr('docnum', 'Ingresá un DNI válido (7 u 8 dígitos).'); ok = false; }
      }
    } else {
      req('ck-docnum', 'docnum', 'Ingresá el número de documento.');
    }

    const cuit = input('ck-cuit').value;
    if (cuit || !FIELDS_OPTIONAL) {
      if (!isValidCuit(cuit)) {
        setErr('cuit', 'El CUIT/CUIL no es válido. Revisalo.'); ok = false;
      } else if (tipoDoc === 'DNI' && doc && !cuitMatchesDni(cuit, doc)) {
        setErr('cuit', 'El CUIT/CUIL no coincide con el DNI ingresado.'); ok = false;
      }
    }

    req('ck-calle', 'calle', 'Ingresá la calle.');
    req('ck-numero', 'numero', 'Ingresá el número.');
    req('ck-localidad', 'localidad', 'Ingresá la localidad.');
    req('ck-codpostal', 'codpostal', 'Ingresá el código postal.');
    req('ck-provincia', 'provincia', 'Seleccioná la provincia.');

    return ok;
  }

  // Cónyuge: visible solo si el estado civil es Casado/a
  function syncConyuge() {
    $('ck-conyuge-row').hidden = input('ck-estadocivil').value !== 'Casado/a';
  }
  input('ck-estadocivil').addEventListener('change', syncConyuge);

  // ── Paso 1: filas de marca ──────────────────────────────
  /** Normaliza el estado y repinta todo lo que depende de la lista de marcas. */
  function setMarcas(lista: MarcaState[], save = true) {
    const limpias = lista.slice(0, MAX_MARCAS).map(m => ({
      ...nuevaMarca(String(m.nombre ?? '').slice(0, 120), normalizeTipoMarca(m.tipo)),
      clases: [...new Set((m.clases ?? []).filter(n => Number.isInteger(n) && n >= 1 && n <= 45))]
        .sort((a, b) => a - b)
        .slice(0, MAX_CLASES),
      descripcion: String(m.descripcion ?? ''),
      sitioWeb: String(m.sitioWeb ?? ''),
      colores: String(m.colores ?? ''),
      alto: typeof m.alto === 'number' ? m.alto : null,
      ancho: typeof m.ancho === 'number' ? m.ancho : null,
      confirmaTexto: m.confirmaTexto === true,
      logoKey: m.logoKey ?? null,
      logoBlob: m.logoBlob ?? null,
      logoUrl: m.logoUrl ?? null,
      logoNombre: m.logoNombre ?? '',
      logoPx: m.logoPx ?? null,
    }));
    marcas = limpias.length ? limpias : [nuevaMarca()];
    renderMarcasStep1();
    updateSummary();
    if (save) saveDraft();
  }

  /** Etiqueta del campo nombre según el tipo. En una figurativa no es la
   *  denominación (no tiene): es la referencia con la que identificamos el
   *  pedido, y el INPI nunca la ve. */
  function labelNombre(tipo: TipoMarca, i: number, varias: boolean): string {
    if (!tieneDenominacion(tipo)) {
      return varias ? `Marca ${i + 1} — referencia` : 'Nombre de referencia';
    }
    return varias ? `Marca ${i + 1}` : 'Nombre de la marca';
  }

  function renderMarcasStep1() {
    const cont = $('ck-marcas');
    const molde = tpl('ck-marca-row-tpl');
    cont.innerHTML = '';
    const varias = marcas.length > 1;

    marcas.forEach((m, i) => {
      const row = (molde.content.firstElementChild!.cloneNode(true) as HTMLElement);
      const label = row.querySelector<HTMLLabelElement>('.ck-marca-label')!;
      const inp = row.querySelector<HTMLInputElement>('input[type="text"]')!;
      const rm = row.querySelector<HTMLButtonElement>('.ck-marca-rm')!;
      const nombreHelp = row.querySelector<HTMLElement>('.ck-marca-nombre-help')!;
      const tipoLabel = row.querySelector<HTMLLabelElement>('.ck-tipo-label')!;
      const sel = row.querySelector<HTMLSelectElement>('.ck-tipo-sel')!;
      const tipoHelp = row.querySelector<HTMLElement>('.ck-tipo-help')!;

      inp.id = `ck-marca-${i}`;
      label.setAttribute('for', inp.id);
      sel.id = `ck-tipo-marca-${i}`;
      tipoLabel.setAttribute('for', sel.id);

      // Nombre y ayuda dependen del tipo elegido: se repintan sin re-render
      // para no perder el foco mientras el usuario escribe.
      const pintarPorTipo = () => {
        label.innerHTML = `${labelNombre(m.tipo, i, varias)} <em>*</em>`;
        inp.placeholder = tieneDenominacion(m.tipo)
          ? (i === 0 ? 'UnaMarca' : 'Nombre de la otra marca')
          : 'Cómo le decimos a este logo';
        nombreHelp.textContent = tieneDenominacion(m.tipo)
          ? ''
          : 'Es solo para identificar tu pedido: la marca figurativa se presenta sin texto.';
        nombreHelp.hidden = tieneDenominacion(m.tipo);
        tipoHelp.textContent = TIPOS_MARCA.find(t => t.value === m.tipo)!.ayuda;
      };

      inp.maxLength = 120;
      inp.value = m.nombre;
      inp.disabled = pedidoBloqueado;
      inp.addEventListener('input', () => {
        m.nombre = inp.value;
        setErr('marca', '');
        saveDraft();
      });

      sel.value = m.tipo;
      sel.disabled = pedidoBloqueado;
      sel.parentElement!.classList.toggle('ck-sel--locked', pedidoBloqueado);
      sel.addEventListener('change', () => {
        m.tipo = normalizeTipoMarca(sel.value);
        // Cambiar de tipo invalida lo que se cargó para el tipo anterior
        if (!requiereLogo(m.tipo)) {
          liberarLogo(m);
          m.colores = '';
          m.alto = null;
          m.ancho = null;
        }
        m.confirmaTexto = false;
        pintarPorTipo();
        setErr('marca', '');
        saveDraft();
      });

      rm.hidden = !varias || pedidoBloqueado;
      rm.setAttribute('aria-label', `Quitar la marca ${i + 1}`);
      rm.addEventListener('click', () => {
        liberarLogo(marcas[i]);
        setMarcas(marcas.filter((_, j) => j !== i));
        setErr('marca', '');
      });

      pintarPorTipo();
      cont.append(row);
    });

    $('ck-add-marca').hidden = pedidoBloqueado || marcas.length >= MAX_MARCAS;
    $('ck-marca-max').hidden = pedidoBloqueado || marcas.length < MAX_MARCAS;
    $('ck-marca-help').hidden = !varias;
    $('ck-marcas-section-label').textContent = varias ? 'Tus marcas' : 'Tu marca';

    // El título del paso 1 cambia de singular a plural con la lista
    const paso1 = document.querySelector<HTMLElement>('.ck-step[data-step="1"]');
    if (paso1 && !paso1.hidden) $('ck-step-title').textContent = stepTitle('1');
  }

  $('ck-add-marca').addEventListener('click', () => {
    if (marcas.length >= MAX_MARCAS) return;
    marcas.push(nuevaMarca());
    setMarcas(marcas);
    (document.getElementById(`ck-marca-${marcas.length - 1}`) as HTMLInputElement | null)?.focus();
  });

  // ── Paso 3: un selector de clases por marca ─────────────
  function normalize(s: string): string {
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  /** Refresca chips, label y subtotal de cada tarjeta ya montada */
  let refreshCards: () => void = () => {};

  function renderClasesCards() {
    const cont = $('ck-clases-cards');
    const molde = tpl('ck-clase-card-tpl');
    cont.innerHTML = '';
    const updaters: (() => void)[] = [];
    const varias = marcas.length > 1;

    marcas.forEach((m, i) => {
      const card = (molde.content.firstElementChild!.cloneNode(true) as HTMLElement);
      const nameEl = card.querySelector<HTMLElement>('.ck-mcard-name')!;
      const subEl = card.querySelector<HTMLElement>('.ck-mcard-sub')!;
      const btn = card.querySelector<HTMLButtonElement>('.ck-dd-btn')!;
      const panel = card.querySelector<HTMLElement>('.ck-dd-panel')!;
      const search = card.querySelector<HTMLInputElement>('.ck-dd-search')!;
      const labelEl = card.querySelector<HTMLElement>('.ck-dd-label')!;
      const chips = card.querySelector<HTMLElement>('.ck-chips')!;
      const maxHelp = card.querySelector<HTMLElement>('.ck-clase-max')!;
      const opts = Array.from(card.querySelectorAll<HTMLElement>('.ck-dd-opt'));

      nameEl.textContent = m.nombre.trim().toUpperCase() || `Marca ${i + 1}`;
      card.classList.toggle('ck-mcard--multi', varias);
      btn.disabled = pedidoBloqueado;

      const toggleClase = (num: number) => {
        if (pedidoBloqueado) return;
        if (m.clases.includes(num)) {
          m.clases = m.clases.filter(n => n !== num);
        } else if (m.clases.length >= MAX_CLASES) {
          maxHelp.hidden = false;
          return;
        } else {
          m.clases = [...m.clases, num].sort((a, b) => a - b);
        }
        setErr('clase', '');
        refreshCards();
        updateSummary();
        saveDraft();
      };

      const update = () => {
        // Label del botón
        if (m.clases.length === 0) {
          labelEl.textContent = 'Seleccioná una o más clases…';
          labelEl.classList.add('ck-dd-placeholder');
        } else if (m.clases.length === 1) {
          const c = NIZA_CLASSES.find(x => x.num === m.clases[0]);
          labelEl.textContent = c ? `Clase ${c.num} — ${c.nombre}` : `Clase ${m.clases[0]}`;
          labelEl.classList.remove('ck-dd-placeholder');
        } else {
          labelEl.textContent = clasesTexto(m.clases);
          labelEl.classList.remove('ck-dd-placeholder');
        }

        // Chips con botón de quitar
        chips.innerHTML = '';
        m.clases.forEach(num => {
          const c = NIZA_CLASSES.find(x => x.num === num);
          const chip = document.createElement('span');
          chip.className = 'ck-chip';
          chip.title = c ? c.nombre : '';
          chip.append(`Clase ${num}`);
          if (!pedidoBloqueado) {
            const rm = document.createElement('button');
            rm.type = 'button';
            rm.setAttribute('aria-label', `Quitar la clase ${num}`);
            rm.textContent = '×';
            rm.addEventListener('click', () => toggleClase(num));
            chip.append(rm);
          }
          chips.append(chip);
        });
        chips.hidden = m.clases.length === 0;
        maxHelp.hidden = m.clases.length < MAX_CLASES;

        // Subtotal por marca: solo tiene sentido con varias
        subEl.hidden = !varias;
        subEl.textContent = varias ? formatARS(subtotalMarca(m)) : '';

        opts.forEach(opt => {
          opt.classList.toggle('selected', m.clases.includes(parseInt(opt.dataset.num || '', 10)));
        });
      };

      const filtrar = (q: string) => {
        const nq = normalize(q);
        opts.forEach(opt => {
          // Busca en el nombre corto Y en el encabezado oficial completo
          const text = normalize(`${opt.textContent || ''} ${opt.dataset.extra || ''}`);
          (opt.parentElement as HTMLElement).hidden = nq !== '' && !text.includes(nq);
        });
      };

      btn.addEventListener('click', () => {
        const show = panel.hidden;
        cerrarPaneles();
        panel.hidden = !show;
        btn.setAttribute('aria-expanded', String(show));
        if (show) { search.value = ''; filtrar(''); search.focus(); }
      });
      search.addEventListener('input', () => filtrar(search.value));
      // El panel queda abierto al elegir: es una selección múltiple
      opts.forEach(opt => opt.addEventListener('click', () => toggleClase(parseInt(opt.dataset.num || '', 10))));

      update();
      updaters.push(update);
      cont.append(card);
    });

    refreshCards = () => updaters.forEach(u => u());
  }

  function cerrarPaneles(excepto?: Element | null) {
    document.querySelectorAll<HTMLElement>('#ck-clases-cards .ck-dd').forEach(dd => {
      if (dd === excepto) return;
      const panel = dd.querySelector<HTMLElement>('.ck-dd-panel')!;
      if (!panel.hidden) {
        panel.hidden = true;
        dd.querySelector('.ck-dd-btn')!.setAttribute('aria-expanded', 'false');
      }
    });
  }

  document.addEventListener('click', (e) => {
    cerrarPaneles((e.target as HTMLElement).closest?.('.ck-dd'));
  });

  // ── Garantía (upsell) y resumen ─────────────────────────
  const FEAT_GARANTIA = {
    off: 'Sin garantía de devolución: si el INPI deniega el registro en una clase, los honorarios de esa clase no se devuelven',
    on: 'Garantía de Devolución incluida: si el INPI deniega el registro en una clase, te devolvemos los honorarios de esa clase',
  };

  /** Líneas del pedido: una marca en una clase. Antes de elegir clases el
   *  resumen muestra la base de 1 línea. */
  function lineas(): number {
    return contarLineas(marcas);
  }
  function pricing() {
    return computeOrderPricing(lineas() || 1, garantia);
  }
  function total(): number {
    return pricing().total;
  }
  /** Cuánto sale una marca sola, con sus clases (0 clases = $0) */
  function subtotalMarca(m: MarcaState): number {
    const unidad = PRICING.honorarios + PRICING.arancelInpi + (garantia ? PRICING.garantia : 0);
    return unidad * m.clases.length;
  }

  function renderSummaryMarcas() {
    const cont = $('ck-sum-marcas');
    cont.innerHTML = '';
    if (marcas.length < 2) { cont.hidden = true; return; }
    marcas.forEach((m, i) => {
      const row = document.createElement('div');
      row.className = 'ck-sum-row ck-sum-marca';
      const left = document.createElement('span');
      left.innerHTML =
        `<b>${(m.nombre.trim().toUpperCase() || `Marca ${i + 1}`).replace(/</g, '&lt;')}</b>` +
        ` <small>${clasesTexto(m.clases, 'sin clase')}</small>`;
      const right = document.createElement('span');
      right.textContent = formatARS(subtotalMarca(m));
      row.append(left, right);
      cont.append(row);
    });
    cont.hidden = false;
  }

