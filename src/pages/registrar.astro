  FIELD_IDS.forEach(id => input(id).addEventListener('input', () => {
    setErr(id.replace('ck-', ''), ''); // al corregir, el error desaparece
    saveDraft();
  }));

  // ── Botones Continuar / Volver ──────────────────────────
  const VALIDATORS: Record<string, () => boolean> = {
    '1': validateStep1, '2': validateContacto, '3': validatePedido, '5': validateTitular,
  };

  document.querySelectorAll<HTMLElement>('[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      const from = btn.dataset.next!;
      const validator = VALIDATORS[from];
      if (validator && !validator()) return;
      goTo(String(parseInt(from, 10) + 1));
    });
  });
  document.querySelectorAll<HTMLElement>('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => goTo(btn.dataset.back!));
  });

  // ── Bootstrap: volver de Mercado Pago (?order=REF) o draft local ─────
  const urlParams = new URLSearchParams(window.location.search);
  const urlOrderRef = urlParams.get('order');
  if (urlOrderRef) {
    resumeOrder(urlOrderRef).then(ok => { if (!ok) restoreDraft(); });
  } else {
    restoreDraft();
    // Prefill desde /verificar-marca (?marca=X&clase=N o ?clase=9,25&tel=…&email=…); pisa el draft a propósito
    const urlMarca = (urlParams.get('marca') || '').trim().slice(0, 80);
    const urlClases = (urlParams.get('clase') || '')
      .split(',')
      .map(s => parseInt(s, 10))
      .filter(n => n >= 1 && n <= 45);
    const urlTel = (urlParams.get('tel') || '').trim().slice(0, 30);
    const urlEmail = (urlParams.get('email') || '').trim().slice(0, 120);
    if (urlMarca) input('ck-marca').value = urlMarca;
    if (urlClases.length) setClases(urlClases, false);
    if (urlTel) input('ck-whatsapp').value = urlTel;
    if (urlEmail) input('ck-email').value = urlEmail;
    if (urlMarca || urlClases.length || urlTel || urlEmail) saveDraft();
  }
</script>

