---
// Guía DIY de registro de marca. NO es pública: no se linkea desde ningún lado,
// va con noindex y está excluida del sitemap (ver astro.config.mjs).
//
// Se renderiza POR REQUEST (`prerender = false`): el token nace cuando alguien
// compra, no cuando corre el build.
//
// EL TOKEN ES LA CREDENCIAL. No hay login. Esta página sólo decide si hay
// acceso; el contenido vive en <Contenido>. Si el token no existe, no está
// pagado o está revocado, no se renderiza NI UN PASO de la guía.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contenido from '@/components/guia/Contenido.astro';
import Bloqueo from '@/components/guia/Bloqueo.astro';
import { cargarGuia } from '@/lib/guia/cargar';

export const prerender = false;

const acceso = await cargarGuia(Astro.locals, Astro.params.token);

// Un token inexistente es un 404 de verdad; uno sin pagar, un 402. Que el
// status sea real importa: sin eso quedan cacheables y podrían indexarse como
// si fueran páginas válidas.
if (!acceso.ok) {
  Astro.response.status = acceso.motivo === 'inexistente' ? 404 : 402;
}
---

<BaseLayout
  title="Guía de registro de marca"
  description="Guía privada de registro de marca."
  noindex={true}
  waContext="guia_float"
>
  {acceso.ok
    ? <Contenido cliente={acceso.cliente} />
    : <Bloqueo motivo={acceso.motivo} pagoUrl={acceso.pagoUrl} />}
</BaseLayout>
